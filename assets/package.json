{
    "name": "phemjs",
    "description": "The Phem client: the phem Stimulus controller, which keeps the component state in the browser and morphs the page with Turbo Streams.",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "test": "vitest run"
    },
    "symfony": {
        "controllers": {
            "phem": {
                "name": "phem",
                "main": "dist/phem_controller.js",
                "fetch": "eager",
                "enabled": true,
                "autoimport": {
                    "@phem/phem/dist/phem.css": true
                }
            },
            "optimistic": {
                "name": "phem-optimistic",
                "main": "dist/phem_optimistic_controller.js",
                "fetch": "lazy",
                "enabled": false
            },
            "toggle": {
                "name": "phem-toggle",
                "main": "dist/phem_toggle_controller.js",
                "fetch": "lazy",
                "enabled": false
            },
            "dialog": {
                "name": "phem-dialog",
                "main": "dist/phem_dialog_controller.js",
                "fetch": "lazy",
                "enabled": false
            },
            "tabs": {
                "name": "phem-tabs",
                "main": "dist/phem_tabs_controller.js",
                "fetch": "lazy",
                "enabled": false
            },
            "clipboard": {
                "name": "phem-clipboard",
                "main": "dist/phem_clipboard_controller.js",
                "fetch": "lazy",
                "enabled": false
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0",
            "@hotwired/turbo": "^8.0.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "@hotwired/turbo": "^8.0.0"
    },
    "devDependencies": {
        "@hotwired/stimulus": "3.2.2",
        "@hotwired/turbo": "8.0.23",
        "jsdom": "30.1.3",
        "vitest": "5.0.5"
    }
}
