<?phpm

namespace App\Components;

use Closure;
use Mamu\Attribute\Component;
use Mamu\Html;

#[Component]
function MyButton(int $count, Closure $onClick) {
    return (
        <button className="btn" onClick={{ onClick }}>
            Clicked {{ count }} times
        </button>
    );
}

#[Component]
function Card(string $title, ?Html $children = null, ?Html $footer = null) {
    return (
        <section class="card">
            <h2>{{ title }}</h2>
            <div class="body">{{ children }}</div>
            <footer>{{ footer }}</footer>
        </section>
    );
}

#[Component]
function Badge(string $label, string $tone = 'info') {
    return <span class="badge badge-{{ tone }}">{{ label|upper }}</span>;
}

#[Component]
function Tag(?Html $children = null) {
    return <span class="tag">{{ children ?? 'untagged' }}</span>;
}
