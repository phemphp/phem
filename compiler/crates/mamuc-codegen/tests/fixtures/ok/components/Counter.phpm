<?phpm

namespace App\Components;

use Mamu\Attribute\{Component, State};
use Mamu\Html;
use Mamu\Tests\Fixtures\Limits;

#[Component]
final class Counter
{
    public string $label = 'Clicked';
    public ?Html $children = null;
    #[State] public int $count = 0;

    public function __construct(private readonly Limits $limits)
    {
    }

    public function increment(): void
    {
        $this->count = min($this->count + 1, $this->limits->max);
    }

    public function render()
    {
        return (
            <button onClick={{ increment }} data-count={{ count }}>
                {{ label }} {{ count }} times {{ children }}
            </button>
        );
    }
}
