<?phpm

namespace App\Components;

use Mamu\Attribute\Component;

#[Component]
function RestButton(int $count, mixed ...$rest) {
    return (
        <button type="button" {{ ...rest }} onclick="track()" className="btn btn-{{ count }}" disabled>
            Clicked {{ count }} times
        </button>
    );
}

#[Component]
function Toolbar(mixed ...$rest) {
    $count = 1;
    return <RestButton count={{ count }} {{ ...rest }} />;
}
