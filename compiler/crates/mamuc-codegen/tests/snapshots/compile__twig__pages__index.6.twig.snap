---
source: crates/mamuc-codegen/tests/compile.rs
expression: t.content
---
<main>
                <h1>Counters that update together</h1>
                {% component 'App\\Components\\MyButton' with {'count': (count), 'onClick': (handleClick)} only %}
                {% component 'App\\Components\\MyButton' with {'count': (count), 'onClick': (handleClick)} only %}
                <ul id="shopping">
                    {% for product in products %}
                        <li {{ mamu_key(product.id) }} {{ mamu_style({color: product.isFruit ? 'magenta' : 'darkgreen', fontWeight: 700}) }}>{{ product.title }}</li>
                    {% endfor %}
                </ul>
                <ol id="mapped">{{ listItems }}</ol>
                {% component embed 'App\\Components\\Card' with {'title': 'Hello'} only %}{% block children %}{% with _mamu_caller only %}
                    <p>Body {{ count }}</p>
                    
                {% endwith %}{% endblock %}{% block footer %}{% with _mamu_caller only %}{% component 'App\\Components\\Badge' with {'label': 'foot'} only %}{% endwith %}{% endblock %}{% endcomponent %}
                {% component embed 'App\\Components\\Counter' with {'label': 'Hits'} only %}{% block children %}{% with _mamu_caller only %}!{% endwith %}{% endblock %}{% endcomponent %}
                {% component 'App\\Pages\\Toggle' only %}
                <button id="add" {{ mamu_on('click', add) }}>Add</button>
                <span id="items">{{ items|join(',') }}</span>
                {% component 'App\\Pages\\Toolbar' with {'theme': 'dark'} only %}
                {% component 'App\\Pages\\Toolbar' only %}
                {% component 'App\\Pages\\Greeting' with {'name': 'ada'} only %}
                {% component 'App\\Components\\Tag' only %}
                {% component embed 'App\\Components\\Tag' only %}{% block children %}{% with _mamu_caller only %}urgent{% endwith %}{% endblock %}{% endcomponent %}
            </main>
