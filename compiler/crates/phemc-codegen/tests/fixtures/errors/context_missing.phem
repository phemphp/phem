<?phem // expect: E015
namespace App;
use Phem\Attribute\{Component, Context, Page, Prop, Provide};
use Phem\Html;
#[Component, Provide]
final class Tabs {
    #[Prop] public ?Html $children = null;
    public function render() { return <div>{{ children }}</div>; }
}
#[Component]
function Tab(string $name, #[Context] Tabs $tabs) { return <button>{{ name }}</button>; }
#[Page('/settings')]
final class Settings {
    public function render() { return <main><Tab name="general" /></main>; }
}
