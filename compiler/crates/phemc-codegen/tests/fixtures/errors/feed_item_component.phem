<?phem // expect: E066
use Phem\Attribute\{Component, State};
use Phem\Feed;
#[Component]
final class F { public Feed $messages; public function render() { return <ul phem:feed={{ messages }}>{% for m in messages %}<li><Row m={{ m }} /></li>{% endfor %}</ul>; } }
#[Component]
final class Row { #[\Phem\Attribute\Prop] public $m; public function render() { return <b>{{ m.text }}</b>; } }
