<?phem // expect: E065
use Phem\Attribute\{Component, State};
use Phem\Feed;
#[Component]
final class F { public Feed $messages; public function render() { return <div><ul phem:feed={{ messages }}>{% for m in messages %}<li>{{ m.text }}</li>{% endfor %}</ul><ul phem:feed={{ messages }}>{% for m in messages %}<li>{{ m.text }}</li>{% endfor %}</ul></div>; } }
