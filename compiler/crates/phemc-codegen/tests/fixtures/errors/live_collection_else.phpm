<?phpm // expect: E054
use Phem\Attribute\Component;
use Phem\{LiveCollection, Node};
#[Component]
final class Log
{
    public LiveCollection $lines;
    public function render(): Node { return <ul>{% for l in lines %}<li key={{ l.id }}>{{ l.text }}</li>{% else %}<li>None</li>{% endfor %}</ul>; }
}
