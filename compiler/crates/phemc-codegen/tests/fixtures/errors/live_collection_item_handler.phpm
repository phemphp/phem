<?phpm // expect: E055
use Phem\Attribute\Component;
use Phem\{LiveCollection, Node};
#[Component]
final class Log
{
    public LiveCollection $lines;
    public function render(): Node { return <ul>{% for l in lines %}<li key={{ l.id }}><button onClick={{ l.remove }}>x</button></li>{% endfor %}</ul>; }
}
