<?phem // expect: E058
use Phem\Attribute\{Component, Validated};
use Phem\Node;
trait Saves
{
    #[Validated]
    public function save(): void
    {
    }
}
#[Component]
final class TraitForm
{
    use Saves;

    public function render(): Node
    {
        return <form onSubmit={{ save }}><button>Save</button></form>;
    }
}
