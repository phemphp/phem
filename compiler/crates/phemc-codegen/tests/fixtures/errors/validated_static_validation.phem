<?phem // expect: E058
use Phem\Attribute\{Component, State, Validated};
use Phem\Node;
use Phem\Validation;
#[Component]
final class StaticForm
{
    #[State] public static Validation $validation;

    #[Validated]
    public function save(): void
    {
    }

    public function render(): Node
    {
        return <form onSubmit={{ save }}><button>Save</button></form>;
    }
}
