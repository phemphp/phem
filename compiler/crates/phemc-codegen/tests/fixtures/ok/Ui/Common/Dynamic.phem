<?phem

namespace App\Ui\Common;

use Phem\Attribute\Component;
use Phem\{Dynamic, Html, Node};

// A button that renders as a link: the tag is a prop.
#[Component]
function DynamicButton(string $tag = 'button', ?Html $children = null, mixed ...$rest): Node {
    return (
        <Dynamic tag={{ tag }} className={{ classes('px-4 py-2') }} {{ ...rest }}>
            {{ children }}
        </Dynamic>
    );
}

// No children: a void element is valid.
#[Component]
function DynamicMedia(string $tag, string $src): Node {
    return <Dynamic tag={{ tag }} src={{ src }} />;
}

// A literal tag, and a tag from a quoted value.
#[Component]
function DynamicHeading(int $level = 2, ?Html $children = null): Node {
    return (
        <section>
            <Dynamic tag="h{{ level }}" id="title">{{ children }}</Dynamic>
            <Dynamic tag="p">Text</Dynamic>
        </section>
    );
}

// Nested elements: each one captures its children in its own variable.
#[Component]
function DynamicNested(string $outer, string $inner, ?Html $children = null): Node {
    return <Dynamic tag={{ outer }}><Dynamic tag={{ inner }}>{{ children }}</Dynamic></Dynamic>;
}
