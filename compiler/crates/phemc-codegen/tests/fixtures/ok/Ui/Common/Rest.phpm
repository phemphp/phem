<?phpm

namespace App\Ui\Common;

use Phem\Attribute\{Component, Prop};
use Phem\Node;

#[Component]
function RestButton(int $count, mixed ...$rest): Node {
    return (
        <button type="button" {{ ...rest }} onclick="track()" className="btn btn-{{ count }}" disabled>
            Clicked {{ count }} times
        </button>
    );
}

#[Component]
function Toolbar(mixed ...$rest): Node {
    $count = 1;
    return <RestButton count={{ count }} {{ ...rest }} />;
}

#[Component]
final class RestLink
{
    #[Prop] public string $label = '';
    #[Prop(rest: true)] public array $attrs = [];

    public function render(): Node
    {
        return <a className="link" {{ ...attrs }}>{{ label }}</a>;
    }
}

#[Component]
function Nav(): Node {
    return <RestLink label="Home" href="/" aria-current="page" />;
}
