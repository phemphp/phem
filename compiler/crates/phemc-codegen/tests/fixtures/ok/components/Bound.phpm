<?phpm

namespace App\Components;

use Phem\Attribute\{Component, Prop, State};
use Phem\Bound;
use Phem\Node;

/** A template component: its field binds the property of the parent. */
#[Component]
function TextField(Bound $value, string $label): Node
{
    return <label>{{ label }} <input phem:bind={{ value }} phem:live /></label>;
}

/** A function component: it passes its Bound prop to a child. */
#[Component]
function NameField(Bound $value): Node
{
    $label = 'Name';

    return <TextField phem:bind={{ value }} label={{ label }} />;
}

/** A class component with a Bound prop. */
#[Component]
final class ColorPicker
{
    #[Prop] public Bound $value;

    public function render(): Node
    {
        return (
            <select phem:bind={{ value }}>
                <option value="red">Red</option>
                <option value="blue">Blue</option>
            </select>
        );
    }
}

#[Component]
final class Profile
{
    #[State] public string $name = '';
    #[State] public string $bio = '';
    #[State] public array $prefs = ['color' => 'red'];

    public function render(): Node
    {
        return (
            <form>
                <NameField phem:bind={{ name }} />
                <TextField phem:bind={{ bio }} label="Bio" />
                <ColorPicker phem:bind={{ prefs.color }} />
            </form>
        );
    }
}
