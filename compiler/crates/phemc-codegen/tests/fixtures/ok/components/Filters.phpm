<?phpm

namespace App\Components;

use Phem\Attribute\{Component, State};

#[Component]
final class Filters
{
    #[State] public string $query = '';
    #[State] public ?int $year = null;
    #[State] public bool $active = false;
    #[State] public array $tags = [];
    #[State] public string $sort = 'name';
    #[State] public array $fields = [];
    #[State] public string $notes = '';

    public function search(): void
    {
    }

    public function render()
    {
        $options = ['name' => 'Name', 'year' => 'Year'];

        return (
            <form onSubmit={{ search }}>
                <input type="search" phem:bind={{ query }} phem:live phem:debounce={{ 300 }} />
                <input type="number" phem:bind={{ year }} />
                <input type="checkbox" phem:bind={{ active }} />
                <input type="checkbox" value="php" phem:bind={{ tags }} />
                <input type="radio" value="name" phem:bind={{ sort }} />
                <select phem:bind={{ sort }}>
                    {% for value, label in options %}
                        <option value={{ value }} key={{ value }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <select multiple phem:bind={{ fields }}>
                    <option>Name</option>
                    <option value="year">Year</option>
                </select>
                <textarea phem:bind={{ notes }}></textarea>
            </form>
        );
    }
}
