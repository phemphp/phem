<?phpm

namespace App\Pages;

use Phem\Attribute\{Component, Context, Page, Provide, State, Subscribe};
use Phem\{Event, Feed, Node};
use function App\Components\Document;

#[Page('/chat'), Subscribe, Provide]
final class Chat
{
    public Feed $messages;

    public function post(string $text): void
    {
        $this->messages->append(new Message($text));
    }

    public function render(): Node
    {
        return (
            <Document>
                <ul class="messages">
                    {# the pushes add the new messages #}
                    {% for m in messages %}
                        <li key={{ m.id }} class="message">{{ m.text|upper }}</li>
                    {% endfor %}
                </ul>
                <p>{{ messages|length }} messages</p>
                <ChatForm />
            </Document>
        );
    }
}

final readonly class Message
{
    public string $id;

    public function __construct(public string $text)
    {
        $this->id = bin2hex(random_bytes(8));
    }
}

#[Component]
final class ChatForm
{
    #[State] public string $text = '';
    #[Context] public Chat $chat;

    public function send(Event $e): void
    {
        $this->chat->post($this->text);
        $this->text = '';
    }

    public function render(): Node
    {
        return (
            <form onSubmit={{ send }}>
                <input name="text" phem:bind={{ text }} />
            </form>
        );
    }
}
