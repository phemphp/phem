#[Component]
function Toolbar(string $theme = 'light'): Node {
    return new \Phem\Element('page/index.0.twig', ['theme' => $theme ?? null]);
}

// A plain PHP function, with no `#[Component]`: it is not a component.
function Shout(string $name): string {
    return strtoupper($name);
}

#[Component]
function Greeting(string $name): Node {
    $upper = Shout($name);
    return new \Phem\Element('page/index.1.twig', ['upper' => $upper ?? null]);
}

#[Component]
final class Toggle
{
    #[State] public bool $on = false;

    public function toggle(): void
    {
        $this->on = !$this->on;
    }

    public function render(): Node
    {
        if ($this->on) {
            $content = new \Phem\Element('page/index.2.twig', []);
        } else {
            $content = new \Phem\Element('page/index.3.twig', []);
        }

        return (
            new \Phem\Element('page/index.4.twig', ['toggle' => $this->toggle(...), 'content' => $content ?? null, 'on' => $this->on])





        );
    }
}

#[Page('/', name: 'home', methods: ['GET', 'HEAD'])]
final class Home
{
    #[State] public int $count = 0;
    #[State] public array $items = [];

    public function mount(): void
    {
        $this->items = ['item1'];
    }

    public function handleClick(): void
    {
        ++$this->count;
    }

    public function add(): void
    {
        $this->items[] = 'item'.(count($this->items) + 1);
    }

    public function render(): Node
    {
        $products = [
            ['title' => 'Cabbage', 'isFruit' => false, 'id' => 1],
            ['title' => 'Apple', 'isFruit' => true, 'id' => 3],
        ];
        $listItems = array_map(fn($p) => new \Phem\Element('page/index.5.twig', ['p' => $p ?? null]), $products);

        return (
            new \Phem\Element('page/index.6.twig', ['count' => $this->count, 'handleClick' => $this->handleClick(...), 'products' => $products ?? null, 'listItems' => $listItems ?? null, 'add' => $this->add(...), 'items' => $this->items])


























        );
    }
}
