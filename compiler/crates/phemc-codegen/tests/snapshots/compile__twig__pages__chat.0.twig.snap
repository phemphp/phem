{% component embed 'App\\Components\\Document' only %}{% block children %}{% with _phem_caller only %}
                <ul class="messages" {{ phem_feed('phem-f-aozv1063td', messages) }}>
                    
                    {% for m in messages %}
                        <li {{ phem_feed_item('phem-f-aozv1063td', m.id) }} class="message">{{ m.text|upper }}</li>
                    {% endfor %}
                </ul>
                <p>{{ messages|length }} messages</p>
                {% component 'App\\Pages\\ChatForm' only %}
            {% endwith %}{% endblock %}{% endcomponent %}
