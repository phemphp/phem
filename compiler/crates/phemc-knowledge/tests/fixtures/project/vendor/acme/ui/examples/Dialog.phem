<?phem

namespace Acme\Ui\Examples;

use Acme\Ui\Dialog;
use Phem\Attribute\Component;
use Phem\Node;

use function Acme\Ui\{Button, DialogPopup, DialogTitle, DialogTrigger};

// The fields of the form.
const PROFILE_FIELDS = ['name', 'email'];

// The values of the form: a class of the example file, not a component.
final class Profile
{
    public ?string $name = null;
}

/**
 * Dialog with a form.
 *
 * Use it to edit a record without a page change.
 */
#[Component]
function DialogFormDemo(): Node
{
    $fields = PROFILE_FIELDS;
    $profile = new Profile();

    return (
        <Dialog title="Edit">
            <DialogTrigger>Edit profile</DialogTrigger>
            <DialogPopup>
                <DialogTitle>Edit profile</DialogTitle>
                <form>
                    {% for field in fields %}<input key={{ field }} name={{ field }} />{% endfor %}
                    <Button type="submit"><SaveIcon /> Save</Button>
                </form>
            </DialogPopup>
        </Dialog>
    );
}

/** A dialog in a dialog. */
#[Component]
function DialogNestedDemo(): Node
{
    return <Dialog title="Outer"><DialogPopup><Dialog title="Inner" /><CloseIcon /></DialogPopup></Dialog>;
}

/** The icon of the save button: a helper of DialogFormDemo, not an example. */
#[Component]
function SaveIcon(): Node
{
    return <svg aria-hidden="true" />;
}
