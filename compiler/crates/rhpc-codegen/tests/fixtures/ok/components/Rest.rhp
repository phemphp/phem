<?php

namespace App\Components;

function RestButton(int $count, mixed ...$rest) {
    return (
        <button type="button" {{ ...rest }} className="btn btn-{{ count }}" disabled>
            Clicked {{ count }} times
        </button>
    );
}

function Toolbar(mixed ...$rest) {
    $count = 1;
    return <RestButton count={{ count }} {{ ...rest }} />;
}
