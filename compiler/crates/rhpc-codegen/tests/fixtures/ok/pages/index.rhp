<?php

namespace App\Pages;

use App\Components\Counter;
use Rephp\Attribute\{Component, Page, State};
use function App\Components\{MyButton, Card, Badge};

function Toolbar(string $theme = 'light') {
    return <p className="theme-{{ theme }}">Theme: {{ theme }}</p>;
}

function Greeting(string $name) {
    $upper = strtoupper($name);
    return <p className="greeting">Hello, {{ upper }}!</p>;
}

#[Component]
final class Toggle
{
    #[State] public bool $on = false;

    public function toggle(): void
    {
        $this->on = !$this->on;
    }

    public function render()
    {
        if ($this->on) {
            $content = <Badge label="on" tone="ok" />;
        } else {
            $content = <Badge label="off" />;
        }

        return (
            <div class="toggle">
                <button id="toggle" onClick={{ toggle }}>Toggle</button>
                {{ content }}
                {{ on ? <strong id="yes">Yes</strong> : <em id="no">No</em> }}
                {{ on and <span id="and">and-shown</span> }}
            </div>
        );
    }
}

#[Component]
#[Page]
final class Home
{
    #[State] public int $count = 0;
    #[State] public array $items = [];

    public function mount(): void
    {
        $this->items = ['item1'];
    }

    public function handleClick(): void
    {
        ++$this->count;
    }

    public function add(): void
    {
        $this->items[] = 'item'.(count($this->items) + 1);
    }

    public function render()
    {
        $products = [
            ['title' => 'Cabbage', 'isFruit' => false, 'id' => 1],
            ['title' => 'Apple', 'isFruit' => true, 'id' => 3],
        ];
        $listItems = array_map(fn($p) => <li key={{ p.id }}>{{ p.title }}</li>, $products);

        return (
            <main>
                <title>Fixture Home</title>
                <h1>Counters that update together</h1>
                <MyButton count={{ count }} onClick={{ handleClick }} />
                <MyButton count={{ count }} onClick={{ handleClick }} />
                <ul id="shopping">
                    {% for product in products %}
                        <li key={{ product.id }} style={{ {color: product.isFruit ? 'magenta' : 'darkgreen', fontWeight: 700} }}>{{ product.title }}</li>
                    {% endfor %}
                </ul>
                <ol id="mapped">{{ listItems }}</ol>
                <Card title="Hello">
                    <p>Body {{ count }}</p>
                    <Card:footer><Badge label="foot" /></Card:footer>
                </Card>
                <Counter label="Hits">!</Counter>
                <Toggle />
                <button id="add" onClick={{ add }}>Add</button>
                <span id="items">{{ items|join(',') }}</span>
                <Toolbar theme="dark" />
                <Toolbar />
                <Greeting name="ada" />
            </main>
        );
    }
}
