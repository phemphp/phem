{
    "name": "phem/e2e",
    "description": "The end-to-end tests of Phem: a Symfony app, tested in a real browser with Playwright PHP",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "..", "options": { "versions": { "phem/phem": "dev-main" } } }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "phem/phem": "dev-main",
        "symfony/asset-mapper": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "playwright-php/playwright": "1.6.0",
        "playwright-php/playwright-symfony": "0.12.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": { "sort-packages": true }
}
