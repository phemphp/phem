<?phem

namespace App\Ui\Combobox;

use Phem\Attribute\{Page, State};
use Phem\Event;
use Phem\Node;

use function App\Ui\Layout\Document;

// A city field: the server gives the cities that start with the text. A fruit field: the server
// renders the fruits one time, and the browser filters them. A color field: as the fruit field,
// with no id on the list and the items. A reviewer field: the server searches the people in the
// handler of the input, and the browser selects one of them. An emoji picker: a grid that the
// browser filters, and a choice goes into the message. A command palette in a dialog: an inline
// list that starts again when the dialog closes, after its close animation.
#[Page('/combobox')]
final class ComboboxPage
{
    private const array CITIES = ['Lyon', 'Paris', 'Parma', 'Porto'];
    private const array FRUITS = ['Apple', 'Banana', 'Cherry', 'Éclair', 'Lemon'];
    private const array COLORS = ['Blue', 'Green', 'Red'];
    /** The emojis of each group, in rows of three. */
    private const array EMOJIS = [
        'smileys' => [
            ['😀' => 'grinning face', '😂' => 'face with tears of joy', '😍' => 'smiling face with heart eyes'],
            ['😎' => 'smiling face with sunglasses', '😴' => 'sleeping face', '🤔' => 'thinking face'],
        ],
        'animals' => [['🐱' => 'cat face', '🐶' => 'dog face']],
    ];
    private const array PEOPLE = ['leslie' => 'Leslie Alexander', 'lindsay' => 'Lindsay Walton', 'tom' => 'Tom Cook'];

    #[State] public string $query = '';
    #[State] public string $city = '';
    #[State] public string $reviewer = '';
    /** @var list<array{id: string, name: string}> */
    #[State] public array $people = [];

    public function choose(string $city): void
    {
        $this->city = $city;
        $this->query = $city;
    }

    public function searchPeople(Event $e): void
    {
        $text = strtolower(trim((string) $e->value));

        $this->people = [];
        if ('' === $text) {
            return;
        }

        foreach (self::PEOPLE as $id => $name) {
            if (str_contains(strtolower($name), $text)) {
                $this->people[] = ['id' => $id, 'name' => $name];
            }
        }
    }

    public function render(): Node
    {
        $text = strtolower(trim($this->query));
        $results = '' === $text || $text === strtolower($this->city) ? [] : array_values(array_filter(
            self::CITIES,
            static fn (string $name): bool => str_starts_with(strtolower($name), $text),
        ));
        $fruits = self::FRUITS;
        $colors = self::COLORS;
        $emojis = self::EMOJIS;

        return (
            <Document title="Combobox">
                <div id="combobox" data-controller="phem-combobox">
                    <input id="input" data-phem-combobox-target="input" phem:bind={{ query }} phem:live aria-label="City" />
                    <div id="popup" data-phem-combobox-target="popup" hidden>
                        <ul id="list" data-phem-combobox-target="list">
                            {% for name in results %}
                                <li key={{ name }} id={{ 'city-' ~ name }} data-phem-combobox-target="item" onClick={{ choose(name) }}>{{ name }}</li>
                            {% endfor %}
                        </ul>
                        <p id="empty" data-phem-combobox-target="empty">No city.</p>
                    </div>
                </div>
                <output id="city">{{ city }}</output>

                <div id="fruits" data-controller="phem-combobox" data-phem-combobox-filter-value="contains" data-phem-combobox-mode-value="both">
                    <input id="fruit-input" data-phem-combobox-target="input" aria-label="Fruit" />
                    <div id="fruit-popup" data-phem-combobox-target="popup" hidden>
                        <ul id="fruit-list" data-phem-combobox-target="list">
                            {% for name in fruits %}
                                <li key={{ name }} id={{ 'fruit-' ~ loop.index }} data-phem-combobox-target="item">{{ name }}</li>
                            {% endfor %}
                        </ul>
                        <p id="fruit-empty" data-phem-combobox-target="empty">No fruit.</p>
                    </div>
                </div>

                <div id="picker" data-controller="phem-combobox" data-phem-combobox-filter-value="contains" data-phem-combobox-selection-mode-value="single" data-phem-combobox-open-on-input-click-value="true">
                    <input id="picker-input" data-phem-combobox-target="input" aria-label="Picker" />
                    <button type="button" id="picker-clear" data-phem-combobox-target="clear">Clear</button>
                    <input type="hidden" id="picker-value" name="picker" data-phem-combobox-target="value" />
                    <div id="picker-popup" data-phem-combobox-target="popup" hidden>
                        <ul data-phem-combobox-target="list">
                            {% for name in fruits %}
                                <li key={{ name }} id={{ 'pick-' ~ loop.index }} data-value={{ name|lower }} data-phem-combobox-target="item">{{ name }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <div id="colors" data-controller="phem-combobox" data-phem-combobox-filter-value="contains">
                    <input id="color-input" data-phem-combobox-target="input" aria-label="Color" />
                    <div id="color-popup" data-phem-combobox-target="popup" hidden>
                        <ul class="color-list" data-phem-combobox-target="list">
                            {% for name in colors %}
                                <li key={{ name }} data-phem-combobox-target="item">{{ name }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <input id="message" aria-label="Message" />
                <div id="emoji" data-controller="phem-combobox" data-phem-combobox-grid-value="true" data-phem-combobox-filter-value="contains" data-phem-combobox-insert-into-value="message">
                    <button type="button" id="emoji-trigger" data-phem-combobox-target="trigger" aria-label="Choose emoji">😀</button>
                    <div id="emoji-popup" data-phem-combobox-target="popup" hidden>
                        <input id="emoji-input" data-phem-combobox-target="input" aria-label="Search emojis" />
                        <div id="emoji-list" data-phem-combobox-target="list">
                            {% for group, rows in emojis %}
                                <div key={{ group }} id={{ 'emoji-' ~ group }} data-phem-combobox-target="group">
                                    {% for row in rows %}
                                        <div key={{ loop.index }} id={{ 'emoji-' ~ group ~ '-' ~ loop.index }} data-phem-combobox-target="row">
                                            {% for emoji, name in row %}
                                                <span key={{ emoji }} data-value={{ emoji }} data-label={{ name }} aria-label={{ name }} data-phem-combobox-target="item">{{ emoji }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div id="reviewer" data-controller="phem-combobox" data-phem-combobox-selection-mode-value="single">
                    <input id="reviewer-input" data-phem-combobox-target="input" onChange={{ searchPeople }} aria-label="Reviewer" />
                    <button type="button" id="reviewer-clear" data-phem-combobox-target="clear">Clear</button>
                    <input type="hidden" id="reviewer-value" data-phem-combobox-target="value" phem:bind={{ reviewer }} />
                    <div id="reviewer-popup" data-phem-combobox-target="popup" hidden>
                        <ul id="reviewer-list" data-phem-combobox-target="list">
                            {% for person in people %}
                                <li key={{ person.id }} id={{ 'person-' ~ person.id }} data-value={{ person.id }} data-selected={{ person.id == reviewer ? '' : null }} data-phem-combobox-target="item">{{ person.name }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <div id="commands" data-controller="phem-dialog">
                    <style>{{ '#commands-dialog { transition: opacity 600ms } #commands-dialog[data-ending-style] { opacity: 0 }' }}</style>
                    <button type="button" id="commands-open" data-phem-dialog-target="trigger">Commands</button>
                    <dialog id="commands-dialog" data-phem-dialog-target="popup">
                        <div id="palette" data-controller="phem-combobox" data-phem-combobox-filter-value="contains" data-phem-combobox-auto-highlight-value="always">
                            <input id="palette-input" data-phem-combobox-target="input" aria-label="Search commands" />
                            <div id="palette-list" data-phem-combobox-target="list">
                                {% for name in fruits %}
                                    <div key={{ name }} data-phem-combobox-target="item">{{ name }}</div>
                                {% endfor %}
                            </div>
                        </div>
                        <button type="button" id="commands-close" data-phem-dialog-target="close">Close</button>
                    </dialog>
                </div>
            </Document>
        );
    }
}
