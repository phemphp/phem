<?phem

namespace App\Ui\Dialog;

use Phem\Attribute\{Page, State};
use Phem\Node;

use function App\Ui\Layout\Document;

// An alert dialog (no dismiss on a press outside), a dialog that is not a modal, a dialog with a
// viewport and a backdrop, a modal dialog that ends with a radio group and an element with `tabindex="-1"`, and a drawer with snap points.
#[Page('/dialog')]
final class DialogPage
{
    #[State] public int $saves = 0;

    public function save(): void
    {
        ++$this->saves;
    }

    public function render(): Node
    {
        return (
            <Document title="Dialog">
                <style>{{ '#sheet { margin: auto 0 0; width: 100%; max-width: none; height: 400px; padding: 0; border: 0; transform: translateY(calc(var(--drawer-snap-point-offset, 0px) + var(--drawer-swipe-movement-y, 0px))); } #viewport { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; } #viewport-popup { width: 200px; margin: 100px auto; background: white; }' }}</style>
                <output id="saves">{{ saves }}</output>

                <div id="alert" data-controller="phem-dialog" data-phem-dialog-disable-pointer-dismissal-value="true">
                    <button id="alert-open" data-phem-dialog-target="trigger">Delete</button>
                    <dialog id="alert-dialog" data-phem-dialog-target="popup" role="alertdialog">
                        <h2 data-phem-dialog-target="title">Delete the file?</h2>
                        <button data-phem-dialog-target="close">Cancel</button>
                    </dialog>
                </div>

                <div id="plain" data-controller="phem-dialog" data-phem-dialog-modal-value="false">
                    <button id="plain-open" data-phem-dialog-target="trigger">Notes</button>
                    <dialog id="plain-dialog" data-phem-dialog-target="popup" style="position: fixed; top: 300px; margin: 0">
                        <p>Notes</p>
                    </dialog>
                </div>
                <button id="page-button" onClick={{ save }}>Page</button>

                <div id="framed" data-controller="phem-dialog">
                    <button id="framed-open" data-phem-dialog-target="trigger">Framed</button>
                    <div id="backdrop" data-phem-dialog-target="backdrop" hidden></div>
                    <dialog id="viewport" data-phem-dialog-target="viewport">
                        <div id="viewport-popup" data-phem-dialog-target="popup">
                            <h2 data-phem-dialog-target="title">Framed</h2>
                            <button id="framed-save" onClick={{ save }}>Save</button>
                        </div>
                    </dialog>
                </div>

                <div id="edit" data-controller="phem-dialog">
                    <button id="edit-open" data-phem-dialog-target="trigger">Edit</button>
                    <dialog id="edit-dialog" data-phem-dialog-target="popup">
                        <h2 data-phem-dialog-target="title">Edit</h2>
                        <button id="edit-first">First</button>
                        <button id="edit-last" data-phem-dialog-target="close">Last</button>
                        <label><input type="radio" name="size" id="edit-small" checked /> Small</label>
                        <label><input type="radio" name="size" id="edit-large" /> Large</label>
                        <div id="edit-item" tabindex="-1">Item</div>
                    </dialog>
                </div>

                <div id="drawer" data-controller="phem-dialog" data-phem-dialog-swipe-direction-value="down" data-phem-dialog-snap-points-value={{ ['100px', 1] }}>
                    <button id="drawer-open" data-phem-dialog-target="trigger">Sheet</button>
                    <dialog id="sheet" data-phem-dialog-target="popup">
                        <h2 id="sheet-title" data-phem-dialog-target="title">Sheet</h2>
                        <button id="sheet-close" data-phem-dialog-target="close">Close</button>
                    </dialog>
                </div>
            </Document>
        );
    }
}
