<?phem

namespace App\Ui\Menu;

use Phem\Attribute\{Page, State};
use Phem\Node;

use function App\Ui\Layout\Document;

// A menu of actions: each item runs a handler. "Move to" is a submenu, and the area has a
// context menu.
#[Page('/menu')]
final class MenuPage
{
    #[State] public array $log = [];

    public function rename(): void
    {
        $this->log[] = 'rename';
    }

    public function delete(): void
    {
        $this->log[] = 'delete';
    }

    public function move(): void
    {
        $this->log[] = 'move';
    }

    public function copy(): void
    {
        $this->log[] = 'copy';
    }

    public function render(): Node
    {
        return (
            <Document title="Menu">
                <div id="menu" data-controller="phem-menu">
                    <button id="trigger" data-phem-menu-target="trigger">Actions</button>
                    <div id="popup" data-phem-menu-target="popup" hidden>
                        <button id="rename" data-phem-menu-target="item" onClick={{ rename }}>Rename</button>
                        <button id="copy" data-phem-menu-target="item" disabled>Copy</button>
                        <div data-controller="phem-menu">
                            <button id="move" data-phem-menu-target="trigger">Move to</button>
                            <div id="move-popup" data-phem-menu-target="popup" hidden>
                                <button id="inbox" data-phem-menu-target="item" onClick={{ move }}>Inbox</button>
                                <button id="archive" data-phem-menu-target="item" onClick={{ move }}>Archive</button>
                            </div>
                        </div>
                        <button id="delete" data-phem-menu-target="item" onClick={{ delete }}>Delete</button>
                    </div>
                </div>
                <div id="context" data-controller="phem-context-menu">
                    <div id="area" data-phem-context-menu-target="trigger" style="width: 200px; height: 100px;">Right click here</div>
                    <div id="context-popup" data-phem-context-menu-target="popup" hidden>
                        <button id="context-copy" data-phem-context-menu-target="item" onClick={{ copy }}>Copy</button>
                    </div>
                </div>
                <output id="log">{{ log|join(', ') }}</output>
            </Document>
        );
    }
}
