<?phem

namespace App\Ui\NavigationMenu;

use Phem\Attribute\{Page, State};
use Phem\Node;

use function App\Ui\Layout\Document;

// A navigation menu: "Overview" and "Guides" show their content in the shared popup, "Blog" is a
// link of the list, and a button in a content sends an event.
#[Page('/navigation-menu')]
final class NavigationMenuPage
{
    #[State] public int $saves = 0;

    public function save(): void
    {
        ++$this->saves;
    }

    public function render(): Node
    {
        return (
            <Document title="Navigation menu">
                <style>{{ '
                    #list { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0 }
                    #popup { width: var(--popup-width); height: var(--popup-height); border: 1px solid; background: white; box-sizing: border-box; transition: width 200ms, height 200ms }
                    #positioner { width: var(--positioner-width); height: var(--positioner-height); transition: left 200ms, top 200ms }
                    #positioner[data-instant] { transition: none }
                    #arrow { position: absolute; top: -5px; width: 10px; height: 5px; background: black; transition: left 200ms }
                    #viewport { position: relative; overflow: hidden; width: 100%; height: 100% }
                    .content { box-sizing: border-box; padding: 8px }
                    #overview-content { width: 300px; height: 120px }
                    #guides-content { width: 200px; height: 80px }
                ' }}</style>
                <nav id="nav" data-controller="phem-navigation-menu" data-phem-navigation-menu-side-offset-value="8">
                    <ul id="list" data-phem-navigation-menu-target="list">
                        <li id="overview" data-phem-navigation-menu-target="item" data-value="overview">
                            <button id="overview-trigger" data-phem-navigation-menu-target="trigger">Overview <span id="icon" data-phem-navigation-menu-target="icon">v</span></button>
                            <div id="overview-content" class="content" data-phem-navigation-menu-target="content" hidden>
                                <a id="start" data-phem-navigation-menu-target="link" href="#start">Quick start</a>
                                <button id="save" onClick={{ save }}>Save</button>
                            </div>
                        </li>
                        <li id="guides" data-phem-navigation-menu-target="item" data-value="guides">
                            <button id="guides-trigger" data-phem-navigation-menu-target="trigger">Guides</button>
                            <div id="guides-content" class="content" data-phem-navigation-menu-target="content" hidden>
                                <a id="styling" data-phem-navigation-menu-target="link" href="#styling">Styling</a>
                            </div>
                        </li>
                        <li data-phem-navigation-menu-target="item">
                            <a id="blog" data-phem-navigation-menu-target="link" href="#blog" aria-current="page">Blog</a>
                        </li>
                    </ul>
                    <div id="positioner" data-phem-navigation-menu-target="positioner" hidden>
                        <div id="popup" data-phem-navigation-menu-target="popup">
                            <div id="arrow" data-phem-navigation-menu-target="arrow"></div>
                            <div id="viewport" data-phem-navigation-menu-target="viewport"></div>
                        </div>
                    </div>
                </nav>
                <output id="saves" style="display: block; margin-top: 300px">{{ saves }}</output>
            </Document>
        );
    }
}
