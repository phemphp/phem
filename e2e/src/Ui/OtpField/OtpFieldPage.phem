<?phem

namespace App\Ui\OtpField;

use Phem\Attribute\{Page, State};
use Phem\Event;
use Phem\Node;

use function App\Ui\Layout\Document;

// A code of six digits in a form that submits when it is complete, and a button that sends an
// event.
#[Page('/otp-field')]
final class OtpFieldPage
{
    #[State] public string $code = '';
    #[State] public int $count = 0;

    public function verify(Event $e): void
    {
        $this->code = (string) ($e->form['code'] ?? '');
    }

    public function bump(): void
    {
        ++$this->count;
    }

    public function render(): Node
    {
        return (
            <Document title="OTP field">
                <form id="form" onSubmit={{ verify }}>
                    <label id="otp-label" for="otp-1">Verification code</label>
                    <div id="otp" data-controller="phem-otp-field" data-phem-otp-field-auto-submit-value="true">
                        {% for i in 1..3 %}<input key={{ i }} id={{ 'otp-' ~ i }} data-phem-otp-field-target="input" />{% endfor %}
                        <span id="dash" data-phem-otp-field-target="separator">-</span>
                        {% for i in 4..6 %}<input key={{ i }} id={{ 'otp-' ~ i }} data-phem-otp-field-target="input" />{% endfor %}
                        <input id="code" type="hidden" name="code" data-phem-otp-field-target="hiddenInput" />
                    </div>
                </form>
                <button id="count" onClick={{ bump }}>Count</button>
                <output id="verified">{{ code }}</output>
                <output id="counts">{{ count }}</output>
            </Document>
        );
    }
}
