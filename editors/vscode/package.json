{
    "name": "phem",
    "displayName": "Phem",
    "description": "Syntax highlighting, and the Phem language server for .phem files: diagnostics as you type, completion, go to definition, find references with usage counts, hover, and outline.",
    "version": "0.6.0",
    "publisher": "yceruto",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/phemphp/phem.git",
        "directory": "editors/vscode"
    },
    "homepage": "https://github.com/phemphp/phem/tree/main/editors/vscode#readme",
    "bugs": {
        "url": "https://github.com/phemphp/phem/issues"
    },
    "icon": "icons/icon.png",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "phem",
        "php",
        "twig",
        "jsx"
    ],
    "main": "./dist/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In an untrusted workspace, the extension does not use the phem.phemc.path setting of the workspace: it runs the bundled server.",
            "restrictedConfigurations": [
                "phem.phemc.path"
            ]
        }
    },
    "activationEvents": [
        "onLanguage:phem"
    ],
    "contributes": {
        "languages": [
            {
                "id": "phem",
                "aliases": [
                    "Phem",
                    "phem"
                ],
                "extensions": [
                    ".phem"
                ],
                "firstLine": "^<\\?phem\\b",
                "icon": {
                    "light": "./icons/phem.svg",
                    "dark": "./icons/phem.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "phem-markup",
                "aliases": [],
                "configuration": "./markup-language-configuration.json"
            }
        ],
        "commands": [
            {
                "command": "phem.restartServer",
                "title": "Restart Language Server",
                "category": "Phem"
            }
        ],
        "configuration": {
            "title": "Phem",
            "properties": {
                "phem.phemc.path": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "markdownDescription": "The path of a `phemc` binary. When it is set, the extension runs `phemc lsp` as the language server. Empty: the extension runs its bundled server (WebAssembly, with the Node of VS Code)."
                },
                "phem.phemc.sourceDir": {
                    "type": "string",
                    "default": "src",
                    "scope": "resource",
                    "markdownDescription": "The source directory of the `.phem` files, relative to the project root (the directory with `composer.json`). The server checks the files of this directory as you type."
                }
            }
        },
        "grammars": [
            {
                "language": "phem",
                "scopeName": "source.phem",
                "path": "./syntaxes/phem.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.markup.phem": "phem-markup",
                    "source.js.embedded.phem": "javascript",
                    "source.css.embedded.phem": "css"
                }
            }
        ]
    },
    "dependencies": {
        "vscode-languageclient": "9.0.1"
    },
    "scripts": {
        "vscode:prepublish": "esbuild src/extension.js --bundle --outfile=dist/extension.js --platform=node --format=cjs --external:vscode --minify"
    },
    "devDependencies": {
        "esbuild": "0.25.10"
    }
}
