{
    "name": "phem",
    "displayName": "Phem",
    "description": "Syntax highlighting, completion, go to definition, hover, outline, and phemc diagnostics for .phpm files: PHP with markup literals and Twig.",
    "version": "0.4.0",
    "publisher": "phem",
    "license": "MIT",
    "icon": "icons/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "phpm",
        "phem",
        "php",
        "twig",
        "jsx"
    ],
    "main": "./src/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In an untrusted workspace, the extension does not use the phem.phemc.path setting of the workspace.",
            "restrictedConfigurations": [
                "phem.phemc.path"
            ]
        }
    },
    "activationEvents": [
        "onLanguage:phpm"
    ],
    "contributes": {
        "languages": [
            {
                "id": "phpm",
                "aliases": [
                    "PHPM",
                    "phpm"
                ],
                "extensions": [
                    ".phpm"
                ],
                "firstLine": "^<\\?phpm\\b",
                "icon": {
                    "light": "./icons/phpm.svg",
                    "dark": "./icons/phpm.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "phpm-markup",
                "aliases": [],
                "configuration": "./markup-language-configuration.json"
            }
        ],
        "configuration": {
            "title": "Phem",
            "properties": {
                "phem.phemc.path": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "markdownDescription": "The path of the `phemc` binary. When it is set, the extension runs `phemc check <sourceDir> --format json` on save and shows the diagnostics. Empty: no diagnostics."
                },
                "phem.phemc.sourceDir": {
                    "type": "string",
                    "default": "src",
                    "scope": "resource",
                    "markdownDescription": "The source directory of the `.phpm` files, relative to the project root (the directory with `composer.json`)."
                }
            }
        },
        "grammars": [
            {
                "language": "phpm",
                "scopeName": "source.phpm",
                "path": "./syntaxes/phpm.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.markup.phpm": "phpm-markup",
                    "source.js.embedded.phpm": "javascript",
                    "source.css.embedded.phpm": "css"
                }
            }
        ]
    }
}
