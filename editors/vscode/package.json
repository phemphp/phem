{
    "name": "phem",
    "displayName": "Phem",
    "description": "Syntax highlighting, and the Phem language server for .phpm files: diagnostics as you type, completion, go to definition, hover, and outline.",
    "version": "0.5.0",
    "publisher": "phem",
    "license": "MIT",
    "icon": "icons/icon.png",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "phpm",
        "phem",
        "php",
        "twig",
        "jsx"
    ],
    "main": "./dist/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In an untrusted workspace, the extension does not use the phem.phemc.path setting of the workspace: it runs the bundled server.",
            "restrictedConfigurations": [
                "phem.phemc.path"
            ]
        }
    },
    "activationEvents": [
        "onLanguage:phpm"
    ],
    "contributes": {
        "languages": [
            {
                "id": "phpm",
                "aliases": [
                    "PHPM",
                    "phpm"
                ],
                "extensions": [
                    ".phpm"
                ],
                "firstLine": "^<\\?phpm\\b",
                "icon": {
                    "light": "./icons/phpm.svg",
                    "dark": "./icons/phpm.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "phpm-markup",
                "aliases": [],
                "configuration": "./markup-language-configuration.json"
            }
        ],
        "configuration": {
            "title": "Phem",
            "properties": {
                "phem.phemc.path": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "markdownDescription": "The path of a `phemc` binary. When it is set, the extension runs `phemc lsp` as the language server. Empty: the extension runs its bundled server (WebAssembly, with the Node of VS Code)."
                },
                "phem.phemc.sourceDir": {
                    "type": "string",
                    "default": "src",
                    "scope": "resource",
                    "markdownDescription": "The source directory of the `.phpm` files, relative to the project root (the directory with `composer.json`). The server checks the files of this directory as you type."
                }
            }
        },
        "grammars": [
            {
                "language": "phpm",
                "scopeName": "source.phpm",
                "path": "./syntaxes/phpm.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.markup.phpm": "phpm-markup",
                    "source.js.embedded.phpm": "javascript",
                    "source.css.embedded.phpm": "css"
                }
            }
        ]
    },
    "dependencies": {
        "vscode-languageclient": "9.0.1"
    },
    "scripts": {
        "vscode:prepublish": "esbuild src/extension.js --bundle --outfile=dist/extension.js --platform=node --format=cjs --external:vscode --minify"
    },
    "devDependencies": {
        "esbuild": "0.25.10"
    }
}
