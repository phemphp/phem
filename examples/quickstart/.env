# The defaults for development. Put local or production values in .env.local (not committed).
APP_ENV=dev
APP_SECRET=quickstart-dev-secret
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/gallery.sqlite"
# The subscriber key of the Mercure hub: the same value as the default of the Caddyfile. Set
# another one in production, in .env.local and in the environment of FrankenPHP.
MERCURE_SUBSCRIBER_JWT_KEY='!ChangeThisMercureHubSubscriberKey!-quickstart-only'
