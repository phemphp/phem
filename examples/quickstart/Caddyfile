# The FrankenPHP configuration of the quickstart. Run `frankenphp run` in this directory.
#
# public/index.php runs in worker mode: each worker boots the kernel once and handles many
# requests. FRANKENPHP_WORKER_CONFIG adds options to the worker, for example
# `watch ./src/**/*.php` (restart the workers when a PHP file changes).
{
	frankenphp {
		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}

{$SERVER_NAME::8080} {
	encode zstd gzip
	header -X-Powered-By

	# The Mercure hub of FrankenPHP, at /.well-known/mercure, for the pages with #[Subscribe].
	# A request publishes with mercure_publish(), with no HTTP request and no publisher JWT. The
	# worker of the #[Async] handlers publishes with the HTTP API of the hub and a publisher JWT
	# (phem.mercure.publisher_key, MERCURE_PUBLISHER_JWT_KEY in .env). The `local` transport keeps
	# the updates in memory, with no history. A subscriber needs an access token of the `phem`
	# issuer: Phem puts one in a cookie for the topics of each page. The key is the
	# phem.mercure.subscriber_key option (MERCURE_SUBSCRIBER_JWT_KEY in .env).
	mercure {
		transport local
		issuer phem {
			subscriber {
				jwt {$MERCURE_SUBSCRIBER_JWT_KEY:!ChangeThisMercureHubSubscriberKey!-quickstart-only}
			}
			publisher {
				jwt {$MERCURE_PUBLISHER_JWT_KEY:!ChangeThisMercureHubPublisherKey!-quickstart-only}
			}
		}
	}
	# The browser checks the static files again on each load (ETag); PHP sets its own value.
	header ?Cache-Control no-cache

	# The example sources as plain text, for the sandboxes of the learn pages.
	@sources path /examples-src/* /components-src/* /repository-src/*
	header @sources Content-Type "text/plain; charset=utf-8"
	handle_path /examples-src/* {
		root * src/Page/Example
		file_server
	}
	handle_path /components-src/* {
		root * src/Component
		file_server
	}
	handle_path /repository-src/* {
		root * src/Repository
		file_server
	}

	# The JavaScript packages of importmap.php (`bin/console importmap:install`), for the
	# Stimulus controllers of the static learn pages.
	handle_path /vendor/* {
		root * assets/vendor
		file_server
	}

	# The static files of public/ (a directory serves its index.html), then the Symfony
	# application.
	handle {
		root * public
		try_files {path}/index.html
		php_server
	}
}
