{
    "name": "phem/quickstart",
    "description": "The Phem Quick Start: a react.dev/learn-style page whose examples are real .phpm files, in a Symfony application.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "doctrine/orm": "^3.7",
        "phem/phem": "@dev",
        "symfony/asset": "^7.4|^8.0",
        "symfony/asset-mapper": "^7.4|^8.0",
        "symfony/doctrine-messenger": "^7.4|^8.0",
        "symfony/dotenv": "^7.4|^8.0",
        "symfony/form": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/messenger": "^7.4|^8.0",
        "symfony/mime": "^7.4|^8.0",
        "symfony/runtime": "^7.4|^8.0",
        "symfony/stimulus-bundle": "^2.20",
        "symfony/validator": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "repositories": [
        { "type": "path", "url": "../../phem" }
    ],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "scripts": {
        "post-install-cmd": ["@php bin/console importmap:install"],
        "post-update-cmd": ["@php bin/console importmap:install"]
    },
    "config": {
        "allow-plugins": { "symfony/runtime": true },
        "sort-packages": true
    },
    "require-dev": {
        "symfony/stopwatch": "^7.4|^8.0",
        "symfony/web-profiler-bundle": "^7.4|^8.0"
    }
}
