{
    "name": "rephp/quickstart",
    "description": "The rephp Quick Start: a react.dev/learn-style page whose examples are real .rhp files, in a Symfony application.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.0",
        "rephp/runtime": "@dev",
        "symfony/dotenv": "^7.4|^8.0",
        "symfony/runtime": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "repositories": [
        { "type": "path", "url": "../../runtime" }
    ],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "scripts": {
        "post-install-cmd": ["@php bin/console assets:install public"],
        "post-update-cmd": ["@php bin/console assets:install public"]
    },
    "config": {
        "allow-plugins": { "symfony/runtime": true },
        "sort-packages": true
    }
}
