<?phpm
namespace App\Component;

use App\Dto\NewScientist;
use App\Form\ScientistType;
use App\Model\Scientist;
use App\Repository\ScientistRepository;
use Phem\Attribute\{Component, Transactional};
use Phem\Event;
use Phem\Node;
use Symfony\Component\Form\FormFactoryInterface;
use Symfony\Component\Form\FormInterface;
use Symfony\Component\HttpFoundation\Request;

#[Component]
final class AddScientist
{
    private ?FormInterface $form = null {
        get => $this->form ??= $this->forms->create(ScientistType::class);
    }

    public function __construct(
        private readonly FormFactoryInterface $forms,
    ) {
    }

    // The request has the form fields as its POST data. The repository is an argument too.
    #[Transactional]
    public function add(Request $request, ScientistRepository $scientists, Event $e): void
    {
        $scientist = new NewScientist();

        $this->form = $this->forms->create(ScientistType::class, $scientist)
            ->handleRequest($request);

        if ($this->form->isSubmitted() && $this->form->isValid()) {
            $scientists->add(new Scientist($scientist->name, $scientist->profession));
            $e->dispatcher->dispatch('toast', ['message' => \sprintf('%s was added.', $scientist->name)]);

            $this->form = null;
            // The list of the page shows the new row: render the full page, not only this form.
            $e->refresh();
        }
    }

    public function render(): Node
    {
        $view = $this->form->createView();

        return (
            <form className="add-scientist" onSubmit={{ add }}>
                <div className="field">
                    {{ form_widget(view.name) }}
                    {{ form_errors(view.name) }}
                </div>
                <div className="field">
                    {{ form_widget(view.profession) }}
                    {{ form_errors(view.profession) }}
                </div>
                <button type="submit">Add</button>
            </form>
        );
    }
}
