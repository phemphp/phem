<?phpm

namespace App\Components;

use Phem\Attribute\Component;
use Phem\{Html, Root};

// The HTML document of the pages: a page renders its content in it, and can give the title
// with a slot (<Document:title>Home</Document:title>).
#[Component]
function Document(?Html $title = null, ?Html $children = null)
{
    return (
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title>{{ title ?? 'Phem' }}</title>
                <link rel="icon" href="data:," />
                {{ importmap('app') }}
            </head>
            <body>
                <Root>{{ children }}</Root>
                <div className="toast" role="status" data-controller="toast" data-action="phem:toast@window->toast#show"></div>
            </body>
        </html>
    );
}
