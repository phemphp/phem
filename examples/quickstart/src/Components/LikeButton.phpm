<?phpm

namespace App\Components;

use Phem\Attribute\{Component, State};

// A class component with its own state. Each <LikeButton /> keeps its own value.
// `phem:loading` shows the "…" only while the `toggle` event of this button runs.
#[Component]
final class LikeButton
{
    #[State] 
    public bool $liked = false;

    public function toggle(): void
    {
        $this->liked = !$this->liked;
    }

    public function render()
    {
        return (
            <button onClick={{ toggle }}>
                {{ liked ? '♥ Liked' : '♡ Like' }}
                <span phem:loading={{ toggle }}>…</span>
            </button>
        );
    }
}
