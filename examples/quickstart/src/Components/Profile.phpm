<?phpm
namespace App\Components;

use Phem\Attribute\Component;
use Phem\Node;

// More than one component can go in one file.
#[Component]
function Avatar(string $name, int $size = 64): Node
{
    return (
        <img
            className="avatar"
            src="/img/avatar.svg"
            alt={{ name }}
            width={{ size }}
            height={{ size }}
        />
    );
}

#[Component]
function Profile(array $person): Node
{
    // LikeButton is in this namespace too, so it needs no import.
    return (
        <section className="profile">
            <Avatar name={{ person.name }} />
            <div>
                <h2>{{ person.name }}</h2>
                <p>{{ person.profession }}</p>
                <LikeButton />
            </div>
        </section>
    );
}
