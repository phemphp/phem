<?phpm

namespace App\Page\Example;

use Phem\Attribute\{Component, Page, State};
use Phem\Node;

use function App\Component\Document;

#[Component]
final class Counter
{
    #[State]
    public int $count = 0;

    public function handleClick(): void
    {
        ++$this->count;
    }

    public function render(): Node
    {
        return (
            <button onClick={{ handleClick }}>
                Clicked {{ count }} times
            </button>
        );
    }
}

#[Page('/examples/CounterSeparate')]
final class CounterSeparate
{
    public function render(): Node
    {
        return (
            <Document>
                <Document:title>CounterSeparate</Document:title>
                <div>
                    <h1>Counters that update separately</h1>
                    <Counter />
                    <Counter />
                </div>
            </Document>
        );
    }
}
