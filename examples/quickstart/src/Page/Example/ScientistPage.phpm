<?phpm
namespace App\Page\Example;

use App\Model\Scientist;
use App\Repository\ScientistRepository;
use Phem\Attribute\{Component, Page, Prop, Transactional};
use Phem\Node;
use Symfony\Component\HttpFoundation\RedirectResponse;

use function App\Component\{Layout, ScientistCard, Document};

// A function page: the {id:scientist} route value goes to the $scientist parameter.
#[Page('/examples/ScientistPage/{id:scientist}', requirements: ['id' => '\d+'])]
function ScientistPage(Scientist $scientist): Node
{
    return (
        <Document>
            <Document:title>{{ scientist.name }}</Document:title>
            <Layout title={{ scientist.name }}>
                <ScientistCard scientist={{ scientist }} />
                <DeleteScientistButton scientist={{ scientist }} />
                <Layout:footer><a href="/examples/DurableGallery">All the scientists</a></Layout:footer>
            </Layout>
        </Document>
    );
}

#[Component]
final class DeleteScientistButton
{
    #[Prop]
    public Scientist $scientist;

    // The handler gets the repository as an argument, as the action of a controller.
    #[Transactional]
    public function delete(ScientistRepository $scientists): RedirectResponse
    {
        $scientists->remove($this->scientist);

        return new RedirectResponse('/examples/DurableGallery');
    }

    public function render(): Node
    {
        return <button onClick={{ delete }}>Delete</button>;
    }
}
