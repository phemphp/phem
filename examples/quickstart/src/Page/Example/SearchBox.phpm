<?phpm
namespace App\Page\Example;

use Phem\Attribute\{Page, State, Url};
use Phem\Node;

use function App\Component\Document;

#[Page('/examples/SearchBox')]
final class SearchBox
{
    // In the URL (`?name=Ada`): a reload or a shared link keeps the name.
    #[State, Url]
    public string $name = '';

    public function handleClear(): void
    {
        $this->name = '';
    }

    public function render(): Node
    {
        return (
            <Document>
                <Document:title>SearchBox</Document:title>
                <div>
                    <label htmlFor="search-name">Your name</label>
                    <input id="search-name" phem:bind={{ name }} phem:live />
                    <button onClick={{ handleClear }}>Clear</button>
                    <p>{{ name ? 'Hello, ' ~ name ~ '!' : 'Type your name.' }}</p>
                </div>
            </Document>
        );
    }
}
