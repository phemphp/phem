<?phpm

namespace App\Pages;

use Mamu\Http\PageView;

// The HTML document of the pages: each page extends it. A page can change the title (the
// $title property, or the title() method for a dynamic title), or the whole document.
class Document implements \Mamu\Document
{
    protected string $title = 'Mamu';

    public function title(): string
    {
        return $this->title;
    }

    public function document(PageView $page)
    {
        return (
            <html lang="en">
                <head>
                    <meta charset="utf-8" />
                    <meta name="viewport" content="width=device-width, initial-scale=1" />
                    <title>{{ this.title() }}</title>
                    <link rel="icon" href="data:," />
                    {{ importmap('app') }}
                </head>
                <body>{{ mamu_root(page) }}</body>
            </html>
        );
    }
}
