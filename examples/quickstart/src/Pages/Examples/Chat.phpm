<?phpm
namespace App\Pages\Examples;

use Phem\Attribute\{Component, Context, Page, Provide, State, Subscribe};
use Phem\{Event, Feed, Node};

use function App\Components\Document;

// A minimal chat: open this page in two tabs, and send a message in one of them.
// - #[Subscribe] connects the page to the Mercure hub of FrankenPHP.
// - `messages` is a Feed: the page prints it in a loop, and post() pushes each new message to
//   all the open tabs, with the markup of the loop body. No code names a topic or a target id.
// - ChatForm gets the page as a context (#[Provide]), and calls post().
// - There is no database: the feed has no history, so a tab shows only the messages that come
//   after it opens. Phem keeps the pushed messages when the page renders again.
#[Page('/examples/Chat'), Subscribe, Provide]
final class Chat
{
    public Feed $messages;

    public function post(string $name, string $text): void
    {
        $this->messages->append(new ChatMessage($name, $text));
    }

    public function render(): Node
    {
        return (
            <Document>
                <Document:title>Chat</Document:title>
                <h1>Chat</h1>
                <ul>
                    {% for m in messages %}
                        <li key={{ m.id }}><strong>{{ m.name }}</strong>: {{ m.text }}</li>
                    {% endfor %}
                </ul>
                <ChatForm />
            </Document>
        );
    }
}

// One message. The id is the key: the tab that sent the message shows it one time.
final readonly class ChatMessage
{
    public string $id;

    public function __construct(
        public string $name,
        public string $text,
    ) {
        $this->id = bin2hex(random_bytes(8));
    }
}

#[Component]
final class ChatForm
{
    #[State] public string $name = '';
    #[State] public string $text = '';
    #[Context] public Chat $chat;

    public function send(Event $e): void
    {
        $name = mb_substr(trim($this->name), 0, 40);
        $text = mb_substr(trim($this->text), 0, 280);
        if ('' === $name || '' === $text) {
            return;
        }
        $this->text = '';

        $this->chat->post($name, $text);
    }

    public function render(): Node
    {
        return (
            <form onSubmit={{ send }}>
                <input name="name" placeholder="Your name" maxlength="40" phem:bind={{ name }} />
                <input name="text" placeholder="A message" maxlength="280" phem:bind={{ text }} />
                <button type="submit">Send</button>
            </form>
        );
    }
}
