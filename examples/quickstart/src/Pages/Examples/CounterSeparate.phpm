<?phpm

namespace App\Pages\Examples;

use App\Pages\Document;
use Mamu\Attribute\{Component, Page, State};

#[Component]
final class Counter
{
    #[State]
    public int $count = 0;

    public function handleClick(): void
    {
        ++$this->count;
    }

    public function render()
    {
        return (
            <button onClick={{ handleClick }}>
                Clicked {{ count }} times
            </button>
        );
    }
}

#[Page('/examples/CounterSeparate')]
final class CounterSeparate extends Document
{
    protected string $title = 'CounterSeparate';

    public function render()
    {
        return (
            <div>
                <h1>Counters that update separately</h1>
                <Counter />
                <Counter />
            </div>
        );
    }
}
