<?phpm
namespace App\Pages\Examples;

use App\Model\GuestbookEntry as Entry;
use App\Repository\GuestbookRepository;
use Phem\Attribute\{Component, Context, Page, Prop, Provide, State, Subscribe};
use Phem\{Event, Feed, Node};

use function App\Components\Document;

// Real-time push: open this page in two tabs, and sign in one of them.
// - #[Subscribe] connects the page to the Mercure hub of FrankenPHP (see the Caddyfile).
// - `entries` is a Feed with the latest entries: sign() prepends the new entry, and Phem pushes
//   it to each tab with the markup of the loop body. No code names a topic or a target id.
// - `refresh()` of the feed renders the page again in each tab, with a normal event:
//   GuestbookStats has no #[State], so mount() reads the new data; the open list of names (a
//   #[State] of its child) stays open.
// - SignForm gets the page as a context (#[Provide]), and calls sign().
// The pushes go to the hub after the transaction of the event: the new entry has its id.
#[Page('/examples/Guestbook'), Subscribe, Provide]
final class Guestbook
{
    public Feed $entries;

    public function __construct(private readonly GuestbookRepository $repository)
    {
    }

    public function mount(): void
    {
        $this->entries = Feed::of($this->repository->latest());
    }

    public function sign(string $name, string $message): void
    {
        $entry = new Entry($name, $message);
        $this->repository->add($entry);
        $this->entries->prepend($entry);
        $this->entries->refresh();
    }

    public function render(): Node
    {
        return (
            <Document>
                <Document:title>Guestbook</Document:title>
                <h1>Guestbook</h1>
                <SignForm />
                <GuestbookStats />
                <ul className="entries">
                    {% for entry in entries %}
                        <li key={{ entry.id }}>
                            <strong>{{ entry.name }}</strong>: {{ entry.message }}
                            <small>{{ entry.signedAt|date('H:i:s') }}</small>
                        </li>
                    {% endfor %}
                </ul>
            </Document>
        );
    }
}

#[Component]
final class SignForm
{
    #[State] public string $name = '';
    #[State] public string $message = '';
    #[Context] public Guestbook $guestbook;

    public function sign(Event $e): void
    {
        $name = mb_substr(trim($this->name), 0, 40);
        $message = mb_substr(trim($this->message), 0, 280);
        if ('' === $name || '' === $message) {
            return;
        }
        $this->message = '';

        $this->guestbook->sign($name, $message);
    }

    public function render(): Node
    {
        return (
            <form className="sign" onSubmit={{ sign }}>
                <input name="name" placeholder="Your name" maxlength="40" phem:bind={{ name }} />
                <input name="message" placeholder="A message" maxlength="280" phem:bind={{ message }} />
                <button type="submit">Sign</button>
            </form>
        );
    }
}

// The stats: data with no #[State], so mount() reads it in each render (and in a refresh).
#[Component]
final class GuestbookStats
{
    /** @var list<string> */
    public array $names = [];

    public function __construct(private readonly GuestbookRepository $repository)
    {
    }

    public function mount(): void
    {
        $this->names = $this->repository->names();
    }

    public function render(): Node
    {
        return (
            <section>
                <SignedNames names={{ names }} />
            </section>
        );
    }
}

// A state of the UI: the list of names is open or closed. The names are a prop.
#[Component]
final class SignedNames
{
    /** @var list<string> */
    #[Prop] public array $names = [];
    #[State] public bool $open = false;

    public function toggle(): void
    {
        $this->open = !$this->open;
    }

    public function render(): Node
    {
        return (
            <div>
                <p>
                    {{ names|length }} people signed.
                    <button type="button" onClick={{ toggle }}>{{ open ? 'Hide' : 'Show' }} the names</button>
                </p>
                {% if open %}<p>{{ names|join(', ') }}</p>{% endif %}
            </div>
        );
    }
}
