<?phpm
namespace App\Pages\Examples;

use Phem\Attribute\{Page, State};
use Phem\BrowserEventDispatcher;

use function App\Components\Document;

// Client code with Stimulus (assets/controllers/).
// - The menu of a message opens in the browser, with no server event (`dropdown`).
//   `data-phem-client` gives its `hidden` and `aria-expanded` to the controller, so the morph of
//   "Star" does not close it.
// - "Delete" hides the message at once (`optimistic`), before the server answers. On `phem:done`,
//   the message shows again if the server still renders it: a starred message stays.
// The morph matches the rows by their `key`, so the client changes stay on the correct row.
#[Page('/examples/Inbox')]
final class Inbox
{
    #[State]
    public array $messages = [
        ['id' => 1, 'subject' => 'Lunch on Friday?', 'starred' => false, 'read' => false],
        ['id' => 2, 'subject' => 'The report is ready', 'starred' => true, 'read' => true],
        ['id' => 3, 'subject' => 'Your order has shipped', 'starred' => false, 'read' => false],
    ];

    public function __construct(private readonly BrowserEventDispatcher $dispatcher)
    {
    }

    public function toggle(int $id, string $flag): void
    {
        foreach ($this->messages as $i => $message) {
            if ($message['id'] === $id) {
                $this->messages[$i][$flag] = !$message[$flag];
            }
        }
    }

    public function delete(int $id): void
    {
        foreach ($this->messages as $i => $message) {
            if ($message['id'] !== $id) {
                continue;
            }
            if ($message['starred']) {
                $this->dispatcher->dispatch('toast', ['message' => 'A starred message stays.']);

                return;
            }
            unset($this->messages[$i]);
        }
        $this->messages = array_values($this->messages);
    }

    public function render()
    {
        $rows = [];
        foreach ($this->messages as $message) {
            $id = $message['id'];
            $star = fn () => $this->toggle($id, 'starred');
            $read = fn () => $this->toggle($id, 'read');
            $delete = fn () => $this->delete($id);
            $rows[] = (
                <li key={{ id }} data-controller="optimistic" data-phem-client="hidden">
                    {{ message.starred ? '★' : '☆' }}
                    {% if message.read %}{{ message.subject }}{% else %}<strong>{{ message.subject }}</strong>{% endif %}
                    <span data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc@window->dropdown#close">
                        <button data-dropdown-target="button" data-action="dropdown#toggle" data-phem-client="aria-expanded" aria-expanded="false">⋯</button>
                        <span data-dropdown-target="menu" data-phem-client="hidden" hidden>
                            <button onClick={{ star }}>{{ message.starred ? 'Unstar' : 'Star' }}</button>
                            <button onClick={{ read }}>{{ message.read ? 'Mark as unread' : 'Mark as read' }}</button>
                        </span>
                    </span>
                    <button onClick={{ delete }} data-action="optimistic#hide phem:done->optimistic#show">Delete</button>
                </li>
            );
        }

        return (
            <Document>
                <Document:title>Inbox</Document:title>
                <ul>{{ rows }}</ul>
                {% if not messages %}<p>No messages.</p>{% endif %}
            </Document>
        );
    }
}
