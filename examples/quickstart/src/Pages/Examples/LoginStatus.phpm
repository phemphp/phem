<?phpm
namespace App\Pages\Examples;

use Mamu\Attribute\{Component, State};
use Symfony\Component\Routing\Attribute\Route;

function AdminPanel()
{
    return (
        <div className="panel">
            <h2>Admin panel</h2>
            <p>Welcome back. You can edit the site.</p>
        </div>
    );
}

function LoginForm()
{
    return (
        <div className="panel">
            <h2>Please log in</h2>
            <p>Log in to see the admin panel.</p>
        </div>
    );
}

#[Route('/examples/LoginStatus')]
#[Component]
final class LoginStatus
{
    #[State] public bool $isLoggedIn = false;

    public function toggle(): void
    {
        $this->isLoggedIn = !$this->isLoggedIn;
    }

    public function render()
    {
        if ($this->isLoggedIn) {
            $content = <AdminPanel />;
        } else {
            $content = <LoginForm />;
        }

        return (
            <div>
                <title>LoginStatus</title>
                {{ content }}
                <button onClick={{ toggle }}>
                    {{ isLoggedIn ? 'Log out' : 'Log in' }}
                </button>
                {{ isLoggedIn and <p>You have admin rights.</p> }}
            </div>
        );
    }
}
