<?phpm
namespace App\Pages\Examples;

use Mamu\Attribute\{Page, State};

use function App\Components\Document;

function AdminPanel()
{
    return (
        <div className="panel">
            <h2>Admin panel</h2>
            <p>Welcome back. You can edit the site.</p>
        </div>
    );
}

function LoginForm()
{
    return (
        <div className="panel">
            <h2>Please log in</h2>
            <p>Log in to see the admin panel.</p>
        </div>
    );
}

#[Page('/examples/LoginStatus')]
final class LoginStatus
{
    #[State]
    public bool $isLoggedIn = false;

    public function toggle(): void
    {
        $this->isLoggedIn = !$this->isLoggedIn;
    }

    public function render()
    {
        if ($this->isLoggedIn) {
            $content = <AdminPanel />;
        } else {
            $content = <LoginForm />;
        }

        return (
            <Document>
                <Document:title>LoginStatus</Document:title>
                <div>
                    {{ content }}
                    <button onClick={{ toggle }}>
                        {{ isLoggedIn ? 'Log out' : 'Log in' }}
                    </button>
                    {{ isLoggedIn and <p>You have admin rights.</p> }}
                </div>
            </Document>
        );
    }
}
