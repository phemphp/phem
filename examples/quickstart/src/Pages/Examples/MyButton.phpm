<?phpm
namespace App\Pages\Examples;

use Mamu\Attribute\{Component, Page};
use Mamu\Html;

use function App\Components\Document;

#[Component]
function MyButton()
{
    return (
        <button>I'm a button</button>
    );
}

#[Component]
function IconButton(string $icon, ?Html $children = null, mixed ...$props)
{
    return (
        <button type="button" onclick="alert('Clicked!')" {{ ...props }}>
            <span aria-hidden="true">{{ icon }}</span> {{ children }}
        </button>
    );
}

#[Page('/examples/MyButton')]
final class MyApp
{
    public function render()
    {
        return (
            <Document>
                <Document:title>MyButton</Document:title>
                <div>
                    <h1>Welcome to my app</h1>
                    <MyButton />
                    <IconButton icon="★" title="Add to favorites" aria-label="Add to favorites">
                        Favorite
                    </IconButton>
                </div>
            </Document>
        );
    }
}
