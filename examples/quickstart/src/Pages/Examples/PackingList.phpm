<?phpm
namespace App\Pages\Examples;

use Phem\Attribute\{Component, Page, State};
use Phem\Bound;

use function App\Components\Document;

// A child component binds a property of its parent: `<Stepper phem:bind={{ trip.days }} />`.
#[Component]
function Stepper(Bound $value, int $min = 0)
{
    return <input type="number" min={{ min }} phem:bind={{ value }} phem:live />;
}

#[Page('/examples/PackingList')]
final class PackingList
{
    // A path binds a value in an array: `trip.days`, `items[i].packed`.
    #[State]
    public array $trip = ['destination' => 'Lisbon', 'days' => 3];

    #[State]
    public array $items = [
        ['name' => 'Sunglasses', 'count' => 1, 'packed' => true],
        ['name' => 'Socks', 'count' => 3, 'packed' => false],
        ['name' => 'Toothbrush', 'count' => 1, 'packed' => false],
    ];

    public function handlePackAll(): void
    {
        // The names that the user changed are already here.
        foreach ($this->items as $i => $item) {
            $this->items[$i]['packed'] = true;
        }
    }

    public function render()
    {
        $packed = count(array_filter(array_column($this->items, 'packed')));
        $things = array_sum(array_column($this->items, 'count'));

        return (
            <Document>
                <Document:title>PackingList</Document:title>
                <div>
                    <p>
                        <label>Trip to <input phem:bind={{ trip.destination }} phem:live /></label>
                        <label>for <Stepper phem:bind={{ trip.days }} min={{ 1 }} /> days</label>
                    </p>
                    <ul>
                        {% for i, item in items %}
                            <li key={{ i }}>
                                <input type="checkbox" phem:bind={{ items[i].packed }} phem:live />
                                <Stepper phem:bind={{ items[i].count }} />
                                <input phem:bind={{ items[i].name }} />
                            </li>
                        {% endfor %}
                    </ul>
                    <button onClick={{ handlePackAll }}>Pack all</button>
                    <p id="summary">
                        {{ trip.destination ?: 'Somewhere' }}, {{ trip.days }} days:
                        {{ packed }} of {{ items|length }} packed ({{ things }} things).
                        {{ items|column('name')|join(', ') }}
                    </p>
                </div>
            </Document>
        );
    }
}
