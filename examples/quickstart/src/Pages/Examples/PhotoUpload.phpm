<?phpm
namespace App\Pages\Examples;

use Phem\Attribute\{Page, State};
use Phem\Event;
use Symfony\Component\Validator\Constraints\Image;
use Symfony\Component\Validator\Validator\ValidatorInterface;

use function App\Components\Document;

#[Page('/examples/PhotoUpload')]
final class PhotoUpload
{
    // What the page shows about the photos. The photos are not state.
    #[State] public array $photos = [];
    #[State] public array $errors = [];

    public function __construct(private readonly ValidatorInterface $validator)
    {
    }

    public function handleSubmit(Event $e): void
    {
        $this->photos = [];
        $this->errors = [];

        foreach ($e->files['photos'] ?? [] as $photo) {
            $violations = $this->validator->validate($photo, new Image(maxSize: '2M'));
            if (\count($violations) > 0) {
                $this->errors[] = $photo->getClientOriginalName().': '.$violations[0]->getMessage();
                continue;
            }

            [$width, $height] = getimagesize($photo->getPathname()) ?: [0, 0];
            $this->photos[] = \sprintf('%s: %d × %d px, %d KB', $photo->getClientOriginalName(), $width, $height, ceil($photo->getSize() / 1024));

            // To keep a photo, move it: $photo->move($dir, $name).
            // This example keeps none: PHP removes them after the request.
        }
    }

    public function render()
    {
        return (
            <Document>
                <Document:title>PhotoUpload</Document:title>
                <form onSubmit={{ handleSubmit }}>
                    <label htmlFor="photos">Photos (2 MB each at most)</label>
                    <input id="photos" type="file" name="photos[]" accept="image/*" multiple />
                    <progress phem:progress={{ handleSubmit }} max="100"></progress>
                    <button type="submit">
                        Upload <span phem:loading={{ handleSubmit }}>…</span>
                    </button>
                </form>
                <ul>
                    {% for photo in photos %}
                        <li key={{ 'photo-' ~ loop.index }}>{{ photo }}</li>
                    {% endfor %}
                    {% for error in errors %}
                        <li key={{ 'error-' ~ loop.index }} className="form-error">{{ error }}</li>
                    {% endfor %}
                </ul>
            </Document>
        );
    }
}
