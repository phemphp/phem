<?phpm
namespace App\Pages\Examples;

use App\Pages\Document;
use Mamu\Attribute\Page;

#[Page('/examples/Profile')]
final class Profile extends Document
{
    protected string $title = 'Profile';

    public function render()
    {
        $user = [
            'name' => 'Hedy Lamarr',
            'imageUrl' => '/img/avatar.svg',
            'imageSize' => 90,
        ];

        return (
            <>
                <h1>{{ user.name }}</h1>
                <img
                    className="avatar"
                    src={{ user.imageUrl }}
                    alt="Photo of {{ user.name }}"
                    style={{ {width: user.imageSize, height: user.imageSize} }}
                />
            </>
        );
    }
}
