<?phpm
namespace App\Pages\Examples;

use App\Model\Scientist;
use App\Repository\ScientistRepository;
use Phem\Attribute\{Page, Path, Transactional};
use Phem\Node;
use Symfony\Component\HttpFoundation\RedirectResponse;

use function App\Components\{Layout, ScientistCard, Document};

#[Page('/examples/ScientistPage/{id:scientist}', requirements: ['id' => '\d+'])]
final class ScientistPage
{
    #[Path]
    public Scientist $scientist;

    public function __construct(
        private readonly ScientistRepository $scientists,
    ) {
    }

    #[Transactional]
    public function delete(): RedirectResponse
    {
        $this->scientists->remove($this->scientist);

        return new RedirectResponse('/examples/DurableGallery');
    }

    public function render(): Node
    {
        return (
            <Document>
                <Document:title>{{ scientist.name }}</Document:title>
                <Layout title={{ scientist.name }}>
                    <ScientistCard scientist={{ scientist }} />
                    <button onClick={{ delete }}>Delete</button>
                    <Layout:footer><a href="/examples/DurableGallery">All the scientists</a></Layout:footer>
                </Layout>
            </Document>
        );
    }
}
