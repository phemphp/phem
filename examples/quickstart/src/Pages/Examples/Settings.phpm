<?phpm
namespace App\Pages\Examples;

use Phem\Attribute\{Component, Context, Page, Prop, Provide, State};
use Phem\{Event, Html, Node};

use function App\Components\Document;

// Contexts: a value of a component far above, with no props in between.
// - <Tabs> provides itself: each <Tab> reads the active tab and calls `select` of the tabs.
// - The page provides the theme: <Panel> reads it, deep in the tree.
// - <Section> passes no props to the tabs, and it does not render again after a click. The tabs
//   show the change anyway: the context propagates to them.

enum Theme: string
{
    case Light = 'light';
    case Dark = 'dark';

    public function other(): Theme
    {
        return $this === self::Light ? self::Dark : self::Light;
    }
}

#[Component, Provide]
final class Tabs
{
    #[State] public string $active = 'profile';
    #[Prop] public ?Html $children = null;

    public function select(Event $e): void
    {
        $this->active = (string) $e->value;
    }

    public function render(): Node
    {
        return <div role="tablist">{{ children }}</div>;
    }
}

#[Component]
function Tab(string $name, string $label, #[Context] Tabs $tabs): Node
{
    return (
        <button role="tab" aria-selected={{ tabs.active == name ? 'true' : 'false' }} onClick={{ tabs.select }} value={{ name }}>
            {{ label }}
        </button>
    );
}

#[Component]
function Panel(string $name, ?Html $children = null, #[Context] ?Tabs $tabs = null, #[Context] Theme $theme = Theme::Light): ?Node
{
    if (null !== $tabs && $tabs->active !== $name) {
        return null;
    }

    return <div role="tabpanel" className="panel-{{ theme.value }}">{{ children }}</div>;
}

#[Component]
function Section(string $title, ?Html $children = null): Node
{
    return <section><h2>{{ title }}</h2>{{ children }}</section>;
}

#[Page('/examples/Settings')]
final class Settings
{
    #[State, Provide] 
    public Theme $theme = Theme::Light;

    public function toggleTheme(): void
    {
        $this->theme = $this->theme->other();
    }

    public function render(): Node
    {
        return (
            <Document>
                <Document:title>Settings</Document:title>
                <button onClick={{ toggleTheme }}>Theme: {{ theme.value }}</button>
                <Tabs>
                    <Section title="Settings">
                        <Tab name="profile" label="Profile" />
                        <Tab name="security" label="Security" />
                        <Panel name="profile"><p>Your name and your photo.</p></Panel>
                        <Panel name="security"><p>Your password and your sessions.</p></Panel>
                    </Section>
                </Tabs>
            </Document>
        );
    }
}
