<?php
namespace App\Components;

use App\Repository\ScientistRepository;
use Rephp\Attribute\{Component, State};
use Rephp\Event;

// A form that inserts a row. The error message is browser state (#[State]): it is only
// for this visitor. The new scientist is in the database: all visitors see it.
#[Component]
final class AddScientist
{
    #[State] public ?string $error = null;

    public function __construct(
        private readonly ScientistRepository $scientists,
    ) {
    }

    public function add(Event $e): void
    {
        $name = mb_substr(trim((string) ($e->form['name'] ?? '')), 0, 80);
        $profession = mb_substr(trim((string) ($e->form['profession'] ?? '')), 0, 80);
        if ('' === $name || '' === $profession) {
            $this->error = 'Type a name and a profession.';

            return;
        }
        $this->scientists->add($name, $profession);
        $this->error = null;
    }

    public function render()
    {
        return (
            <form className="add-scientist" onSubmit={{ add }}>
                <input name="name" placeholder="Name" maxlength="80" />
                <input name="profession" placeholder="Profession" maxlength="80" />
                <button type="submit">Add</button>
                {% if error %}<p className="form-error">{{ error }}</p>{% endif %}
            </form>
        );
    }
}
