<?php
namespace App\Components;

use App\Model\Scientist;
use Rephp\Attribute\{Component, Transactional};

// The scientist prop is the Doctrine entity that the page loaded. The handler changes it, and
// #[Transactional] flushes and commits the change. Then the server renders the page again and
// morphs only this button. No state is kept in the browser.
#[Component]
#[Transactional]
final class LikeCounter
{
    public Scientist $scientist;    // prop

    public function like(): void
    {
        ++$this->scientist->likes;
    }

    public function render()
    {
        return (
            <button onClick={{ like }}>♥ {{ scientist.likes }}</button>
        );
    }
}

// Avatar is in Profile.rhp, in this namespace: it needs no import.
function ScientistCard(Scientist $scientist)
{
    return (
        <section className="profile">
            <Avatar name={{ scientist.name }} />
            <div>
                <h2>{{ scientist.name }}</h2>
                <p>{{ scientist.profession }}</p>
                <LikeCounter key={{ scientist.id }} scientist={{ scientist }} />
            </div>
        </section>
    );
}
