<?php
namespace App\Components;

use App\Repository\ScientistRepository;
use Rephp\Attribute\Component;

// The handler writes to the database. Then the server renders the page again, reads the
// new count, and morphs only this button. No state is kept in the browser.
#[Component]
final class LikeCounter
{
    public int $id;     // prop
    public int $likes;  // prop

    public function __construct(
        private readonly ScientistRepository $scientists,
    ) {
    }

    public function like(): void
    {
        $this->scientists->like($this->id);
    }

    public function render()
    {
        return (
            <button onClick={{ like }}>♥ {{ likes }}</button>
        );
    }
}

// Avatar is in Profile.rhp, in this namespace: it needs no import.
function ScientistCard(array $scientist)
{
    return (
        <section className="profile">
            <Avatar name={{ scientist.name }} />
            <div>
                <h2>{{ scientist.name }}</h2>
                <p>{{ scientist.profession }}</p>
                <LikeCounter key={{ scientist.id }} id={{ scientist.id }} likes={{ scientist.likes }} />
            </div>
        </section>
    );
}
