<?php
namespace App\Data;

use Doctrine\DBAL\Connection;
use Doctrine\DBAL\DriverManager;
use Rephp\Runtime;

// The data layer: plain PHP with Doctrine DBAL, no markup. Components read from it while
// they render, and event handlers write to it. The rows are in var/data/gallery.sqlite,
// so they stay after a reload, in other browsers, and after a server restart.
final class Scientists
{
    private static ?Connection $connection = null;

    /** @return list<array{id: int, name: string, profession: string, likes: int}> */
    public static function all(): array
    {
        return self::db()->fetchAllAssociative('SELECT id, name, profession, likes FROM scientist ORDER BY id');
    }

    public static function add(string $name, string $profession): void
    {
        self::db()->insert('scientist', ['name' => $name, 'profession' => $profession]);
    }

    public static function like(int $id): void
    {
        self::db()->executeStatement('UPDATE scientist SET likes = likes + 1 WHERE id = ?', [$id]);
    }

    // One connection for the life of the server process. The first call makes the
    // database file and adds the three scientists of the Gallery example.
    private static function db(): Connection
    {
        if (null !== self::$connection) {
            return self::$connection;
        }
        $path = Runtime::get()->projectDir.'/var/data/gallery.sqlite';
        if (!is_dir(dirname($path))) {
            mkdir(dirname($path), 0777, true);
        }
        $db = DriverManager::getConnection(['driver' => 'pdo_sqlite', 'path' => $path]);
        $db->executeStatement(<<<'SQL'
            CREATE TABLE IF NOT EXISTS scientist (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name VARCHAR(80) NOT NULL,
                profession VARCHAR(80) NOT NULL,
                likes INTEGER NOT NULL DEFAULT 0
            )
            SQL);
        if (0 === (int) $db->fetchOne('SELECT COUNT(*) FROM scientist')) {
            $db->transactional(static function (Connection $db): void {
                $db->insert('scientist', ['name' => 'Maria Skłodowska-Curie', 'profession' => 'physicist and chemist']);
                $db->insert('scientist', ['name' => 'Katsuko Saruhashi', 'profession' => 'geochemist']);
                $db->insert('scientist', ['name' => 'Lise Meitner', 'profession' => 'physicist']);
            });
        }

        return self::$connection = $db;
    }
}
