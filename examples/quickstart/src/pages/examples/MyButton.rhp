<?php
namespace App\Pages\Examples;

use Symfony\Component\Routing\Attribute\Route;

function MyButton()
{
    return (
        <button>I'm a button</button>
    );
}

#[Route('/examples/MyButton')]
function MyApp()
{
    return (
        <div>
            <title>MyButton</title>
            <h1>Welcome to my app</h1>
            <MyButton />
        </div>
    );
}
