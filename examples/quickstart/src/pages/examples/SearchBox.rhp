<?php
namespace App\Pages\Examples;

use Rephp\Attribute\{Component, Page, State};
use Rephp\Event;

#[Component]
#[Page]
final class SearchBox
{
    #[State] public string $name = '';

    public function handleChange(Event $e): void
    {
        $this->name = (string) $e->value;
    }

    public function handleClear(): void
    {
        $this->name = '';
    }

    public function render()
    {
        return (
            <div>
                <title>SearchBox</title>
                <label htmlFor="search-name">Your name</label>
                <input id="search-name" value={{ name }} onChange={{ handleChange }} />
                <button onClick={{ handleClear }}>Clear</button>
                <p>{{ name ? 'Hello, ' ~ name ~ '!' : 'Type your name.' }}</p>
            </div>
        );
    }
}
