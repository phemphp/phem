<?phpm

namespace App\Pages;

use Mamu\Attribute\{Component, Page, Prop, State};
use Mamu\Html;
use Mamu\Tests\Fixtures\Titled;

use function App\Components\Document;

// A template component with a required slot, and a slot that the template tests.
#[Component]
function Panel(Html $children, ?Html $footer = null) {
    return (
        <section class="panel">
            {{ children }}
            {% if footer %}<footer>{{ footer }}</footer>{% endif %}
        </section>
    );
}

#[Component]
final class Label
{
    #[Prop] public readonly string $text;

    public function render()
    {
        return <span id="label">{{ text }}</span>;
    }
}

// The props, the state and the handler come from a parent class that mamuc does not see.
#[Component]
final class Heading extends Titled
{
    public function render()
    {
        return <h3 id="heading" onClick={{ hit }}>{{ title }} {{ hits }}</h3>;
    }
}

#[Page('/edge')]
final class Edge
{
    #[State] public int $n = 0;

    public function bump(): void
    {
        ++$this->n;
    }

    public function render()
    {
        $odd = array_map(fn ($i) => $i % 2 ? <li key={{ i }}>{{ i }}</li> : null, [1, 2, 3]);

        return (
            <Document>
                <main>
                    <svg id="icon"><title>Icon</title></svg>
                    <Panel><p id="body">Body</p></Panel>
                    <Panel>x<Panel:footer>Foot {{ n }}</Panel:footer></Panel>
                    <ul id="odd">{{ odd }}</ul>
                    <button onClick={{ bump }}>Bump</button>
                    <Label text="n={{ n }}" />
                    <Heading title="Edge" />
                    <p id="path">{{ app.request.pathInfo }}</p>
                </main>
            </Document>
        );
    }
}
