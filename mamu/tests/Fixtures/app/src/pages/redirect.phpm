<?phpm

namespace App\Pages;

use Mamu\Attribute\{Page, State};
use Symfony\Component\HttpFoundation\RedirectResponse;

use function App\Components\Document;

// A handler that returns a RedirectResponse: the browser goes to its URL.
#[Page('/leave')]
final class LeavePage
{
    #[State] public int $count = 0;

    public function leave(): RedirectResponse
    {
        ++$this->count;

        return new RedirectResponse('/about');
    }

    public function render()
    {
        return (
            <Document>
                <button id="leave" onClick={{ leave }}>Leave {{ count }}</button>
            </Document>
        );
    }
}
