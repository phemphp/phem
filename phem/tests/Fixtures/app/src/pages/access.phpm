<?phpm

namespace App\Pages;

use Phem\Attribute\{Page, State};
use Phem\Tests\Fixtures\Deny;
use Symfony\Component\HttpKernel\Attribute\Cache;
use Symfony\Component\HttpKernel\Attribute\RateLimit;

use function App\Components\Document;

// A page behind a path rule (`access_control`): its events go to its URL, so the rule applies.
#[Page('/private/counter')]
final class PrivateCounter
{
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render()
    {
        return (
            <Document>
                <button onClick={{ increment }}>{{ count }}</button>
            </Document>
        );
    }
}

// A controller attribute of a page (as `#[IsGranted]`) applies to the page and to its events.
#[Deny]
#[Page('/denied')]
final class DeniedPage
{
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render()
    {
        return (
            <Document>
                <button onClick={{ increment }}>{{ count }}</button>
            </Document>
        );
    }
}

// A Symfony controller attribute on a page without state.
#[Cache(maxage: 60, public: true)]
#[Page('/cached')]
final class CachedPage
{
    public function render()
    {
        return (
            <Document>
                <p id="cached">Cached</p>
            </Document>
        );
    }
}

// The #[RateLimit] attribute of Symfony 8.1 limits the events of a page. With `methods: 'POST'`,
// it counts the events only, not the GET requests of the page.
#[RateLimit('phem_events', methods: 'POST')]
#[Page('/limited')]
final class LimitedPage
{
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render()
    {
        return (
            <Document>
                <button onClick={{ increment }}>{{ count }}</button>
            </Document>
        );
    }
}
