<?phpm

namespace App\Pages;

use Phem\Attribute\{Component, Page, State};
use Phem\ErrorBoundary;
use Phem\Node;

use function App\Components\Document;

// The tests of <ErrorBoundary> (see Phem\Rendering\ErrorBoundaryRenderer).

// A child with state: it mounts again after the fallback.
#[Component]
final class Ticker
{
    #[State] public int $n = 1;

    public function up(): void
    {
        ++$this->n;
    }

    public function fail(): void
    {
        $this->n = 100;

        throw new \RuntimeException('The handler failed.');
    }

    public function render(): Node
    {
        return (
            <p>
                <button id="up" onClick={{ up }}>Ticks {{ n }}</button>
                <button id="fail" onClick={{ fail }}>Fail</button>
            </p>
        );
    }
}

// A service that is down when `down` is true.
#[Component]
function Quote(bool $down): Node
{
    if ($down) {
        throw new \RuntimeException('The quote service is down.');
    }

    return <p id="quote">Quote 42</p>;
}

// A child with state renders first, then the render throws: the boundary drops the child.
#[Component]
function QuoteCard(bool $down): Node
{
    return <div><Ticker /><Quote down={{ down }} /></div>;
}

#[Page('/error-boundary')]
final class ErrorBoundaryPage
{
    #[State] public int $clicks = 0;
    #[State] public bool $down = false;

    public function click(): void
    {
        ++$this->clicks;
    }

    public function toggle(): void
    {
        $this->down = !$this->down;
    }

    public function render(): Node
    {
        return (
            <Document>
                <button id="click" onClick={{ click }}>Clicks {{ clicks }}</button>
                <button id="toggle" onClick={{ toggle }}>Toggle</button>
                <section id="card">
                    <ErrorBoundary>
                        <ErrorBoundary:fallback><p id="card-fallback">No quote.</p></ErrorBoundary:fallback>
                        <QuoteCard down={{ down }} />
                    </ErrorBoundary>
                </section>
                <section id="other">
                    <ErrorBoundary>
                        <ErrorBoundary:fallback><p id="other-fallback">Never.</p></ErrorBoundary:fallback>
                        <Quote down={{ false }} />
                    </ErrorBoundary>
                </section>
            </Document>
        );
    }
}
