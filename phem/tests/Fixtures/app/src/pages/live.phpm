<?phpm

namespace App\Pages;

use Phem\Attribute\{Component, Context, Page, Path, Provide, State, Subscribe};
use Phem\{Event, LiveCollection, Node};
use Phem\Tests\Fixtures\Guestbook;

use function App\Components\Document;

// The live collections of Phem\LiveCollection: a change goes to the open pages, with the markup of
// the loop body.

// A live collection with no history: the pushes are its only items.
#[Page('/chat/{room}'), Subscribe, Provide]
final class ChatRoom
{
    #[Path] public string $room;
    public LiveCollection $messages;

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    public function post(string $text): void
    {
        $this->messages->append($this->guestbook->add('chat-'.$this->room, $text));
    }

    public function shout(): void
    {
        if (null !== $entry = $this->guestbook->entries('chat-'.$this->room)[0] ?? null) {
            $this->messages->replace(['id' => $entry['id'], 'text' => strtoupper($entry['text'])]);
        }
    }

    public function drop(): void
    {
        if (null !== $id = $this->guestbook->forget('chat-'.$this->room)) {
            $this->messages->remove(['id' => $id, 'text' => '']);
        }
    }

    public function render(): Node
    {
        return (
            <Document>
                <ul class="messages">
                    {% for m in messages %}
                        <li key={{ m.id }} class="message">{{ m.text }}</li>
                    {% endfor %}
                </ul>
                <ChatRoomForm />
            </Document>
        );
    }
}

#[Component]
final class ChatRoomForm
{
    #[State] public string $text = '';
    #[Context] public ChatRoom $chat;

    public function send(Event $e): void
    {
        $this->chat->post($this->text);
        $this->text = '';
    }

    public function shout(): void
    {
        $this->chat->shout();
    }

    public function drop(): void
    {
        $this->chat->drop();
    }

    // The changes of a handler that throws are dropped.
    public function fail(): void
    {
        $this->chat->post('Lost');

        throw new \RuntimeException('The handler failed.');
    }

    public function render(): Node
    {
        return (
            <form onSubmit={{ send }}>
                <input name="text" phem:bind={{ text }} />
                <button id="send" type="submit">Send</button>
                <button id="shout" type="button" onClick={{ shout }}>Shout</button>
                <button id="drop" type="button" onClick={{ drop }}>Drop</button>
                <button id="fail" type="button" onClick={{ fail }}>Fail</button>
            </form>
        );
    }
}

// A live collection with history: mount() reads the items of the server render.
#[Page('/history'), Subscribe, Provide]
final class HistoryPage
{
    public LiveCollection $entries;

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    public function mount(): void
    {
        $this->entries = LiveCollection::of($this->guestbook->entries('history'));
    }

    public function add(string $text, bool $count = false): void
    {
        $this->entries->prepend($this->guestbook->add('history', $text));
        if ($count) {
            $this->entries->refresh();
        }
    }

    public function render(): Node
    {
        return (
            <Document>
                <HistoryCount />
                <ol class="entries">
                    {% for entry in entries %}<li key={{ entry.id }}>{{ entry.text }}</li>{% endfor %}
                </ol>
                <HistoryForm />
            </Document>
        );
    }
}

#[Component]
final class HistoryForm
{
    #[State] public string $text = '';
    #[Context] public HistoryPage $page;

    public function add(): void
    {
        $this->page->add($this->text);
        $this->text = '';
    }

    public function addAndCount(): void
    {
        $this->page->add($this->text, count: true);
        $this->text = '';
    }

    public function render(): Node
    {
        return (
            <form onSubmit={{ add }}>
                <input name="text" phem:bind={{ text }} />
                <button id="add" type="submit">Add</button>
                <button id="add-count" type="button" onClick={{ addAndCount }}>Add and count</button>
            </form>
        );
    }
}

// The data around the live collection: refresh() renders it again in the other tabs.
#[Component]
final class HistoryCount
{
    public int $count = 0;

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    public function mount(): void
    {
        $this->count = \count($this->guestbook->entries('history'));
    }

    public function render(): Node
    {
        return <p class="count">{{ count }} entries</p>;
    }
}

// A live collection on a page with no #[Subscribe]: a change throws.
#[Page('/quiet'), Provide]
final class QuietPage
{
    public LiveCollection $lines;

    public function render(): Node
    {
        return (
            <Document>
                <ul>{% for line in lines %}<li key={{ line }}>{{ line }}</li>{% endfor %}</ul>
                <QuietForm />
            </Document>
        );
    }
}

#[Component]
final class QuietForm
{
    #[Context] public QuietPage $page;

    public function say(): void
    {
        $this->page->lines->append('Hello');
    }

    public function render(): Node
    {
        return <button id="say" onClick={{ say }}>Say</button>;
    }
}

// The same live collection two times in one page: its pushes would go to one element only.
#[Page('/two-logs'), Subscribe]
final class TwoLogsPage
{
    public function render(): Node
    {
        return (
            <Document>
                <LiveLog />
                <LiveLog />
            </Document>
        );
    }
}

#[Component]
final class LiveLog
{
    public LiveCollection $lines;

    public function render(): Node
    {
        return <ul>{% for line in lines %}<li key={{ line }}>{{ line }}</li>{% endfor %}</ul>;
    }
}
