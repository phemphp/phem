includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 8
    paths:
        - src
        - config
        - tests
    # mercure_publish() of the FrankenPHP SAPI (see Phem\Stream\FrankenPhpPublisher).
    scanFiles:
        - stubs/frankenphp.php
    # The PHP that phemc, Twig and Symfony generate in the var/ of the test apps.
    excludePaths:
        - tests/Fixtures/app/var
        - tests/Fixtures/Package/var
    # The runtime supports Symfony 7.4 and later: do not read the version of the installed one.
    dynamicConstantNames:
        - Symfony\Component\HttpKernel\Kernel::VERSION_ID
    ignoreErrors:
        # Twig prints a Markup without escaping. Twig\Markup is @final since Twig 3.28.
        -
            identifier: class.extendsFinalByPhpDoc
            path: src/Html.php
