{
    "name": "mamujs",
    "description": "The Mamu client: the mamu Stimulus controller, which keeps the component state in the browser and morphs the page with Turbo Streams.",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "symfony": {
        "controllers": {
            "mamu": {
                "name": "mamu",
                "main": "dist/mamu_controller.js",
                "fetch": "eager",
                "enabled": true,
                "autoimport": {
                    "@mamuphp/runtime/dist/mamu.css": true
                }
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0",
            "@hotwired/turbo": "^8.0.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "@hotwired/turbo": "^8.0.0"
    }
}
