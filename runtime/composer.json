{
    "name": "rephp/runtime",
    "description": "Runtime for .rhp components: a Symfony bundle with Twig rendering, class components as services, pages as Symfony routes, and Turbo/Stimulus state.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "symfony/config": "^7.4|^8.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/http-foundation": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/routing": "^7.4|^8.0",
        "symfony/twig-bundle": "^7.4|^8.0",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "Rephp\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Rephp\\Tests\\": "tests/" }
    },
    "config": { "sort-packages": true }
}
