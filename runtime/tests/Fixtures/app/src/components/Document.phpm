<?phpm

namespace App\Components;

use Mamu\Http\PageView;

// The default document of the fixture pages (the mamu.document option). A class page that
// extends it is its own document.
class Document implements \Mamu\Document
{
    protected string $title = 'Fixture';

    public function title(): string
    {
        return $this->title;
    }

    public function document(PageView $page)
    {
        $title = $this->title();

        return (
            <html lang="en">
                <head>
                    <meta charset="utf-8" />
                    <title>{{ title }}</title>
                </head>
                <body className="fixture">{{ mamu_root(page) }}</body>
            </html>
        );
    }
}
