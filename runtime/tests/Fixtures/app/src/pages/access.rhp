<?php

namespace App\Pages;

use Rephp\Attribute\{Component, State};
use Rephp\Tests\Fixtures\Deny;
use Symfony\Component\HttpKernel\Attribute\Cache;
use Symfony\Component\Routing\Attribute\Route;

// A page behind a path rule (`access_control`): its events go to its URL, so the rule applies.
#[Component]
#[Route('/private/counter')]
final class PrivateCounter
{
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render()
    {
        return <button onClick={{ increment }}>{{ count }}</button>;
    }
}

// A controller attribute of a page (as `#[IsGranted]`) applies to the page and to its events.
#[Component]
#[Deny]
#[Route('/denied')]
final class DeniedPage
{
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render()
    {
        return <button onClick={{ increment }}>{{ count }}</button>;
    }
}

// A Symfony controller attribute on a function page.
#[Cache(maxage: 60, public: true)]
#[Route('/cached')]
function CachedPage() {
    return <p id="cached">Cached</p>;
}
