<?phpm

namespace App\Pages;

use App\Components\Document;
use Mamu\Attribute\{Page, Path, State};
use Mamu\Tests\Fixtures\Scientist;

// A class page: the {id} route value goes to the #[Path] property.
#[Page('/items/{id}')]
final class ItemPage extends Document
{
    #[Path] public int $id;
    public string $label = 'Item';
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render()
    {
        return <button id="item" onClick={{ increment }}>{{ label }} {{ id }}: {{ count }}</button>;
    }
}

// A route default: the {name} route value (or its default) goes to the #[Path] property.
#[Page('/hello/{name}', defaults: ['name' => 'World'])]
final class Hello extends Document
{
    #[Path] public string $name;

    public function render()
    {
        return <p id="hello">Hello {{ name }}</p>;
    }
}

// An entity page: {id:scientist} finds the scientist by its id, {name:scientist} by its name.
#[Page('/scientists/{id:scientist}')]
#[Page('/scientists/by-name/{name:scientist}')]
final class ScientistPage extends Document
{
    #[Path] public Scientist $scientist;
    #[State] public int $likes = 0;

    public function title(): string
    {
        return $this->scientist->name;
    }

    public function like(): void
    {
        ++$this->likes;
    }

    public function render()
    {
        return <button id="scientist" onClick={{ like }}>{{ scientist.name }}: {{ likes }}</button>;
    }
}

// A nullable entity property: {scientist} finds the scientist by its id, or gives null.
#[Page('/maybe/{scientist}')]
final class MaybeScientist extends Document
{
    #[Path] public ?Scientist $scientist = null;

    public function render()
    {
        return <p id="maybe">{{ scientist ? scientist.name : 'Nobody' }}</p>;
    }
}
