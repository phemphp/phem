<?phpm

namespace App\Pages;

use App\Components\Document;
use Mamu\Attribute\Page;
use Mamu\Tests\Fixtures\{Rows, Scientist};

// One component with a handler for each row: a closure that captures the row.
#[Page('/rows')]
final class RowsPage extends Document
{
    public function remove(Scientist $scientist): void
    {
        Rows::remove($scientist->id);
    }

    public function render()
    {
        $items = [];
        foreach (Rows::$scientists as $scientist) {
            $remove = fn () => $this->remove($scientist);
            $items[] = <li key={{ scientist.id }}>{{ scientist.name }} <button onClick={{ remove }}>Remove</button></li>;
        }

        return <ul id="rows">{{ items }}</ul>;
    }
}
