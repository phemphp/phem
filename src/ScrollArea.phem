<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\Component;
use Phem\{Html, Node};

/**
 * Custom scrollbars over a native scroll container: Base UI ScrollArea.Root, on the
 * `phem-scroll-area` controller. The scrollbars show while the pointer is over the area, or while
 * the user scrolls.
 */
#[Component]
function ScrollArea(int|array $overflowEdgeThreshold = 0, ?Html $children = null, mixed ...$rest): Node
{
    $threshold = is_array($overflowEdgeThreshold) ? json_encode($overflowEdgeThreshold) : ($overflowEdgeThreshold ?: null);

    return (
        <div
            data-controller="phem-scroll-area"
            data-phem-scroll-area-overflow-edge-threshold-value={{ threshold }}
            className={{ classes('h-[8.5rem] w-96 max-w-[calc(100vw-8rem)] bg-white dark:bg-neutral-950') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/** The element that scrolls. */
#[Component]
function ScrollAreaViewport(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-scroll-area-target="viewport"
            className={{ classes('h-full border border-neutral-950 dark:border-white focus-visible:outline-2 focus-visible:-outline-offset-1 focus-visible:outline-neutral-950 dark:focus-visible:outline-white') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

#[Component]
function ScrollAreaContent(?Html $children = null, mixed ...$rest): Node
{
    return <div data-phem-scroll-area-target="content" className={{ classes('flex flex-col gap-4 py-2 pr-5 pl-3 text-sm leading-[1.375rem] text-neutral-950 dark:text-white') }} {{ ...rest }}>{{ children }}</div>;
}

/** A scrollbar on one axis. It gets `hidden` when its axis has no overflow. */
#[Component]
function ScrollAreaScrollbar(Orientation $orientation = Orientation::Vertical, ?Html $children = null, mixed ...$rest): Node
{
    $axis = Orientation::Vertical === $orientation ? 'w-4 justify-center' : 'h-4 items-center';

    return (
        <div
            data-phem-scroll-area-target="scrollbar"
            data-orientation={{ orientation.value }}
            className={{ classes('m-px flex bg-black/12 dark:bg-white/12 opacity-0 transition-opacity pointer-events-none data-hovering:opacity-100 data-hovering:pointer-events-auto data-scrolling:opacity-100 data-scrolling:duration-0 data-scrolling:pointer-events-auto [&[hidden]]:hidden', axis) }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

#[Component]
function ScrollAreaThumb(mixed ...$rest): Node
{
    return <div data-phem-scroll-area-target="thumb" className={{ classes('w-full bg-neutral-950 dark:bg-white data-[orientation=horizontal]:h-full data-[orientation=horizontal]:w-auto') }} {{ ...rest }} />;
}

/** The square between the two scrollbars. */
#[Component]
function ScrollAreaCorner(mixed ...$rest): Node
{
    return <div data-phem-scroll-area-target="corner" className={{ classes('[&[hidden]]:hidden') }} {{ ...rest }} />;
}
