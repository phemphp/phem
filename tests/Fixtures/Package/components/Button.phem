<?phem

namespace Acme\Kit;

use Phem\Attribute\Component;
use Phem\Node;

// The variants of the Button: each case gives its classes.
enum Variant: string
{
    case Primary = 'primary';
    case Outline = 'outline';

    public function classes(): string
    {
        return match ($this) {
            self::Primary => 'bg-blue-500 text-white',
            self::Outline => 'border border-blue-500 text-blue-500',
        };
    }
}

// A component of the package.
#[Component]
function Button(string $label, Variant $variant = Variant::Primary, mixed ...$rest): Node
{
    return <button className={{ classes('kit px-4 py-2', variant.classes()) }} {{ ...rest }}>{{ label }}</button>;
}
