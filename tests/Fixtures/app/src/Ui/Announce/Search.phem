<?phem

namespace App\Ui\Announce;

use Phem\Attribute\{Component, Prop, State};
use Phem\Node;

// A grid with no #[State]: mount() loads the products on each render. phem:announce tells a
// screen reader the new count after an event of the user, with no handler in the grid.
#[Component]
final class ProductGrid
{
    #[Prop] public string $query = '';

    /** @var list<string> */
    public array $products = [];

    public function mount(): void
    {
        $all = ['Apple', 'Apricot', 'Banana', 'Cherry'];
        $this->products = array_values(array_filter($all, fn (string $name): bool => str_starts_with(strtolower($name), strtolower($this->query))));
    }

    public function render(): Node
    {
        return (
            <section>
                <p id="count" phem:announce>{{ products|length }} results</p>
                <ul>
                    {% for product in products %}
                        <li key={{ product }}>{{ product }}</li>
                    {% endfor %}
                </ul>
            </section>
        );
    }
}

#[Component]
final class Search
{
    #[State] public string $query = '';
    #[State] public int $polls = 0;

    public function apples(): void
    {
        $this->query = 'ap';
    }

    public function bananas(): void
    {
        $this->query = 'b';
    }

    public function star(): void
    {
    }

    public function refresh(): void
    {
        ++$this->polls;
        $this->query = '';
    }

    public function render(): Node
    {
        return (
            <div>
                <button id="apples" onClick={{ apples }}>Apples</button>
                <button id="bananas" onClick={{ bananas }}>Bananas</button>
                <button id="star" onClick={{ star }}>Star</button>
                <p id="status" onPoll={{ refresh }} phem:poll={{ 1000 }}>Polls: {{ polls }}</p>
                <ProductGrid query={{ query }} />
            </div>
        );
    }
}
