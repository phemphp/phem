<?phem

namespace App\Ui\Async;

use Phem\Async\Promise;
use Phem\Attribute\{Async, Component, Page, State};
use Phem\Node;
use Phem\RedirectTo;

use function App\Ui\About\AboutPage;
use function App\Ui\Common\Document;

// A function page that redirects in the worker: the work of its #[Async] handler does not run.
final class AsyncRedirectSwitch
{
    public static bool $on = false;
    public static bool $ran = false;
}

#[Component]
final class AsyncStartButton
{
    #[State] public int $clicks = 0;

    #[Async]
    public function start(): Promise
    {
        ++$this->clicks;

        return new Promise(function (): void {
            AsyncRedirectSwitch::$ran = true;
        });
    }

    public function render(): Node
    {
        return <button id="start" type="button" onClick={{ start }}>Start {{ clicks }}</button>;
    }
}

#[Page('/async-redirect')]
function AsyncRedirectPage(): RedirectTo|Node
{
    if (AsyncRedirectSwitch::$on) {
        return new RedirectTo(AboutPage(...));
    }

    return (
        <Document>
            <AsyncStartButton />
        </Document>
    );
}
