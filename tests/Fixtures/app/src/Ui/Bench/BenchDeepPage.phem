<?phem

namespace App\Ui\Bench;

use Phem\Attribute\{Component, Page, Prop, State};
use Phem\Node;
use Phem\Suspense;

use function App\Ui\Layout\Document;

// The pages of the benchmark (bench/run.php).

/** The leaf of a deep page: its event renders the path from the page to it. */
#[Component]
final class BenchLeaf
{
    #[State] public int $n = 0;

    public function inc(): void
    {
        ++$this->n;
    }

    public function render(): Node
    {
        return <button id="leaf" onClick={{ inc }}>Leaf {{ n }}</button>;
    }
}

/** A level of a deep page: a class component with a prop, as most real levels are. */
#[Component]
final class BenchLevel
{
    #[Prop] public int $depth = 0;

    public function render(): Node
    {
        if (0 === $this->depth) {
            return <div class="level"><BenchLeaf /></div>;
        }

        $next = $this->depth - 1;

        return <div class="level"><BenchLevel depth={{ next }} /></div>;
    }
}

#[Page('/bench/deep')]
final class BenchDeepPage
{
    public function render(): Node
    {
        return (
            <Document>
                <BenchLevel depth={{ 10 }} />
            </Document>
        );
    }
}

/** The content of a boundary: a slow mount() in a real application. */
#[Component]
final class BenchWidget
{
    #[Prop] public string $name = '';
    #[State] public int $rows = 0;

    public function mount(): void
    {
        $this->rows = 3;
    }

    public function render(): Node
    {
        return <p class="widget">{{ name }}: {{ rows }} rows</p>;
    }
}

/** The 4 boundaries of a dashboard. */
#[Component]
final class BenchWidgets
{
    #[Prop] public bool $lazy = false;

    public function render(): Node
    {
        return (
            <div class="widgets">
                <Suspense lazy={{ lazy }}>
                    <Suspense:fallback><p>Loading the sales…</p></Suspense:fallback>
                    <BenchWidget name="Sales" />
                </Suspense>
                <Suspense lazy={{ lazy }}>
                    <Suspense:fallback><p>Loading the orders…</p></Suspense:fallback>
                    <BenchWidget name="Orders" />
                </Suspense>
                <Suspense lazy={{ lazy }}>
                    <Suspense:fallback><p>Loading the users…</p></Suspense:fallback>
                    <BenchWidget name="Users" />
                </Suspense>
                <Suspense lazy={{ lazy }}>
                    <Suspense:fallback><p>Loading the stock…</p></Suspense:fallback>
                    <BenchWidget name="Stock" />
                </Suspense>
            </div>
        );
    }
}

/** The browser loads the boundaries with an event: they are lazy. */
#[Page('/bench/dashboard')]
final class BenchDashboardPage
{
    public function render(): Node
    {
        return (
            <Document>
                <BenchWidgets lazy={{ true }} />
            </Document>
        );
    }
}

/** The response of the page streams the boundaries (see Phem\Rendering\SuspenseStream). */
#[Page('/bench/stream')]
final class BenchStreamPage
{
    public function render(): Node
    {
        return (
            <Document>
                <BenchWidgets />
            </Document>
        );
    }
}
