<?phem

namespace App\Ui\Dynamic;

use Phem\Attribute\{Component, Page, Prop, State};
use Phem\{Dynamic, Html, Node};

use function App\Ui\Layout\Document;

// A button that renders as a link: the tag is a prop.
#[Component]
function PolyButton(string $tag = 'button', ?Html $children = null, mixed ...$rest): Node {
    return <Dynamic tag={{ tag }} className={{ classes('btn') }} {{ ...rest }}>{{ children }}</Dynamic>;
}

// A void element: no end tag, and no content.
#[Component]
function PolyMedia(string $tag, ?Html $children = null): Node {
    return <Dynamic tag={{ tag }} src="/a.png">{{ children }}</Dynamic>;
}

// A class component: its id goes on the dynamic element.
#[Component]
final class PolyCounter
{
    #[Prop] public string $tag = 'section';
    #[Prop] public string $name = 'counter';
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render(): Node
    {
        return <Dynamic tag={{ tag }} id={{ name }} onClick={{ increment }}>Count {{ count }}</Dynamic>;
    }
}

#[Page('/dynamic')]
final class DynamicPage
{
    public function render(): Node
    {
        return (
            <Document>
                <main>
                    <PolyButton type="button">Save</PolyButton>
                    <PolyButton tag="a" href="/docs" className="wide">Docs</PolyButton>
                    <PolyMedia tag="img" />
                    <PolyCounter tag="article" />
                    <PolyButton tag="section" id="wrap"><Dynamic tag="div" id="inner"><PolyCounter tag="span" name="nested" /></Dynamic></PolyButton>
                    <ul>{% for i in [1, 2] %}<Dynamic tag="li" key={{ i }}>{{ i }}</Dynamic>{% endfor %}</ul>
                </main>
            </Document>
        );
    }
}
