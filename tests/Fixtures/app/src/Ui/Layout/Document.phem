<?phem

namespace App\Ui\Layout;

use Phem\Attribute\Component;
use Phem\{Html, Node, Root};

// The document of the fixture pages: a page composes it and gives the title with its `title` prop.
#[Component]
function Document(?string $title = null, ?Html $children = null): Node
{
    return (
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <title>{{ title ?? 'Fixture' }}</title>
            </head>
            <body className="fixture"><Root>{{ children }}</Root></body>
        </html>
    );
}
