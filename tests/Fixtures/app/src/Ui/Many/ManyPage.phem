<?phem

namespace App\Ui\Many;

use Phem\Attribute\{Component, Page, Prop, State};
use Phem\Html;
use Phem\Node;
use Phem\Tests\Fixtures\Many;

use function App\Ui\Layout\Document;

// Pages with many components: the render time grows linearly with the number of components
// (tests/Runtime/ManyComponentsTest.php). The number of rows is in the state, so an event renders
// the same rows.

/** A row with a handler and much static markup: the page has a large HTML. */
#[Component]
final class ManyRow
{
    #[Prop] public int $index = 0;
    #[State] public int $clicks = 0;

    public function click(): void
    {
        ++$this->clicks;
    }

    public function render(): Node
    {
        return (
            <li>
                <button onClick={{ click }}>Row {{ index }}: {{ clicks }} clicks</button>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
                <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
                <p>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
            </li>
        );
    }
}

#[Page('/many')]
final class ManyPage
{
    #[State] public int $rows = 0;
    #[State] public int $bumps = 0;

    public function mount(): void
    {
        $this->rows = Many::$rows;
    }

    public function bump(): void
    {
        ++$this->bumps;
    }

    /** Changes nothing: the page renders again with the same HTML. */
    public function nothing(): void
    {
    }

    public function render(): Node
    {
        $items = [];
        for ($i = 0; $i < $this->rows; ++$i) {
            $items[] = <ManyRow key={{ i }} index={{ i }} />;
        }

        return (
            <Document>
                <button id="bump" onClick={{ bump }}>Bumps {{ bumps }}</button>
                <button id="nothing" onClick={{ nothing }}>Nothing</button>
                <ul id="rows">{{ items }}</ul>
            </Document>
        );
    }
}

/** A row with bound fields: each `phem:bind` finds the fiber of its component. */
#[Component]
final class ManyField
{
    #[Prop] public int $index = 0;
    #[State] public string $name = '';
    #[State] public string $email = '';
    #[State] public string $city = '';
    #[State] public bool $done = false;

    public function render(): Node
    {
        return (
            <li>
                <input name="name" phem:bind={{ name }} />
                <input name="email" phem:bind={{ email }} />
                <input name="city" phem:bind={{ city }} />
                <input type="checkbox" phem:bind={{ done }} />
                <span>Row {{ index }}: {{ name }}</span>
            </li>
        );
    }
}

/** A component with state and a slot: a click renders it alone, with the slot of its parent. */
#[Component]
final class ManyPanel
{
    #[Prop] public ?Html $children = null;
    #[State] public int $opens = 0;

    public function open(): void
    {
        ++$this->opens;
    }

    public function render(): Node
    {
        return (
            <section>
                <button id="open" onClick={{ open }}>Opens {{ opens }}</button>
                {{ children }}
            </section>
        );
    }
}

#[Page('/many-fields')]
final class ManyFieldsPage
{
    #[State] public int $rows = 0;
    #[State] public string $title = '';

    public function mount(): void
    {
        $this->rows = Many::$rows;
    }

    public function render(): Node
    {
        $items = [];
        for ($i = 0; $i < $this->rows; ++$i) {
            $items[] = <ManyField key={{ i }} index={{ i }} />;
        }

        return (
            <Document>
                <ManyPanel>
                    <input name="title" phem:bind={{ title }} />
                </ManyPanel>
                <ul id="fields">{{ items }}</ul>
            </Document>
        );
    }
}

/** A level of a deep page: its HTML has all the levels under it. */
#[Component]
final class ManyLevel
{
    #[Prop] public int $depth = 0;

    public function render(): Node
    {
        if (0 === $this->depth) {
            return <p class="bottom">Bottom</p>;
        }

        $next = $this->depth - 1;

        return <div class="level"><ManyLevel depth={{ next }} /></div>;
    }
}

/** A deep page: the render time grows linearly with its number of levels too. */
#[Page('/many-levels')]
final class ManyLevelsPage
{
    public function render(): Node
    {
        $depth = Many::$levels;

        return (
            <Document>
                <ManyLevel depth={{ depth }} />
            </Document>
        );
    }
}

/** A large #[State] list: an event changes one item of it. */
#[Page('/many-items')]
final class ManyItemsPage
{
    #[State] public array $items = [];

    public function mount(): void
    {
        for ($i = 0; $i < Many::$rows; ++$i) {
            $this->items[] = ['id' => $i, 'title' => 'Item '.$i, 'done' => false];
        }
    }

    public function toggle(): void
    {
        $this->items[1]['done'] = !$this->items[1]['done'];
    }

    public function render(): Node
    {
        $done = $this->items[1]['done'] ? 'yes' : 'no';

        return (
            <Document>
                <button id="toggle" onClick={{ toggle }}>Done: {{ done }}</button>
            </Document>
        );
    }
}
