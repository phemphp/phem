<?phem

namespace App\Ui\Notify;

use Phem\Announcements;
use Phem\Attribute\{Component, Page, State};
use Phem\BrowserEventDispatcher;
use Phem\Event;
use Phem\Node;
use Phem\Toasts;
use Phem\ToastType;
use Phem\Tests\Fixtures\Greeter;
use Symfony\Component\HttpFoundation\RedirectResponse;

use function App\Ui\Common\Document;

// Handlers that send browser events (see Phem\BrowserEventDispatcher).
#[Component]
final class Notifier
{
    #[State] public int $count = 0;

    public function __construct(
        private readonly BrowserEventDispatcher $dispatcher,
        private readonly Greeter $greeter,
        private readonly Toasts $toasts,
        private readonly Announcements $announcements,
    ) {
    }

    public function save(Event $e): void
    {
        ++$this->count;
        $e->dispatcher->dispatch('toast', ['message' => 'Saved '.$this->count]);
        $e->dispatcher->dispatch('saved', $this->count);
    }

    // No Event parameter: the injected dispatcher, and a service that has it too.
    public function greet(): void
    {
        ++$this->count;
        $this->dispatcher->dispatch('toast', ['message' => 'Greeted '.$this->count]);
        $this->greeter->greet('Hello');
    }

    // Messages for screen readers, with no toast: of the event and of the injected service. The
    // browser does not announce an empty message.
    public function announce(Event $e): void
    {
        $e->announce('3 results');
        $this->announcements->announce('Saved');
        $e->dispatcher->dispatch('announce', ['message' => ' ']);
    }

    public function toast(Event $e): void
    {
        $e->toast('Saved', ToastType::Success);
    }

    // No Event parameter: the injected toasts service.
    public function remind(): void
    {
        $this->toasts->warning('Check the stock', 0);
    }

    // Toast details that the phem-toast controller reads in its own way.
    public function raw(Event $e): void
    {
        $e->dispatcher->dispatch('toast', 'Plain');
        $e->dispatcher->dispatch('toast', ['message' => 'Odd', 'type' => 'danger']);
        $e->dispatcher->dispatch('toast', ['message' => ['a', 'b']]);
        $e->dispatcher->dispatch('toast');
    }

    public function quiet(): void
    {
        ++$this->count;
    }

    public function leave(Event $e): RedirectResponse
    {
        $e->dispatcher->dispatch('toast', ['message' => 'Bye']);

        return new RedirectResponse('/about');
    }

    public function clicked(Event $e): void
    {
        $e->dispatcher->dispatch('clicked');
    }

    public function submitted(Event $e): void
    {
        $e->dispatcher->dispatch('submitted', $e->form);
    }

    public function render(): Node
    {
        return (
            <div>
                <button id="save" onClick={{ save }}>Save {{ count }}</button>
                <button id="greet" onClick={{ greet }}>Greet</button>
                <button id="announce" onClick={{ announce }}>Announce</button>
                <button id="toast" onClick={{ toast }}>Toast</button>
                <button id="remind" onClick={{ remind }}>Remind</button>
                <button id="raw" onClick={{ raw }}>Raw</button>
                <button id="quiet" onClick={{ quiet }}>Quiet</button>
                <button id="leave" onClick={{ leave }}>Leave</button>
                <form onSubmit={{ submitted }}>
                    <button type="submit" id="send" name="action" value="send" onClick={{ clicked }}>Send</button>
                </form>
            </div>
        );
    }
}

#[Page('/notify')]
final class NotifyPage
{
    public function render(): Node
    {
        return (
            <Document>
                <Notifier />
            </Document>
        );
    }
}
