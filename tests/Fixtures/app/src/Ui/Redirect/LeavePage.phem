<?phem

namespace App\Ui\Redirect;

use Phem\Attribute\{Page, State};
use Phem\Node;
use Phem\RedirectTo;
use Symfony\Component\HttpFoundation\Cookie;
use Symfony\Component\HttpFoundation\RedirectResponse;

use function App\Ui\Layout\Document;
use App\Ui\Path\ItemPage;
use function App\Ui\About\AboutPage;

// A handler that returns a RedirectResponse (for example to another site): the browser goes to its URL.
#[Page('/leave')]
final class LeavePage
{
    #[State] public int $count = 0;

    public function leave(): RedirectResponse
    {
        ++$this->count;

        $response = new RedirectResponse('/about');
        $response->headers->setCookie(Cookie::create('left', '1'));

        return $response;
    }

    public function render(): Node
    {
        return (
            <Document>
                <button id="leave" onClick={{ leave }}>Leave {{ count }}</button>
            </Document>
        );
    }
}

// Handlers that return a Phem RedirectTo to a page.
#[Page('/go')]
final class GoPage
{
    public function about(): RedirectTo
    {
        return new RedirectTo(AboutPage(...));
    }

    public function item(): RedirectTo
    {
        return new RedirectTo(ItemPage::class, ['id' => 5, 'tab' => 'notes']);
    }

    public function render(): Node
    {
        return (
            <Document>
                <button id="about" onClick={{ about }}>About</button>
                <button id="item" onClick={{ item }}>Item</button>
            </Document>
        );
    }
}
