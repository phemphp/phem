<?phem

namespace App\Ui\Replaced;

use Acme\Ui\Alert;
use Acme\Ui\Field;
use Acme\Ui\Toggle;
use Phem\Attribute\{Component, Page, State};
use Phem\Node;

use function Acme\Ui\Notice;
use function App\Ui\Common\Document;

// `phem:bind` on a tag of a package field: the replacement (src/Ui/Common/Field.phem) gets the
// Bound and gives it to the original.
#[Component]
final class Newsletter
{
    #[State] public string $email = '';
    #[State] public int $saves = 0;

    public function save(): void
    {
        ++$this->saves;
    }

    public function render(): Node
    {
        return (
            <form id="newsletter" onSubmit={{ save }}>
                <Field phem:bind={{ email }} name="email" />
                <p id="newsletter-email">{{ email }}, saves {{ saves }}</p>
            </form>
        );
    }
}

// The tags of a package component render its replacement (src/Ui/Common/Alert.phem), in the app
// and in the package (Notice). The class replacement of Toggle has state, as the original.
#[Page('/replaced')]
function ReplacedPage(): Node
{
    return (
        <Document>
            <div id="replaced">
                <Alert>Saved</Alert>
                <Notice>Read this</Notice>
                <Toggle label="Lamp" />
                <Newsletter />
            </div>
        </Document>
    );
}
