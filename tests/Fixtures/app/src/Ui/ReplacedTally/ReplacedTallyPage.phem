<?phem

namespace App\Ui\ReplacedTally;

use Acme\Ui\Tally;
use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\Layout\Document;

// Two instances of a replaced component with #[Broadcast], with two keys.
#[Page('/replaced/tally')]
function ReplacedTallyPage(): Node
{
    return (
        <Document>
            <Tally room="lobby" />
            <Tally room="hall" />
        </Document>
    );
}
