<?phem

namespace App\Ui\Rest;

use Phem\Attribute\{Component, Page, Prop, State};
use Phem\Node;

use function App\Ui\Layout\Document;

// A template component: the extra props go to `$rest`.
#[Component]
function RestButton(int $count, mixed ...$rest): Node {
    return <button type="button" {{ ...rest }}>Clicked {{ count }} times</button>;
}

// A function component (PHP code before the markup).
#[Component]
function LoudButton(string $label, mixed ...$rest): Node {
    $text = strtoupper($label);
    return <button className="loud" {{ ...rest }}>{{ text }}</button>;
}

// Forwards its extra props to another component.
#[Component]
function Forward(mixed ...$rest): Node {
    return <RestButton count={{ 7 }} {{ ...rest }} />;
}

// A class component: the extra props go to the rest prop.
#[Component]
final class RestLink
{
    #[Prop] public string $label = '';
    #[Prop(rest: true)] public array $attrs = [];

    public function render(): Node
    {
        return <a className="link" {{ ...attrs }}>{{ label }}</a>;
    }
}

// Its default classes merge with the classes of the caller.
#[Component]
function MergedButton(mixed ...$rest): Node {
    return <button className={{ classes('btn btn-md') }} {{ ...rest }}>Merged</button>;
}

// A wrapper keeps its classes: the props of the tag merge too.
#[Component]
function PrimaryButton(mixed ...$rest): Node {
    return <MergedButton className={{ classes('btn-primary') }} {{ ...rest }} />;
}

#[Page('/rest')]
final class RestPage
{
    #[State] public int $count = 0;

    public function increment(): void
    {
        ++$this->count;
    }

    public function render(): Node
    {
        return (
            <Document>
                <main>
                    <RestButton count={{ count }} onClick={{ increment }} id="a" type="submit" data-role="counter" aria-label="Count" disabled={{ false }} />
                    <LoudButton label="hi" className="override" onDoubleClick={{ increment }} />
                    <Forward id="forwarded" />
                    <RestButton count={{ count }} />
                    <RestLink label="Home {{ count }}" href="/" className="primary" onClick={{ increment }} />
                    <RestLink label="Plain" />
                    <MergedButton className="btn wide" />
                    <PrimaryButton className={{ ['big', {'zero': count == 0, 'more': count > 0}] }} />
                    <p className="note note-{{ count }}">Note</p>
                </main>
            </Document>
        );
    }
}
