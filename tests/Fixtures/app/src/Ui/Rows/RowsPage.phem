<?phem

namespace App\Ui\Rows;

use Phem\Attribute\Page;
use Phem\Node;
use Phem\Tests\Fixtures\{Rows, Scientist};

use function App\Ui\Common\Document;

// One component with a handler for each row: a closure that captures the row.
#[Page('/rows')]
final class RowsPage
{
    public function remove(Scientist $scientist): void
    {
        Rows::remove($scientist->id);
    }

    /** @var array<int, Scientist> */
    private array $rows = [];

    // No #[State]: mount() runs each time that the page renders. render() stays pure.
    public function mount(): void
    {
        $this->rows = Rows::$scientists;
    }

    public function render(): Node
    {
        $items = [];
        foreach ($this->rows as $scientist) {
            $remove = fn () => $this->remove($scientist);
            $items[] = <li key={{ scientist.id }}>{{ scientist.name }} <button onClick={{ remove }}>Remove</button></li>;
        }

        return (
            <Document>
                <ul id="rows">{{ items }}</ul>
            </Document>
        );
    }
}
