<?phem

namespace App\Ui\Signup;

use Phem\Attribute\{Component, Page, Prop, State};
use Phem\Event;
use Phem\Node;
use Symfony\Component\HttpFoundation\RedirectResponse;

use function App\Ui\Common\Document;

// The fields and the events of the test helpers (see Phem\Test\ComponentTester).
#[Component]
final class Signup
{
    #[Prop] public string $title = 'Sign up';
    #[State] public string $name = '';
    #[State] public bool $agree = false;
    #[State] public string $plan = 'free';
    #[State] public string $lastKey = '';
    #[State] public bool $focused = false;
    #[State] public array $submitted = [];

    public function rename(Event $e): void
    {
        $this->name = (string) $e->value;
    }

    public function toggleAgree(Event $e): void
    {
        $this->agree = (bool) $e->checked;
    }

    public function choosePlan(Event $e): void
    {
        $this->plan = (string) $e->value;
    }

    public function press(Event $e): void
    {
        $this->lastKey = (string) $e->key;
    }

    public function enter(): void
    {
        $this->focused = true;
    }

    public function save(Event $e): ?RedirectResponse
    {
        if ('leave' === ($e->form['action'] ?? null)) {
            return new RedirectResponse('/about');
        }
        $this->submitted = $e->form;

        return null;
    }

    public function render(): Node
    {
        return (
            <div class="signup">
                <h2>{{ title }}</h2>
                <form id="signup" onSubmit={{ save }}>
                    <input name="name" value={{ name }} onChange={{ rename }} onKeyDown={{ press }} onFocus={{ enter }} />
                    <input type="checkbox" name="agree" checked={{ agree }} onChange={{ toggleAgree }} />
                    <select name="plan" onChange={{ choosePlan }}>
                        <option value="free" selected={{ plan == 'free' }}>Free</option>
                        <option value="pro" selected={{ plan == 'pro' }}>Pro</option>
                    </select>
                    <input type="radio" name="size" value="s" />
                    <input type="radio" name="size" value="l" checked />
                    <input type="checkbox" name="tags[]" value="a" />
                    <input type="checkbox" name="tags[]" value="b" />
                    <textarea name="bio"></textarea>
                    <input name="ignored" disabled />
                    <button type="submit" name="action" value="save">Save</button>
                    <button type="submit" name="action" value="leave">Leave</button>
                    <button type="button" id="off" disabled onClick={{ enter }}>Off</button>
                    <button type="button" id="inert">Inert</button>
                </form>
                <p id="hello">Hello {{ name }}</p>
                <p id="status">{{ agree ? 'agreed' : 'not agreed' }}, {{ plan }}, key {{ lastKey }}, {{ focused ? 'focused' : 'blurred' }}</p>
                <pre id="submitted">{{ submitted|json_encode }}</pre>
            </div>
        );
    }
}

#[Page('/signup')]
final class SignupPage
{
    public function render(): Node
    {
        return (
            <Document>
                <Document:title>Signup</Document:title>
                <Signup title="Join" />
            </Document>
        );
    }
}
