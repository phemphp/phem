<?phem

namespace App\Ui\Skip;

use Phem\Attribute\{Component, Page, State};
use Phem\Event;
use Phem\Node;
use Phem\Tests\Fixtures\Renders;

use function App\Ui\Common\Document;

// The tests of the render of only the components that can change (see Phem\Rendering\EventRenderer).

// A pure component with a prop: it counts its renders.
#[Component]
function Probe(int $n): Node
{
    Renders::count('Probe');

    return <li>Probe {{ n }}</li>;
}

#[Component]
final class Clicker
{
    #[State] public int $clicks = 0;

    public function click(): void
    {
        ++$this->clicks;
    }

    public function render(): Node
    {
        Renders::count('Clicker');

        return <button id="clicker" onClick={{ click }}>Clicks {{ clicks }}</button>;
    }
}

// A plain property that the handler sets, as a form with its errors: it is not state.
#[Component]
final class Note
{
    private string $note = 'empty';

    public function write(): void
    {
        $this->note = 'written';
    }

    public function render(): Node
    {
        return <button id="note" onClick={{ write }}>Note {{ note }}</button>;
    }
}

// No #[State] and a mount(): it renders each time that its parent renders.
#[Component]
final class Mounted
{
    private int $value = 0;

    public function mount(): void
    {
        $this->value = Renders::$external;
    }

    public function render(): Node
    {
        return <span id="mounted">Mounted {{ value }}</span>;
    }
}

// No #[State], a mount(), and a handler that changes the data that mount() reads: mount() runs
// again in the render after the handler.
#[Component]
final class Reloader
{
    private int $value = 0;

    public function mount(): void
    {
        $this->value = Renders::$external;
    }

    public function change(): void
    {
        ++Renders::$external;
    }

    public function render(): Node
    {
        return <button id="reloader" onClick={{ change }}>Reloader {{ value }}</button>;
    }
}

// Not pure: its render() reads data outside its props and state (phemc reports W008).
#[Component]
function Impure(): Node
{
    $value = Renders::$external;

    return <span id="impure">Impure {{ value }}</span>;
}

#[Page('/skip')]
final class SkipPage
{
    #[State] public int $n = 0;

    public function bump(): void
    {
        ++$this->n;
    }

    public function change(): void
    {
        ++Renders::$external;
    }

    public function refresh(Event $e): void
    {
        ++Renders::$external;
        $e->refresh();
    }

    public function render(): Node
    {
        return (
            <Document>
                <button id="bump" onClick={{ bump }}>Bump {{ n }}</button>
                <button id="change" onClick={{ change }}>Change</button>
                <button id="refresh" onClick={{ refresh }}>Refresh</button>
                <ul id="probes">
                    {% for i in 1..20 %}
                        <Probe key={{ i }} n={{ i }} />
                    {% endfor %}
                </ul>
                <Probe key="n" n={{ n }} />
                <Clicker />
                <Note />
                <Mounted />
                <Reloader />
                <Impure />
            </Document>
        );
    }
}
