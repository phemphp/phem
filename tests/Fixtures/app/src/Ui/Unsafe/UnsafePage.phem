<?phem

namespace App\Ui\Unsafe;

use Phem\Attribute\{Component, Page};
use Phem\Event;
use Phem\Node;
use Symfony\Component\HttpFoundation\RedirectResponse;

use App\Ui\Common\Counter;

use function App\Ui\Common\{Badge, Card, Tag};
use function App\Ui\Layout\Document;

// A function component that returns a string: it is text, as in React.
#[Component]
function PlainText(string $value): string {
    return $value;
}

// Data in the output: Phem escapes it, and a spread of data adds no script.
#[Page('/unsafe')]
final class UnsafePage
{
    // Redirects to a URL from the browser (for example a `?next=` value).
    public function go(Event $e): RedirectResponse
    {
        return new RedirectResponse((string) $e->value);
    }

    public function render(): Node
    {
        $name = '<b>Ada</b>';
        $data = ['x onfocus=alert(1) autofocus' => 'y', 'onclick' => 'alert(2)', 'title' => 'ok'];
        $xss = '"><script>alert(3)</script>';
        // A URL from data (for example the website of a user profile).
        $website = 'javascript:alert(4)';
        $link = ['href' => ' JavaScript:alert(5)'];
        $action = "java\tscript:alert(6)";

        return (
            <Document>
                <main>
                    <PlainText value={{ name }} />
                    <a id="spread" {{ ...data }} onclick="track()">link</a>
                    <a id="website" href={{ website }}>website</a>
                    <a id="quoted" href="{{ website }}">website</a>
                    <a id="link" {{ ...link }}>link</a>
                    <form><button id="action" formaction={{ action }}>Send</button></form>
                    <button id="go" onClick={{ go }}>Go</button>
                    <div id="children">
                        <Card title={{ xss }}>
                            <p>{{ xss }}</p>
                            <Card.footer><Tag>{{ xss }}</Tag></Card.footer>
                        </Card>
                        <Badge label="it's \ #{xss} {{ xss }}" tone={{ xss }} key={{ xss }} />
                        <Counter label={{ xss }} key={{ xss }}>{{ xss }}</Counter>
                    </div>
                </main>
            </Document>
        );
    }
}
