<?phem

namespace App\Ui\Upload;

use Phem\Attribute\{Component, Page, State};
use Phem\Event;
use Phem\Node;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\File\UploadedFile;

use function App\Ui\Common\Document;

// The files of a form (see Phem\Event::$files), and the request of the event.
#[Component]
final class Uploader
{
    #[State] public array $uploaded = [];
    #[State] public string $title = '';
    #[State] public string $photo = '';
    #[State] public bool $moved = false;
    #[State] public int $version = 0;

    public function save(Event $e, Request $request): void
    {
        $this->uploaded = [];
        $files = $e->files;
        array_walk_recursive($files, function (UploadedFile $file): void {
            $this->uploaded[] = $file->getClientOriginalName().' '.$file->getSize().' '.trim((string) file_get_contents($file->getPathname()));
        });
        // The copy of the request has the fields and the files of the form, as a normal submit.
        $this->title = (string) $request->request->get('title');
        $this->photo = (string) $request->files->get('photo')?->getClientOriginalName();
        $photo = $e->files['photo'] ?? null;
        if ('move' === ($e->form['action'] ?? null) && $photo instanceof UploadedFile) {
            $photo->move(sys_get_temp_dir(), uniqid('phem-moved-'));
            $this->moved = true;
        }

        // The handler took the files: the browser empties the file inputs. The same with a
        // render of the full page.
        if (\in_array($e->form['action'] ?? null, ['store', 'refresh'], true)) {
            $e->clearFiles();
        }

        if ('refresh' === ($e->form['action'] ?? null)) {
            $e->refresh();
        }

        // A new id: the morph replaces the element of the avatar input, and its files go away.
        if ('version' === ($e->form['action'] ?? null)) {
            ++$this->version;
        }
    }

    public function render(): Node
    {
        return (
            <div>
                <form onSubmit={{ save }}>
                    <input name="title" value="Notes" />
                    <input type="file" name="photo" />
                    <input type="file" name="photos[]" multiple />
                    <input type="file" name="doc[file]" />
                    <input type="file" name="off" disabled />
                    <input type="file" name="avatar" id={{ 'avatar-' ~ version }} />
                    <button type="submit" name="action" value="save">Save</button>
                    <button type="submit" name="action" value="move">Move</button>
                    <button type="submit" name="action" value="store">Store</button>
                    <button type="submit" name="action" value="refresh">Refresh</button>
                    <button type="submit" name="action" value="version">Version</button>
                </form>
                <pre id="uploaded">{{ uploaded|json_encode }}</pre>
                <p id="request">{{ title }} {{ photo }} {{ moved ? 'moved' : '' }}</p>
            </div>
        );
    }
}

// The files of a drop and of a paste: a list in Phem\Event::$files.
#[Component]
final class DropZone
{
    #[State] public array $received = [];

    public function receive(Event $e): void
    {
        $this->received = array_map(static fn (UploadedFile $file): string => $e->type.' '.$file->getClientOriginalName().' '.trim((string) file_get_contents($file->getPathname())), $e->files);

        if ('' !== (string) $e->text) {
            $this->received[] = $e->type.' text '.$e->text;
        }
    }

    public function render(): Node
    {
        return (
            <div>
                <div id="zone" onDrop={{ receive }}>Drop the photos here</div>
                <textarea onPaste={{ receive }}></textarea>
                <pre id="received">{{ received|json_encode }}</pre>
            </div>
        );
    }
}

#[Page('/upload')]
final class UploadPage
{
    public function render(): Node
    {
        return (
            <Document>
                <Uploader />
                <DropZone />
            </Document>
        );
    }
}
