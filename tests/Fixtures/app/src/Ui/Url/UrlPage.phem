<?phem

namespace App\Ui\Url;

use Phem\Attribute\{Component, Page, State, Url};
use Phem\Node;
use Phem\Tests\Fixtures\Size;

use function App\Ui\Common\Document;

// The #[Url] properties: the first render reads them from the query string, and the browser
// writes them into the URL after each event.
#[Component]
final class Catalog
{
    #[State, Url(as: 'q')] public string $query = '';
    #[State, Url(history: true)] public int $page = 1;
    #[State, Url] public bool $stock = false;
    #[State, Url] public array $tags = [];
    #[State, Url] public ?Size $size = null;
    #[State, Url] public float $min = 0.0;
    #[State, Url(except: 'name')] public string $sort;
    #[State, Url] public array $filters = ['status' => 'all', 'open' => false, 'price' => ['min' => 0, 'max' => 100], 'tags' => []];
    #[State] public int $clicks = 0;

    public function mount(): void
    {
        $this->sort = 'name';
    }

    public function next(): void
    {
        ++$this->page;
    }

    public function clear(): void
    {
        $this->query = '';
        $this->page = 1;
        $this->stock = false;
        $this->tags = [];
        $this->size = null;
        $this->min = 0.0;
        $this->filters = ['status' => 'all', 'open' => false, 'price' => ['min' => 0, 'max' => 100], 'tags' => []];
    }

    public function click(): void
    {
        ++$this->clicks;
    }

    public function filter(): void
    {
        $this->filters['status'] = 'new';
        $this->filters['price']['max'] = 50;
        $this->filters['tags'] = ['a', 'b'];
    }

    public function sortBy(): void
    {
        $this->sort = 'name' === $this->sort ? 'date' : 'name';
    }

    public function render(): Node
    {
        return (
            <div>
                <input type="search" name="q" phem:bind={{ query }} phem:live />
                <button id="next" onClick={{ next }}>Next</button>
                <button id="clear" onClick={{ clear }}>Clear</button>
                <button id="click" onClick={{ click }}>Click</button>
                <button id="sort" onClick={{ sortBy }}>Sort</button>
                <button id="filter" onClick={{ filter }}>Filter</button>
                <p id="summary">q={{ query }}, page={{ page }}, stock={{ stock ? 'yes' : 'no' }}, tags={{ tags|join('+') }}, size={{ size.value ?? 'none' }}, min={{ min }}, sort={{ sort }}</p>
                <p id="filters">status={{ filters.status }}, open={{ filters.open ? 'yes' : 'no' }}, price={{ filters.price.min }}-{{ filters.price.max }}, tags={{ filters.tags|join('+') }}</p>
            </div>
        );
    }
}

#[Page('/url')]
final class UrlPage
{
    #[State, Url] public string $tab = 'all';

    public function open(): void
    {
        $this->tab = 'new';
    }

    public function render(): Node
    {
        return (
            <Document title="Url">
                <button id="tab" onClick={{ open }}>Tab {{ tab }}</button>
                <Catalog />
            </Document>
        );
    }
}

// Two components with the same query key: the page fails.
#[Page('/url-twice')]
final class UrlTwicePage
{
    public function render(): Node
    {
        return (
            <Document>
                <Catalog />
                <Catalog />
            </Document>
        );
    }
}
