<?phem

namespace App\Ui\Validation;

use Phem\Attribute\{Component, Page, State, Validated};
use Phem\Node;
use Phem\Validation;
use Symfony\Component\Validator\Constraints as Assert;
use Symfony\Component\Validator\Context\ExecutionContextInterface;

use function App\Ui\Layout\Document;

// The live validation of the #[State] properties (see Phem\Validation).
#[Component]
final class Registration
{
    #[State, Assert\NotBlank, Assert\Email]
    public string $email = '';

    #[State, Assert\Length(min: 8)]
    public string $password = '';

    #[State] public string $confirm = '';

    #[State, Assert\Collection(fields: ['city' => new Assert\NotBlank(message: 'Enter a city.')], allowExtraFields: true)]
    public array $address = ['city' => ''];

    #[State, Assert\NotBlank(message: 'Enter a nickname.', groups: ['draft'])]
    public string $nickname = '';

    #[State, Assert\Positive]
    public int $age = 1;

    #[State] public Validation $validation;

    #[State] public string $saved = '';

    #[Assert\Callback]
    public function samePasswords(ExecutionContextInterface $context): void
    {
        if ($this->password !== $this->confirm) {
            $context->buildViolation('The passwords do not match.')->atPath('confirm')->addViolation();
        }
    }

    #[Validated]
    public function save(): void
    {
        $this->saved = $this->email;
        $this->validation = new Validation();
    }

    #[Validated(groups: ['draft'])]
    public function draft(): void
    {
        $this->saved = 'draft of '.$this->nickname;
    }

    public function rename(): void
    {
        $this->saved = 'renamed';
    }

    public function fixEmail(): void
    {
        $this->email = 'ada@example.com';
    }

    public function render(): Node
    {
        $quick = #[Validated] fn () => $this->saved = 'quick';
        $touchCity = fn () => $this->validation = $this->validation->touch('address.city');

        return (
            <form id="registration" onSubmit={{ save }}>
                <input name="email" phem:bind={{ email }} phem:live />
                {% if validation.hasError('email') %}<p id="email-error">{{ validation.error('email') }}</p>{% endif %}
                <FieldError validation={{ validation }} field="email" />
                <input name="password" phem:bind={{ password }} phem:live />
                {% if validation.hasError('password') %}<p id="password-error">{{ validation.error('password') }}</p>{% endif %}
                <input name="confirm" phem:bind={{ confirm }} phem:live />
                {% if validation.hasError('confirm') %}<p id="confirm-error">{{ validation.error('confirm') }}</p>{% endif %}
                <input name="city" phem:bind={{ address.city }} phem:live onBlur={{ touchCity }} />
                {% if validation.hasError('address.city') %}<p id="city-error">{{ validation.error('address.city') }}</p>{% endif %}
                <input name="nickname" phem:bind={{ nickname }} phem:live />
                {% if validation.hasError('nickname') %}<p id="nickname-error">{{ validation.error('nickname') }}</p>{% endif %}
                <input name="age" phem:bind={{ age }} phem:live />
                {% if validation.hasError('age') %}<p id="age-error">{{ validation.error('age') }}</p>{% endif %}
                <button type="submit">Save</button>
                <button type="button" id="draft" onClick={{ draft }}>Draft</button>
                <button type="button" id="rename" onClick={{ rename }}>Rename</button>
                <button type="button" id="fix-email" onClick={{ fixEmail }}>Fix the email</button>
                <button type="button" id="quick" onClick={{ quick }}>Quick</button>
                <p id="saved">{{ saved }}</p>
            </form>
        );
    }
}

// A child that gets the Validation as a prop: it renders again when the errors change.
#[Component]
function FieldError(Validation $validation, string $field): Node
{
    return <span className="child-error" data-field={{ field }}>{{ validation.error(field) }}</span>;
}

#[Page('/validation')]
final class ValidationPage
{
    public function render(): Node
    {
        return (
            <Document title="Validation">
                <Registration />
            </Document>
        );
    }
}
