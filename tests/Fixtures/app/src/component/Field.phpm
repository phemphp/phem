<?phpm

namespace App\Component;

use Acme\Ui\Field as UiField;
use Phem\Attribute\Component;
use Phem\{Bound, Node};

// Replaces the Field of the acme/ui package. `phem:bind` on a tag of the original gives the
// replacement a Bound, and the replacement gives it to the original.
#[Component(replaces: UiField::class)]
function Field(Bound $value, string $name = 'field'): Node
{
    return <label className="my-field">{{ name }} <UiField phem:bind={{ value }} name={{ name }} /></label>;
}
