<?phpm

namespace App\Component;

use Acme\Ui\Toggle as UiToggle;
use Phem\Attribute\{Component, Prop, State};
use Phem\Node;

// A class replacement with its own state: it counts the flips, and wraps the original, which keeps
// its state too.
#[Component(replaces: UiToggle::class)]
final class Toggle
{
    #[Prop] public string $label = 'Toggle';
    #[State] public int $flips = 0;

    public function count(): void
    {
        ++$this->flips;
    }

    public function render(): Node
    {
        return (
            <div id="my-toggle">
                <button id="count" onClick={{ count }}>Flips {{ flips }}</button>
                <UiToggle label={{ label }} />
            </div>
        );
    }
}
