<?phpm

namespace App\Page;

use App\Component\Counter;
use Phem\Attribute\Page;
use Phem\Node;

use function App\Component\Document;

// A function page: a template component, with a repeated #[Page].
#[Page('/about')]
#[Page('/about-us', name: 'about_us')]
function About(): Node
{
    return (
        <Document>
            <p id="about">About</p>
        </Document>
    );
}

// A function page with PHP code, and a component with state and a handler.
#[Page('/welcome', name: 'welcome')]
function Welcome(): Node
{
    $name = ucfirst('ada');

    return (
        <Document>
            <Document:title>Welcome</Document:title>
            <p id="welcome">Welcome, {{ name }}!</p>
            <Counter label="Visits" />
        </Document>
    );
}
