<?phpm

namespace App\Page;

use Phem\Attribute\{Page, State};
use Phem\Event;
use Phem\Node;
use Symfony\Component\DependencyInjection\Attribute\Autowire;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Generator\UrlGeneratorInterface;

use function App\Component\Document;

// The arguments of the handlers, as for the actions of a Symfony controller: the event at any
// position or not at all, the request, the services, and #[Autowire].
#[Page('/arguments', name: 'arguments')]
final class Arguments
{
    #[State] public string $log = '';

    // The event after a service.
    public function link(UrlGeneratorInterface $urls, Event $e): void
    {
        $this->log = $urls->generate('arguments').' '.$e->type;
    }

    // No event: the request has the form fields as its POST data.
    public function submit(Request $request, #[Autowire('%kernel.environment%')] string $env): void
    {
        $this->log = $request->getMethod().' '.$request->request->get('name', '-').' '.$env;
    }

    public function render(): Node
    {
        // A closure has no services, but it gets the event and the request.
        $closure = fn (Event $e, Request $request) => $this->log = 'closure '.$e->type.' '.$request->getPathInfo();

        return (
            <Document>
                <p id="log">{{ log }}</p>
                <button onClick={{ link }}>Link</button>
                <button onClick={{ submit }}>Submit</button>
                <button onClick={{ closure }}>Closure</button>
            </Document>
        );
    }
}
