<?phpm

namespace App\Page;

use Phem\Attribute\{Async, Component, Page, Path, Prop, State, Broadcast, BroadcastKey};
use Phem\Async\Promise;
use Phem\Event;
use Phem\Node;
use Phem\Stream\Streams;
use Phem\Tests\Fixtures\Guestbook;
use Symfony\Component\HttpFoundation\RequestStack;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;

use function App\Component\Document;

// The pushes of Phem\Stream\Streams: a page with #[Broadcast], plain markup and refresh().

// The entries: data with no state, so it reads them again in each render.
#[Component]
final class GuestbookEntries
{
    #[Prop] public string $room;
    public array $entries = [];

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    public function mount(): void
    {
        $this->entries = $this->guestbook->entries($this->room);
    }

    public function render(): Node
    {
        return (
            <ul id="entries">
                {% for entry in entries %}<GuestbookEntry key={{ entry.id }} entry={{ entry }} />{% endfor %}
            </ul>
        );
    }
}

// A class component: it has a fiber in the list, with its id on the <li>.
#[Component]
final class GuestbookEntry
{
    #[Prop] public array $entry;

    public function render(): Node
    {
        return <li id="entry-{{ entry.id }}">{{ entry.text }}</li>;
    }
}

// The number of entries: data with no state, so a refresh reads it again. Its child keeps a
// state of the UI (open), so a refresh keeps it.
#[Component]
final class GuestbookStats
{
    #[Prop] public string $room;
    public int $count = 0;

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    public function mount(): void
    {
        $this->count = \count($this->guestbook->entries($this->room));
    }

    public function render(): Node
    {
        return <GuestbookCount count={{ count }} />;
    }
}

#[Component]
final class GuestbookCount
{
    #[Prop] public int $count;
    #[State] public bool $open = false;

    public function toggle(): void
    {
        $this->open = !$this->open;
    }

    public function render(): Node
    {
        return (
            <div>
                <p id="stats">{{ count }} entries{% if open %}, open{% endif %}</p>
                <button id="toggle" onClick={{ toggle }}>Toggle</button>
            </div>
        );
    }
}

#[Component]
final class GuestbookForm
{
    #[Prop] public string $room;
    #[State] public string $text = '';

    public function __construct(
        private readonly Guestbook $guestbook,
        private readonly Streams $streams,
    ) {
    }

    public function sign(Event $e): void
    {
        $entry = $this->guestbook->add($this->room, $this->text);
        $this->text = '';
        $this->streams->toPage(GuestbookPage::class, ['room' => $this->room])
            ->prepend('entries', <li id="entry-{{ entry.id }}">{{ entry.text }}</li>)
            ->refresh('stats');
    }

    // A push of markup that the server render does not have: the next event renders the list again.
    public function note(): void
    {
        $this->streams->toPage(GuestbookPage::class)->append('entries', <li id="note">A note</li>);
    }

    // Removes the newest entry: in the other tabs, its component is not in the page any more.
    public function forget(): void
    {
        if (null !== $id = $this->guestbook->forget($this->room)) {
            $this->streams->toPage(GuestbookPage::class)->remove('entry-'.$id);
        }
    }

    // A push in the markup of the page itself: the component around it is the <Root>.
    public function motd(): void
    {
        $this->streams->toPage(GuestbookPage::class)->update('motd', <b>Welcome back</b>);
    }

    // The streams of a handler that throws are dropped.
    public function fail(): void
    {
        $this->streams->toPage(GuestbookPage::class)->refresh('stats');

        throw new \RuntimeException('The handler failed.');
    }

    // Markup with a handler cannot be pushed.
    public function interactive(): void
    {
        $this->streams->everywhere()->append('entries', <li><button onClick={{ fail }}>Fail</button></li>);
    }

    // The streams to a function page name it by its first-class callable.
    public function board(): void
    {
        $this->guestbook->add($this->room, 'On the board');
        $this->streams->toPage(GuestbookBoard(...), ['room' => $this->room])->refresh('board');
    }

    // The streams to a component go to all the pages that render it.
    public function inbox(): void
    {
        $this->guestbook->add($this->room, 'In the inbox');
        $this->streams->toComponent(GuestbookInbox::class)->refresh('inbox');
    }

    // A page with no #[Broadcast] gets no streams.
    public function elsewhere(): void
    {
        $this->streams->toPage(NotifyPage::class)->refresh('save');
    }

    public function render(): Node
    {
        return (
            <form onSubmit={{ sign }}>
                <input name="text" phem:bind={{ text }} />
                <button id="sign" type="submit">Sign</button>
                <button id="note" type="button" onClick={{ note }}>Note</button>
                <button id="forget" type="button" onClick={{ forget }}>Forget</button>
                <button id="welcome" type="button" onClick={{ motd }}>Motd</button>
                <button id="fail" type="button" onClick={{ fail }}>Fail</button>
                <button id="interactive" type="button" onClick={{ interactive }}>Interactive</button>
                <button id="board" type="button" onClick={{ board }}>Board</button>
                <button id="inbox" type="button" onClick={{ inbox }}>Inbox</button>
                <button id="elsewhere" type="button" onClick={{ elsewhere }}>Elsewhere</button>
            </form>
        );
    }
}

#[Page('/guestbook/{room}'), Broadcast]
final class GuestbookPage
{
    #[Path] public string $room;

    public function render(): Node
    {
        return (
            <Document>
                <p id="motd">Welcome</p>
                <GuestbookForm room={{ room }} />
                <GuestbookStats room={{ room }} />
                <GuestbookEntries room={{ room }} />
            </Document>
        );
    }
}

// A function page with #[Broadcast]: its route value and a service in its parameters.
#[Page('/board/{room}'), Broadcast]
function GuestbookBoard(string $room, Guestbook $guestbook): Node
{
    $count = \count($guestbook->entries($room));

    return (
        <Document>
            <p id="board">{{ count }} on the board</p>
        </Document>
    );
}

// A component with #[Broadcast]: the pages that render it get its streams. It has a state of the
// UI (open) for an event, so it reads the data in render(): a refresh does not mount it again.
#[Component, Broadcast]
final class GuestbookInbox
{
    #[Prop] public string $room;
    #[State] public bool $open = false;

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    public function toggle(): void
    {
        $this->open = !$this->open;
    }

    public function render(): Node
    {
        $count = \count($this->guestbook->entries($this->room));

        return (
            <p id="inbox">
                {{ count }} in the inbox{% if open %}, open{% endif %}
                <button id="open" type="button" onClick={{ toggle }}>Open</button>
            </p>
        );
    }
}

// A page with no #[Broadcast]: its component with #[Broadcast] connects it.
#[Page('/inbox/{room}')]
function GuestbookInboxPage(string $room): Node
{
    return (
        <Document>
            <GuestbookInbox room={{ room }} />
        </Document>
    );
}

// A component with a #[BroadcastKey] prop, and #[Broadcast] on its handlers only: the class
// needs no #[Broadcast]. A handler with #[Broadcast] renders again the instances of the same
// room in the other browsers. Its other handler changes a state of this browser only.
#[Component]
final class GuestbookLikes
{
    #[Prop, BroadcastKey] public string $room;
    #[State] public bool $open = false;

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    #[Broadcast]
    public function like(): void
    {
        $this->guestbook->add($this->room, 'Like');
    }

    // The refresh goes after the work, from the worker.
    #[Async, Broadcast]
    public function later(): Promise
    {
        return new Promise(function (): void {
            $this->guestbook->add($this->room, 'Like');
        });
    }

    public function toggle(): void
    {
        $this->open = !$this->open;
    }

    public function render(): Node
    {
        $count = \count($this->guestbook->entries($this->room));
        // A closure that calls a handler with #[Broadcast] needs its own #[Broadcast].
        $cheer = #[Broadcast] fn () => $this->like();

        return (
            <p id="likes-{{ room }}">
                {{ count }} likes in {{ room }}{% if open %}, open{% endif %}
                <button id="like-{{ room }}" type="button" onClick={{ like }}>Like</button>
                <button id="later-{{ room }}" type="button" onClick={{ later }}>Later</button>
                <button id="cheer-{{ room }}" type="button" onClick={{ cheer }}>Cheer</button>
                <button id="open-{{ room }}" type="button" onClick={{ toggle }}>Open</button>
            </p>
        );
    }
}

// Two instances of the component, with two keys.
#[Page('/likes')]
function GuestbookLikesPage(): Node
{
    return (
        <Document>
            <GuestbookLikes room="lobby" />
            <GuestbookLikes room="hall" />
        </Document>
    );
}

// A component with #[Broadcast(handlers: false)]: it gets the streams of other requests, and its
// handlers do not refresh it in the other browsers. Its #[BroadcastKey] prop still identifies an
// instance for the streams.
#[Component, Broadcast(handlers: false)]
final class GuestbookBag
{
    #[Prop, BroadcastKey] public string $room;

    public function __construct(private readonly Guestbook $guestbook)
    {
    }

    // A change for this browser: the other browsers keep their bag.
    public function add(): void
    {
        $this->guestbook->add($this->room, 'Item');
    }

    public function render(): Node
    {
        $count = \count($this->guestbook->entries($this->room));

        return (
            <p id="bag-{{ room }}">
                {{ count }} in the bag of {{ room }}
                <button id="add-{{ room }}" type="button" onClick={{ add }}>Add</button>
            </p>
        );
    }
}

// Two instances of the bag, with two keys.
#[Page('/bags')]
function GuestbookBagPage(): Node
{
    return (
        <Document>
            <GuestbookBag room="lobby" />
            <GuestbookBag room="hall" />
        </Document>
    );
}

// A room with no state: mount() runs in each render, and throws when the room is closed. A
// refresh of a closed room loads the page again (409), as the page is not found any more.
#[Page('/rooms/{room}'), Broadcast]
final class RoomPage
{
    #[Path] public string $room;
    public int $count = 0;

    public function __construct(
        private readonly Guestbook $guestbook,
        private readonly Streams $streams,
    ) {
    }

    public function mount(): void
    {
        if ($this->guestbook->isClosed($this->room)) {
            throw new NotFoundHttpException('The room is closed.');
        }

        $this->count = \count($this->guestbook->entries($this->room));
    }

    public function save(): void
    {
    }

    // As a Doctrine listener: a service refreshes the page after the change. The handler renders
    // the page, so the tab of the event does not refresh it again.
    public function post(): void
    {
        $this->guestbook->add($this->room, 'Post');
        $this->streams->toPage(RoomPage::class, ['room' => $this->room])->refresh();
    }

    public function render(): Node
    {
        return (
            <Document>
                <p id="room">Room {{ room }}: {{ count }} entries</p>
                <button id="save" onClick={{ save }}>Save</button>
                <button id="post" onClick={{ post }}>Post</button>
            </Document>
        );
    }
}

// A key that mount() sets: the component reads its room from the request, as a list reads the
// current user. It has no #[State], so mount() runs in each render, and the key has a value.
#[Component, Broadcast]
final class GuestbookMine
{
    #[BroadcastKey] private string $room;
    public int $count = 0;

    public function __construct(
        private readonly Guestbook $guestbook,
        private readonly RequestStack $requests,
    ) {
    }

    public function mount(): void
    {
        $this->room = $this->requests->getCurrentRequest()?->query->getString('room', 'lobby') ?? 'lobby';
        $this->count = \count($this->guestbook->entries($this->room));
    }

    public function render(): Node
    {
        return <p id="mine">{{ count }} in my room</p>;
    }
}

#[Page('/mine')]
function GuestbookMinePage(): Node
{
    return (
        <Document>
            <GuestbookMine />
        </Document>
    );
}
