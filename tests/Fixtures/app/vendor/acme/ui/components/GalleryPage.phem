<?phem

namespace Acme\Ui;

use Phem\Attribute\Page;
use Phem\Node;

use function Acme\Ui\Badge;
use function Acme\Ui\Layout;

// A page of a package: the app imports its route with the name of the package. The list item
// with no key is a warning (W002), and the build of the app does not show it.
#[Page('/gallery')]
function GalleryPage(): Node
{
    return (
        <Layout>
            <ul id="gallery">
                {% for label in ['New', 'Sale'] %}
                    <li><Badge label={{ label }} /></li>
                {% endfor %}
            </ul>
        </Layout>
    );
}
