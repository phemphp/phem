<?phpm

namespace Acme\Ui;

use Phem\Attribute\{Broadcast, BroadcastKey, Component};
use Phem\Node;

// A component of a package with #[Broadcast] and a key: the app replaces it
// (src/component/Tally.phpm), and the replacement gets the streams of the original.
#[Component, Broadcast]
function Tally(#[BroadcastKey] string $room = 'lobby', int $count = 0): Node
{
    return <span className="tally">{{ count }} in {{ room }}</span>;
}
