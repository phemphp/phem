{
    "name": "phem/ui-base-demo",
    "description": "A gallery of the phem/ui-base components, to compare them with base-ui.com",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../../..", "options": { "symlink": true, "versions": { "phem/phem": "0.4.x-dev" } } },
        { "type": "path", "url": "..", "options": { "symlink": true, "versions": { "phem/ui-base": "dev-main" } } }
    ],
    "require": {
        "php": ">=8.4",
        "phem/phem": "^0.4.9",
        "phem/ui-base": "dev-main",
        "symfony/asset-mapper": "^8.0",
        "symfony/console": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/twig-bundle": "^8.0",
        "symfony/yaml": "^8.0",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tales-from-a-dev/tailwind-merge-php": "^0.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "playwright-php/playwright": "1.6.0",
        "playwright-php/playwright-symfony": "0.12.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": { "symfony/runtime": true }
    }
}
