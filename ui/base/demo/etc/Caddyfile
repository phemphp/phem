# The demo (etc/Dockerfile): public/index.php in FrankenPHP worker mode. The paths are relative to
# the demo directory (the working directory of the images). Each worker boots the kernel once and
# then handles many requests. FRANKENPHP_WORKER_CONFIG adds options to the worker: etc/watch sets
# the `watch` options of the dev environment.
{
	frankenphp {
		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}

{$SERVER_NAME::8080} {
	encode zstd gzip
	root * public
	php_server
}
