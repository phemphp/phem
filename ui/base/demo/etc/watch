#!/bin/sh
# The demo in the dev environment (the `watch` stage of etc/Dockerfile), on the repository of a
# bind mount at /app. phemc rebuilds the components after a change of a .phem file and restarts
# FrankenPHP. The workers restart after a change of a PHP class or a config file (the `watch`
# options below). Tailwind rebuilds the CSS after a change of a class.
set -e
cd "$(dirname "$0")/.."

bin/setup

bin/console tailwind:build --watch &

# One `watch` option of the worker for each pattern (etc/Caddyfile).
FRANKENPHP_WORKER_CONFIG=$(printf 'watch %s\n' \
    './src/**/*.php' \
    './config/**/*.{php,yaml}' \
    '../src/**/*.php' \
    '/app/src/**/*.php' \
    '/app/config/**/*.{php,yaml}')
export FRANKENPHP_WORKER_CONFIG

exec phemc watch src --exec "frankenphp run --config etc/Caddyfile"
