<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\{AccordionHeader, AccordionPanel, AccordionTrigger};
use Phem\Ui\Base\{Accordion, AccordionItem};

#[Page('/components/accordion')]
function AccordionPage(): Node
{
    return (
        <DemoPage slug="accordion">
            <Hero>
                <Accordion>
                    <AccordionItem value="what">
                        <AccordionHeader><AccordionTrigger>What is Base UI?</AccordionTrigger></AccordionHeader>
                        <AccordionPanel>Base UI is a library of high-quality unstyled React components for design systems and web apps.</AccordionPanel>
                    </AccordionItem>
                    <AccordionItem value="start">
                        <AccordionHeader><AccordionTrigger>How do I get started?</AccordionTrigger></AccordionHeader>
                        <AccordionPanel>Head to the “Quick start” guide in the docs. If you’ve used unstyled libraries before, you’ll feel at home.</AccordionPanel>
                    </AccordionItem>
                    <AccordionItem value="use">
                        <AccordionHeader><AccordionTrigger>Can I use it for my project?</AccordionTrigger></AccordionHeader>
                        <AccordionPanel>Of course! Base UI is free and open source.</AccordionPanel>
                    </AccordionItem>
                </Accordion>
            </Hero>
        </DemoPage>
    );
}
