#[Component]
function AutocompleteGroupedDemo(): Node
{
    $groups = [
        'Type' => array_filter(TAGS, static fn (string $id): bool => !str_starts_with($id, 'c-'), \ARRAY_FILTER_USE_KEY),
        'Component' => array_filter(TAGS, static fn (string $id): bool => str_starts_with($id, 'c-'), \ARRAY_FILTER_USE_KEY),
    ];
