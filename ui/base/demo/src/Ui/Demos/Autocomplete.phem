                            {% endfor %}
                        </ComboboxGroup>
                    {% endfor %}
                </ComboboxList>
            </ComboboxPopup>
        </Autocomplete>
    );
}

// The server matches the characters of the query in order (as the `MATCHES` ranking of
// match-sorter), and marks the text that has the query.
#[Component]
final class AutocompleteFuzzyDemo
{
    #[State] public string $query = '';

    public function choose(int $index): void
    {
        $this->query = DOCS[$index]['title'];
    }

    public static function matches(array $doc, string $query): bool
    {
        $needle = mb_str_split(mb_strtolower(trim($query)));

        foreach ([$doc['title'], $doc['description'], $doc['category']] as $text) {
            $text = mb_strtolower($text);
            $at = 0;
            foreach ($needle as $char) {
                $found = mb_strpos($text, $char, $at);
                if (false === $found) {
                    continue 2;
                }

                $at = $found + 1;
            }

            return true;
        }

        return false;
    }

    /** @return list<array{text: string, mark: bool}> the parts of the text, with the parts that have the query */
    public static function highlight(string $text, string $query): array
    {
        $needle = mb_substr(trim($query), 0, 100);
        if ('' === $needle) {
            return [['text' => $text, 'mark' => false]];
        }

        $parts = preg_split('/('.preg_quote($needle, '/').')/iu', $text, -1, \PREG_SPLIT_DELIM_CAPTURE | \PREG_SPLIT_NO_EMPTY);

        return array_map(static fn (string $part): array => ['text' => $part, 'mark' => 0 === mb_strpos(mb_strtolower($part), mb_strtolower($needle)) && mb_strlen($part) === mb_strlen($needle)], $parts);
    }

    public function render(): Node
    {
        $input = AUTOCOMPLETE_INPUT;
        $results = [];
        foreach (DOCS as $index => $doc) {
            if (self::matches($doc, $this->query)) {
                $results[$index] = ['title' => self::highlight($doc['title'], $this->query), 'description' => self::highlight($doc['description'], $this->query)];
            }
        }

        return (
            <Autocomplete id="docs">
                <ComboboxLabel>Fuzzy search documentation</ComboboxLabel>
                <ComboboxInput phem:bind={{ query }} placeholder="e.g. React" className={{ input }} />
                <ComboboxPopup>
                    <ComboboxEmpty className="py-3">No results found for "{{ query }}"</ComboboxEmpty>
                    <ComboboxList className="flex max-h-[min(var(--available-height),28rem)] flex-col">
                        {% for index, doc in results %}
                            <ComboboxItem key={{ index }} value={{ '' ~ index }} onClick={{ choose(index) }} className="flex py-3 leading-6 data-highlighted:text-neutral-950 data-highlighted:before:bg-neutral-100 dark:data-highlighted:text-white dark:data-highlighted:before:bg-neutral-800">
                                <span className="flex w-full flex-col gap-1">
                                    <span className="leading-5 font-bold">{% for part in doc.title %}{% if part.mark %}<mark className="bg-transparent font-bold text-blue-800 dark:text-blue-500">{{ part.text }}</mark>{% else %}{{ part.text }}{% endif %}{% endfor %}</span>
                                    <span className="text-sm text-neutral-500 dark:text-neutral-400">{% for part in doc.description %}{% if part.mark %}<mark className="bg-transparent font-bold text-blue-800 dark:text-blue-500">{{ part.text }}</mark>{% else %}{{ part.text }}{% endif %}{% endfor %}</span>
                                </span>
                            </ComboboxItem>
                        {% endfor %}
                    </ComboboxList>
                </ComboboxPopup>
            </Autocomplete>
        );
    }
}

// The browser filters and limits the tags. The server counts the matches for the status.
#[Component]
final class AutocompleteLimitDemo
{
    private const int LIMIT = 8;

    #[State] public string $query = '';

    /** @return array<string, string> */
    public static function tags(): array
    {
        return [...\array_slice(TAGS, 0, 6), ...MORE_TAGS, ...\array_slice(TAGS, 6)];
    }

    public function render(): Node
    {
        $tags = self::tags();
        $input = AUTOCOMPLETE_INPUT;
        $limit = self::LIMIT;
        $matches = '' === trim($this->query) ? \count($tags) : \count(array_filter($tags, fn (string $tag): bool => autocompleteContains($tag, $this->query)));
        $more = max(0, $matches - $limit);
        $status = $more > 0 ? 'Hiding '.$more.' results (type a more specific query to narrow results)' : null;

        return (
            <Autocomplete id="limited-tags" filter="contains" limit={{ limit }}>
                <ComboboxLabel>Limit results to 8</ComboboxLabel>
                <ComboboxInput phem:bind={{ query }} placeholder="e.g. component" className={{ input }} />
                <ComboboxPopup>
                    <ComboboxEmpty className="py-2">No results found for "{{ query }}"</ComboboxEmpty>
                    <ComboboxList>
                        {% for id, tag in tags %}
                            <ComboboxItem key={{ id }} value={{ id }} className="flex">{{ tag }}</ComboboxItem>
                        {% endfor %}
                    </ComboboxList>
                    <ComboboxStatus className="py-2 pr-4 pl-2 empty:hidden">{{ status }}</ComboboxStatus>
                </ComboboxPopup>
            </Autocomplete>
        );
    }
}

