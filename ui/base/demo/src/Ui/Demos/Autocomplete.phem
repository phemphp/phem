/** Whether a text has the query, with no case: the `contains` filter of the browser. */
function autocompleteContains(string $text, string $query): bool
{
    return str_contains(mb_strtolower($text), mb_strtolower(trim($query)));
}

#[Page('/components/autocomplete')]
function AutocompletePage(): Node
{
    return (
        <DemoPage slug="autocomplete">
            <Hero source="AutocompleteHeroDemo">
                <AutocompleteHeroDemo />
            </Hero>
            <Examples>
                <Example title="Async search" source="AutocompleteAsyncDemo">
                    <Example.description>
                        <p>Load items asynchronously while typing and render custom status content. Bind the input with <code>phem:bind</code>: the server searches, and renders the results and the status. While the search runs, the popup gets <code>aria-busy</code>, and the status shows a spinner.</p>
                    </Example.description>
                    <AutocompleteAsyncDemo />
                </Example>
                <Example title="Inline autocomplete" source="AutocompleteInlineDemo">
                    <Example.description>
                        <p>Autofill the input with the highlighted item while navigating with arrow keys using the <code>mode</code> prop. Accepts <code>aria-autocomplete</code> values <code>list</code>, <code>both</code>, <code>inline</code>, or <code>none</code>.</p>
                    </Example.description>
                    <AutocompleteInlineDemo />
                </Example>
                <Example title="Grouped" source="AutocompleteGroupedDemo">
                    <Example.description>
                        <p>Organize related options with <code>ComboboxGroup</code> and <code>ComboboxGroupLabel</code> to add section headings inside the popup.</p>
                        <p>Render one group for each section of your data, with the heading text in its label and its items in it. A group with no matching item is hidden.</p>
                    </Example.description>
                    <AutocompleteGroupedDemo />
                </Example>
                <Example title="Fuzzy matching" source="AutocompleteFuzzyDemo">
                    <Example.description>
                        <p>Use fuzzy matching to find relevant results even when the query doesn’t exactly match the item text. Here the server matches the characters of the query in order, and marks the text that matches.</p>
                    </Example.description>
                    <AutocompleteFuzzyDemo />
                </Example>
                <Example title="Limit results" source="AutocompleteLimitDemo">
                    <Example.description>
                        <p>Limit the number of visible items using the <code>limit</code> prop and guide users to refine their query using <code>ComboboxStatus</code>.</p>
                    </Example.description>
                    <AutocompleteLimitDemo />
                </Example>
                <Example title="Auto highlight" source="AutocompleteAutoHighlightDemo">
                    <Example.description>
                        <p>The first matching item can be automatically highlighted as the user types by specifying the <code>autoHighlight</code> prop on <code>Autocomplete</code>. Set the prop’s value to <code>"always"</code> if the highlight should always be present, such as when the list is rendered inline within a dialog.</p>
                        <p>The prop can be combined with the <code>keepHighlight</code> and <code>highlightItemOnHover</code> props to configure how the highlight behaves during mouse interactions.</p>
                    </Example.description>
                    <AutocompleteAutoHighlightDemo />
                </Example>
                <Example title="Command palette" source="AutocompleteCommandPaletteDemo">
                    <Example.description>
                        <p>Use the autocomplete input to filter a list of command items that perform an action when clicked. With no <code>ComboboxPopup</code>, the list is inline and always open. Give the items <code>data-phem-dialog-target="close"</code> to close the dialog on a choice.</p>
                    </Example.description>
                    <AutocompleteCommandPaletteDemo />
                </Example>
                <Example title="Grid layout" source="AutocompleteGridDemo">
                    <Example.description>
                        <p>Display items in a grid layout, wrapping each row in <code>ComboboxRow</code> components, and add the <code>grid</code> prop to <code>Autocomplete</code>. The arrow keys move in the rows and in the columns.</p>
                        <p>A choice runs the <code>onClick</code> handler of the item, which adds the emoji to the end of the message, and the focus goes back to the trigger.</p>
                    </Example.description>
                    <AutocompleteGridDemo />
                </Example>
                <Example title="Virtualized" source="AutocompleteVirtualizedDemo">
                    <Example.description>
                        <p>A virtualization library renders only the visible rows of a large dataset in the browser. In phem, the server searches the dataset, and renders only the first matches with a status of the total.</p>
                    </Example.description>
                    <AutocompleteVirtualizedDemo />
                </Example>
                <Example title="Memoizing items">
                    <Example.description>
                        <p>React memoizes each item so that unchanged items skip re-rendering. phem renders the items on the server, and the morph changes only the items that changed, so the items need no memoization. For a dataset that is too large to render at once, render only the first matches, as in the Virtualized example.</p>
                    </Example.description>
                </Example>
            </Examples>
        </DemoPage>
    );
}

// The browser filters the tags, as the Base UI demo does. The popup has no animation.
#[Component]
function AutocompleteHeroDemo(): Node
{
    $tags = TAGS;

    return (
        <Autocomplete id="tags" filter="contains">
            <ComboboxLabel>Search tags</ComboboxLabel>
            <ComboboxInput placeholder="e.g. feature" className="h-8 w-[16rem] border border-neutral-950 px-2 placeholder:opacity-100 placeholder:[-webkit-text-fill-color:var(--color-neutral-500)] dark:placeholder:[-webkit-text-fill-color:var(--color-neutral-400)] focus:outline-solid focus:outline-2 focus:-outline-offset-1 focus:outline-neutral-950 dark:border-white dark:focus:outline-white" />
            <ComboboxPopup>
                <ComboboxEmpty>No tags found.</ComboboxEmpty>
                <ComboboxList className="scroll-py-[0.25rem]">
                    {% for id, tag in tags %}
                        <ComboboxItem key={{ id }} value={{ id }} className="flex">{{ tag }}</ComboboxItem>
                    {% endfor %}
                </ComboboxList>
            </ComboboxPopup>
        </Autocomplete>
    );
}

// The server searches the movies by name or year. The spinner shows while the search runs.
#[Component]
final class AutocompleteAsyncDemo
{
    #[State] public string $query = '';

    public function choose(string $id): void
    {
        $this->query = array_values(array_filter(MOVIES, static fn (array $m): bool => $m['id'] === $id))[0]['title'];
    }

    public function render(): Node
    {
        $input = AUTOCOMPLETE_INPUT;
        $searching = trim($this->query);
        $error = 'will_error' === $searching;
        $results = '' === $searching || $error ? [] : array_values(array_filter(MOVIES, static fn (array $m): bool => autocompleteContains($m['title'], $searching) || autocompleteContains((string) $m['year'], $searching)));
        $count = \count($results);
        $status = match (true) {
            $error => 'Failed to fetch movies. Please try again.',
            '' === $searching => null,
            0 === $count => 'Movie or year "'.$searching.'" does not exist in the Top 100 IMDb movies',
            default => $count.' result'.(1 === $count ? '' : 's').' found',
        };

        return (
            <Autocomplete id="movies">
                <ComboboxLabel>Search movies by name or year</ComboboxLabel>
                <ComboboxInput phem:bind={{ query }} placeholder="e.g. Pulp Fiction or 1994" className={{ input }} />
                <ComboboxPopup className="[&[data-empty]:not([aria-busy=true]):has([data-status-text]:empty)]:hidden">
                    <ComboboxStatus className="p-0">
                        <span className="hidden items-center gap-2 py-1 pr-8 pl-2 [[aria-busy=true]_&]:flex">
                            <span aria-hidden="true" className="inline-block size-3 animate-spin rounded-full border border-current border-r-transparent"></span>
                            Searching…
                        </span>
                        <span data-status-text className="flex items-center gap-2 py-1 pr-8 pl-2 empty:hidden [[aria-busy=true]_&]:hidden">{{ status }}</span>
                    </ComboboxStatus>
                    <ComboboxList className="data-empty:p-0">
                        {% for movie in results %}
                            <ComboboxItem key={{ movie.id }} value={{ movie.id }} onClick={{ choose(movie.id) }} className="flex">
                                <span className="flex w-full flex-col gap-1">
                                    <span className="leading-5 font-bold">{{ movie.title }}</span>
                                    <span className="text-sm leading-4 text-neutral-500 group-data-highlighted:text-neutral-300 dark:text-neutral-400 dark:group-data-highlighted:text-neutral-500">{{ movie.year }}</span>
                                </span>
                            </ComboboxItem>
                        {% endfor %}
                    </ComboboxList>
                </ComboboxPopup>
            </Autocomplete>
        );
    }
}

