<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\Examples\AvatarHeroDemo;

#[Page('/components/avatar')]
function AvatarPage(): Node
{
    return (
        <DemoPage slug="avatar">
            <Hero source="AvatarHeroDemo">
                <AvatarHeroDemo />
            </Hero>
        </DemoPage>
    );
}
