<?phem

namespace App\Ui\Demos;

use Phem\Attribute\{Page, State};
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\{FieldControl, FieldLabel, FieldsetLegend, MeterIndicator, MeterLabel, MeterTrack, MeterValue, ProgressIndicator, ProgressLabel, ProgressTrack, ProgressValue};
use Phem\Ui\Base\{Button, Field, Fieldset, Input, Meter, Progress, Separator};

#[Page('/components/button')]
function ButtonPage(): Node
{
    return <DemoPage slug="button"><Hero><Button>Submit</Button></Hero></DemoPage>;
}

#[Page('/components/input')]
function InputPage(): Node
{
    return (
        <DemoPage slug="input"><Hero>
            <label className="flex flex-col items-start gap-1 text-sm font-bold text-neutral-950 dark:text-white">
                Name
                <Input placeholder="e.g. Colm Tuite" />
            </label>
        </Hero></DemoPage>
    );
}

#[Page('/components/separator')]
function SeparatorPage(): Node
{
    $link = 'text-sm text-neutral-950 decoration-neutral-300 decoration-1 underline-offset-2 hover:underline focus-visible:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white dark:text-white dark:decoration-neutral-700';

    return (
        <DemoPage slug="separator"><Hero>
            <div className="flex gap-4 text-nowrap">
                <a href="#" className={{ link }}>Home</a>
                <a href="#" className={{ link }}>Pricing</a>
                <a href="#" className={{ link }}>Blog</a>
                <a href="#" className={{ link }}>Support</a>
                <Separator orientation="vertical" />
                <a href="#" className={{ link }}>Log in</a>
                <a href="#" className={{ link }}>Sign up</a>
            </div>
        </Hero></DemoPage>
    );
}

#[Page('/components/fieldset')]
function FieldsetPage(): Node
{
    return (
        <DemoPage slug="fieldset"><Hero>
            <Fieldset>
                <FieldsetLegend>Billing details</FieldsetLegend>
                <Field id="company">
                    <FieldLabel>Company</FieldLabel>
                    <FieldControl placeholder="Enter company name" />
                </Field>
                <Field id="tax-id">
                    <FieldLabel>Tax ID</FieldLabel>
                    <FieldControl placeholder="Enter fiscal number" />
                </Field>
            </Fieldset>
        </Hero></DemoPage>
    );
}

#[Page('/components/meter')]
function MeterPage(): Node
{
    return (
        <DemoPage slug="meter"><Hero>
            <Meter id="storage" value={{ 24 }}>
                <MeterLabel>Storage Used</MeterLabel>
                <MeterValue />
                <MeterTrack><MeterIndicator /></MeterTrack>
            </Meter>
        </Hero></DemoPage>
    );
}

// The value grows each second, as in the Base UI demo: a poll adds a random step, up to 100.
#[Page('/components/progress')]
final class ProgressPage
{
    #[State] public int $value = 20;

    public function advance(): void
    {
        $this->value = min(100, $this->value + random_int(0, 25));
    }

    public function render(): Node
    {
        $bar = (
            <Progress id="export" value={{ value }}>
                <ProgressLabel>Export data</ProgressLabel>
                <ProgressValue />
                <ProgressTrack><ProgressIndicator /></ProgressTrack>
            </Progress>
        );

        return (
            <DemoPage slug="progress"><Hero>
                {% if value < 100 %}
                    <div className="contents" onPoll={{ advance }} phem:poll={{ 1000 }}>{{ bar }}</div>
                {% else %}
                    <div className="contents">{{ bar }}</div>
                {% endif %}
            </Hero></DemoPage>
        );
    }
}
