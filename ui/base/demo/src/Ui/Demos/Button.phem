<?phem

namespace App\Ui\Demos;

use Phem\Attribute\{Component, Page};
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use Phem\Ui\Base\Button;

#[Page('/components/button')]
function ButtonPage(): Node
{
    return (
        <DemoPage slug="button">
            <Hero source="ButtonHeroDemo">
                <ButtonHeroDemo />
            </Hero>
            <Examples>
                <Example title="Rendering as another tag" source="ButtonAnotherTagDemo">
                    <Example.description>
                        <p>The button can remain keyboard accessible while being rendered as another tag, such as a <code>&lt;div&gt;</code>, by specifying <code>tag="div"</code>.</p>
                    </Example.description>
                    <ButtonAnotherTagDemo />
                </Example>
                <Example title="Rendering links as buttons">
                    <Example.description>
                        <p>The Button component enforces button semantics. <code>tag</code> renders a tag that is not a <code>&lt;button&gt;</code>, but it must still be a tag that can receive button semantics (<code>role="button"</code>, keyboard interaction handlers). Links (<code>&lt;a&gt;</code>) have their own semantics and should not be rendered as buttons with <code>tag="a"</code>.</p>
                        <p>If a link needs to look like a button visually, style the <code>&lt;a&gt;</code> element directly with CSS rather than using the Button component.</p>
                    </Example.description>
                </Example>
                <Example title="Loading states" source="ButtonLoadingDemo">
                    <Example.description>
                        <p>For buttons that enter a loading state after activation, specify <code>focusableWhenDisabled</code> so focus remains on the button while it is disabled. Because some browser and screen reader combinations do not reliably announce changes to a focused button’s descendant text, use <a href="https://www.w3.org/TR/accname-1.2/#computation-steps" className="underline"><code>aria-labelledby</code></a> to make the changing text the button’s explicit accessible name.</p>
                    </Example.description>
                    <ButtonLoadingDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}

#[Component]
function ButtonHeroDemo(): Node
{
    return <Button>Submit</Button>;
}

#[Component]
function ButtonAnotherTagDemo(): Node
{
    return <Button tag="div">Button that can contain complex children</Button>;
}

// The click sends a request that ends after 4 seconds, as in the Base UI demo. `phem:lock`
// disables the button at once in the browser, and the label shows "Submitting": the server keeps
// no loading state. The button keeps the focus, and the answer enables it again.
#[Component]
final class ButtonLoadingDemo
{
    public function submit(): void
    {
        // Simulate a request that ends after 4 seconds.
        sleep(4);
    }

    public function render(): Node
    {
        return (
            <Button focusableWhenDisabled aria-labelledby="loading-label" onClick={{ submit }} phem:lock>
                <span id="loading-label">
                    <span className="in-aria-disabled:hidden">Submit</span>
                    <span className="not-in-aria-disabled:hidden">Submitting</span>
                </span>
            </Button>
        );
    }
}
