<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\Examples\{CheckboxFormDemo, CheckboxHeroDemo, CheckboxLabelingDemo, CheckboxNativeButtonDemo};

#[Page('/components/checkbox')]
function CheckboxPage(): Node
{
    return (
        <DemoPage slug="checkbox">
            <Hero source="CheckboxHeroDemo">
                <CheckboxHeroDemo />
            </Hero>
            <Examples>
                <Example title="Labeling a checkbox" source="CheckboxLabelingDemo">
                    <Example.description>
                        <p>An enclosing <code>&lt;label&gt;</code> is the simplest labeling pattern:</p>
                    </Example.description>
                    <CheckboxLabelingDemo />
                </Example>
                <Example title="Rendering as a native button" source="CheckboxNativeButtonDemo">
                    <Example.description>
                        <p>By default, <code>Checkbox</code> renders a <code>&lt;span&gt;</code> element to support enclosing labels. Prefer rendering the checkbox as a native button with <code>nativeButton</code> when using sibling labels (<code>for</code>/<code>id</code>).</p>
                    </Example.description>
                    <CheckboxNativeButtonDemo />
                </Example>
                <Example title="Form integration" source="CheckboxFormDemo">
                    <Example.description>
                        <p>Use <a href="/components/field" className="underline">Field</a> to handle label associations and form integration:</p>
                    </Example.description>
                    <CheckboxFormDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}
