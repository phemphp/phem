<?phem

namespace App\Ui\Demos;

use Phem\Attribute\{Component, Page};
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\{CheckboxIndicator, FieldItem, FieldLabel, FieldsetLegend, Form};
use Phem\Ui\Base\{Checkbox, CheckboxGroup, Field, Fieldset};

const PROTOCOLS = ['http' => 'HTTP', 'https' => 'HTTPS', 'ssh' => 'SSH'];

#[Page('/components/checkbox-group')]
function CheckboxGroupPage(): Node
{
    $apples = ['fuji-apple' => 'Fuji', 'gala-apple' => 'Gala', 'granny-smith-apple' => 'Granny Smith'];
    $label = 'flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white';

    return (
        <DemoPage slug="checkbox-group">
            <Hero>
                <CheckboxGroup aria-labelledby="apples-caption" defaultValue={{ ['fuji-apple'] }}>
                    <div className="text-sm font-bold" id="apples-caption">Apples</div>
                    {% for value, name in apples %}
                        <label key={{ value }} className={{ label }}><Checkbox name="apple" value={{ value }}><CheckboxIndicator /></Checkbox>{{ name }}</label>
                    {% endfor %}
                </CheckboxGroup>
            </Hero>
            <Examples>
                <Example title="Labeling a checkbox group">
                    <Example.description>
                        <p>Label the group with <code>aria-labelledby</code> and a sibling label element. An enclosing <code>&lt;label&gt;</code> is the simplest labeling pattern for each checkbox.</p>
                    </Example.description>
                    <CheckboxGroupLabelingDemo />
                </Example>
                <Example title="Rendering as a native button">
                    <Example.description>
                        <p>By default, <code>Checkbox</code> renders a <code>&lt;span&gt;</code> element to support enclosing labels. Prefer rendering each checkbox as a native button with <code>nativeButton</code> when using sibling labels (<code>for</code>/<code>id</code>).</p>
                    </Example.description>
                    <CheckboxGroupNativeButtonDemo />
                </Example>
                <Example title="Form integration">
                    <Example.description>
                        <p>Use <a href="/components/field" className="underline">Field</a> and <a href="/components/fieldset" className="underline">Fieldset</a> for group labeling and form integration.</p>
                    </Example.description>
                    <CheckboxGroupFormDemo />
                </Example>
                <Example title="Parent checkbox">
                    <Example.description>
                        <p>A checkbox that controls other checkboxes within a <code>CheckboxGroup</code> can be created:</p>
                        <ol className="list-decimal pl-6">
                            <li>Pass an array of all the child checkbox values to the <code>allValues</code> prop on the <code>CheckboxGroup</code> component</li>
                            <li>Add the <code>parent</code> boolean prop to the parent <code>Checkbox</code></li>
                        </ol>
                        <p>The group controls the parent checkbox’s <a href="/components/checkbox" className="underline">indeterminate</a> state when some, but not all, child checkboxes are checked.</p>
                    </Example.description>
                    <CheckboxGroupParentDemo />
                </Example>
                <Example title="Nested parent checkbox">
                    <Example.description>
                        <p>A <code>CheckboxGroup</code> with a <code>value</code> inside another group is an item of that group: the outer parent checks all its checkboxes, and is indeterminate when some of them are checked.</p>
                    </Example.description>
                    <CheckboxGroupNestedDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}

#[Component]
function CheckboxGroupLabelingDemo(): Node
{
    $protocols = PROTOCOLS;

    return (
        <CheckboxGroup aria-labelledby="protocols-label">
            <div id="protocols-label" className="text-sm font-bold">Allowed network protocols</div>
            {% for value, name in protocols %}
                <label key={{ value }} className="flex items-center gap-2 text-sm"><Checkbox value={{ value }}><CheckboxIndicator /></Checkbox>{{ name }}</label>
            {% endfor %}
        </CheckboxGroup>
    );
}

#[Component]
function CheckboxGroupNativeButtonDemo(): Node
{
    $protocols = PROTOCOLS;

    return (
        <CheckboxGroup aria-labelledby="native-protocols-label">
            <div id="native-protocols-label" className="text-sm font-bold">Allowed network protocols</div>
            {% for value, name in protocols %}
                <div key={{ value }} className="flex items-center gap-2 text-sm">
                    <Checkbox id="protocol-{{ value }}" value={{ value }} nativeButton><CheckboxIndicator /></Checkbox>
                    <label htmlFor="protocol-{{ value }}">{{ name }}</label>
                </div>
            {% endfor %}
        </CheckboxGroup>
    );
}

#[Component]
function CheckboxGroupFormDemo(): Node
{
    $protocols = PROTOCOLS;

    return (
        <Form>
            <Field>
                <Fieldset>
                    <FieldsetLegend className="text-sm">Allowed network protocols</FieldsetLegend>
                    <CheckboxGroup aria-label="Allowed network protocols">
                        {% for value, name in protocols %}
                            <FieldItem key={{ value }}>
                                <FieldLabel className="flex items-center gap-2 font-normal">
                                    <Checkbox name="allowedNetworkProtocols[]" value={{ value }}><CheckboxIndicator /></Checkbox>
                                    {{ name }}
                                </FieldLabel>
                            </FieldItem>
                        {% endfor %}
                    </CheckboxGroup>
                </Fieldset>
            </Field>
        </Form>
    );
}

#[Component]
function CheckboxGroupParentDemo(): Node
{
    $apples = ['fuji-apple' => 'Fuji', 'gala-apple' => 'Gala', 'granny-smith-apple' => 'Granny Smith'];

    return (
        <CheckboxGroup aria-labelledby="parent-apples" allValues={{ apples|keys }} className="ml-4">
            <label id="parent-apples" className="-ml-4 flex items-center gap-2 text-sm"><Checkbox parent><CheckboxIndicator /></Checkbox>Apples</label>
            {% for value, name in apples %}
                <label key={{ value }} className="flex items-center gap-2 text-sm"><Checkbox value={{ value }}><CheckboxIndicator /></Checkbox>{{ name }}</label>
            {% endfor %}
        </CheckboxGroup>
    );
}

#[Component]
function CheckboxGroupNestedDemo(): Node
{
    $users = ['create-user' => 'Create User', 'edit-user' => 'Edit User', 'delete-user' => 'Delete User', 'assign-roles' => 'Assign Roles'];

    return (
        <CheckboxGroup aria-labelledby="user-permissions" allValues={{ ['view-dashboard', 'manage-users', 'access-reports'] }} className="ml-4">
            <label id="user-permissions" className="-ml-4 flex items-center gap-2 text-sm"><Checkbox parent><CheckboxIndicator /></Checkbox>User Permissions</label>
            <label className="flex items-center gap-2 text-sm"><Checkbox value="view-dashboard"><CheckboxIndicator /></Checkbox>View Dashboard</label>
            <label className="flex items-center gap-2 text-sm"><Checkbox value="access-reports"><CheckboxIndicator /></Checkbox>Access Reports</label>
            <CheckboxGroup value="manage-users" aria-labelledby="manage-users-caption" allValues={{ users|keys }} className="ml-4">
                <label id="manage-users-caption" className="-ml-4 flex items-center gap-2 text-sm"><Checkbox parent><CheckboxIndicator /></Checkbox>Manage Users</label>
                {% for value, name in users %}
                    <label key={{ value }} className="flex items-center gap-2 text-sm"><Checkbox value={{ value }}><CheckboxIndicator /></Checkbox>{{ name }}</label>
                {% endfor %}
            </CheckboxGroup>
        </CheckboxGroup>
    );
}
