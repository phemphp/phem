<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\Examples\{CheckboxGroupFormDemo, CheckboxGroupHeroDemo, CheckboxGroupLabelingDemo, CheckboxGroupNativeButtonDemo, CheckboxGroupNestedDemo, CheckboxGroupParentDemo};

#[Page('/components/checkbox-group')]
function CheckboxGroupPage(): Node
{
    return (
        <DemoPage slug="checkbox-group">
            <Hero source="CheckboxGroupHeroDemo">
                <CheckboxGroupHeroDemo />
            </Hero>
            <Examples>
                <Example title="Labeling a checkbox group" source="CheckboxGroupLabelingDemo">
                    <Example.description>
                        <p>Label the group with <code>aria-labelledby</code> and a sibling label element. An enclosing <code>&lt;label&gt;</code> is the simplest labeling pattern for each checkbox.</p>
                    </Example.description>
                    <CheckboxGroupLabelingDemo />
                </Example>
                <Example title="Rendering as a native button" source="CheckboxGroupNativeButtonDemo">
                    <Example.description>
                        <p>By default, <code>Checkbox</code> renders a <code>&lt;span&gt;</code> element to support enclosing labels. Prefer rendering each checkbox as a native button with <code>nativeButton</code> when using sibling labels (<code>for</code>/<code>id</code>).</p>
                    </Example.description>
                    <CheckboxGroupNativeButtonDemo />
                </Example>
                <Example title="Form integration" source="CheckboxGroupFormDemo">
                    <Example.description>
                        <p>Use <a href="/components/field" className="underline">Field</a> and <a href="/components/fieldset" className="underline">Fieldset</a> for group labeling and form integration.</p>
                    </Example.description>
                    <CheckboxGroupFormDemo />
                </Example>
                <Example title="Parent checkbox" source="CheckboxGroupParentDemo">
                    <Example.description>
                        <p>A checkbox that controls other checkboxes within a <code>CheckboxGroup</code> can be created:</p>
                        <ol className="list-decimal pl-6">
                            <li>Pass an array of all the child checkbox values to the <code>allValues</code> prop on the <code>CheckboxGroup</code> component</li>
                            <li>Add the <code>parent</code> boolean prop to the parent <code>Checkbox</code></li>
                        </ol>
                        <p>The group controls the parent checkbox’s <a href="/components/checkbox" className="underline">indeterminate</a> state when some, but not all, child checkboxes are checked.</p>
                    </Example.description>
                    <CheckboxGroupParentDemo />
                </Example>
                <Example title="Nested parent checkbox" source="CheckboxGroupNestedDemo">
                    <Example.description>
                        <p>A <code>CheckboxGroup</code> with a <code>value</code> inside another group is an item of that group: the outer parent checks all its checkboxes, and is indeterminate when some of them are checked.</p>
                    </Example.description>
                    <CheckboxGroupNestedDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}
