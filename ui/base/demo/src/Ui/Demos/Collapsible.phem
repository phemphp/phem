<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\{CollapsiblePanel, CollapsibleTrigger};
use Phem\Ui\Base\Collapsible;

#[Page('/components/collapsible')]
function CollapsiblePage(): Node
{
    return (
        <DemoPage slug="collapsible">
            <Hero>
                <Collapsible>
                    <CollapsibleTrigger>Recovery keys</CollapsibleTrigger>
                    <CollapsiblePanel>
                        <div className="flex flex-col gap-2 px-3.5 py-2">
                            <div>alien-bean-pasta</div>
                            <div>wild-irish-burrito</div>
                            <div>horse-battery-staple</div>
                        </div>
                    </CollapsiblePanel>
                </Collapsible>
            </Hero>
        </DemoPage>
    );
}
