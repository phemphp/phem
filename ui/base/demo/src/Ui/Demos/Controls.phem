<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\{Avatar, AvatarFallback, AvatarImage, CheckboxIndicator, RadioIndicator, SwitchThumb, Toggle, ToolbarButton, ToolbarGroup, ToolbarLink, ToolbarSeparator, SelectIcon, SelectItem, SelectItemIndicator, SelectItemText, SelectList, SelectPopup, SelectTrigger, SelectValue};
use Phem\Ui\Base\{Checkbox, CheckboxGroup, Radio, RadioGroup, Select, SwitchRoot, ToggleGroup, Toolbar};

#[Page('/components/toggle')]
function TogglePage(): Node
{
    return (
        <DemoPage slug="toggle"><Hero>
            <Toggle aria-label="Favorite">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" className="hidden group-data-pressed:block"><path d="M7.99961 13.8667C7.88761 13.8667 7.77561 13.8315 7.68121 13.7611C7.43321 13.5766 1.59961 9.1963 1.59961 5.8667C1.59961 3.80856 3.27481 2.13336 5.33294 2.13336C6.59054 2.13336 7.49934 2.81176 7.99961 3.3131C8.49988 2.81176 9.40868 2.13336 10.6663 2.13336C12.7244 2.13336 14.3996 3.80803 14.3996 5.8667C14.3996 9.1963 8.56601 13.5766 8.31801 13.7616C8.22361 13.8315 8.11161 13.8667 7.99961 13.8667Z" /></svg>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" className="block group-data-pressed:hidden"><path fill-rule="evenodd" clip-rule="evenodd" d="m7.99961 4.8232-.75505-.75666c-.40333-.40419-1.0559-.86651-1.91162-.86651-1.46903 0-2.66666 1.19764-2.66666 2.66667 0 .5412.24648 1.2356.75339 2.04713.49581.79376 1.17682 1.59861 1.89311 2.33647 1.06989 1.1022 2.1604 1.9962 2.68705 2.4102.52751-.4149 1.61735-1.3085 2.68657-2.4101.7163-.73792 1.3973-1.54278 1.8932-2.33656.5069-.81154.7533-1.50594.7533-2.04714 0-1.46947-1.1975-2.66667-2.6666-2.66667-.85574 0-1.50831.46232-1.91164.86651zm-.01387-1.52394c-.5031-.49988-1.40673-1.1659-2.6528-1.1659-2.05813 0-3.73333 1.6752-3.73333 3.73334 0 3.3296 5.8336 7.7099 6.0816 7.8944a.532.532 0 0 0 .3184.1056c.112 0 .224-.0352.3184-.1051.248-.185 6.08159-4.5653 6.08159-7.8949 0-2.05867-1.6752-3.73334-3.7333-3.73334-1.24617 0-2.14985.66611-2.65293 1.166q-.0069.00686-.0137.01367c.00002-.00003-.00002.00002 0 0-.00459-.0046-.00927-.00914-.01393-.01377" /></svg>
            </Toggle>
        </Hero></DemoPage>
    );
}

#[Page('/components/switch')]
function SwitchPage(): Node
{
    return (
        <DemoPage slug="switch"><Hero>
            <label className="flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white">
                <SwitchRoot defaultChecked><SwitchThumb /></SwitchRoot>
                Notifications
            </label>
        </Hero></DemoPage>
    );
}

#[Page('/components/checkbox')]
function CheckboxPage(): Node
{
    return (
        <DemoPage slug="checkbox"><Hero>
            <label className="flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white">
                <Checkbox defaultChecked><CheckboxIndicator /></Checkbox>
                Enable notifications
            </label>
        </Hero></DemoPage>
    );
}

#[Page('/components/checkbox-group')]
function CheckboxGroupPage(): Node
{
    $apples = ['fuji-apple' => 'Fuji', 'gala-apple' => 'Gala', 'granny-smith-apple' => 'Granny Smith'];
    $label = 'flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white';

    return (
        <DemoPage slug="checkbox-group"><Hero>
            <CheckboxGroup aria-labelledby="apples-caption" defaultValue={{ ['fuji-apple'] }}>
                <div className="text-sm font-bold" id="apples-caption">Apples</div>
                {% for value, name in apples %}
                    <label key={{ value }} className={{ label }}><Checkbox name="apple" value={{ value }}><CheckboxIndicator /></Checkbox>{{ name }}</label>
                {% endfor %}
            </CheckboxGroup>
        </Hero></DemoPage>
    );
}

#[Page('/components/radio-group')]
function RadioGroupPage(): Node
{
    $apples = ['fuji-apple' => 'Fuji', 'gala-apple' => 'Gala', 'granny-smith-apple' => 'Granny Smith'];
    $label = 'flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white';

    return (
        <DemoPage slug="radio-group"><Hero>
            <RadioGroup aria-labelledby="best-apple" defaultValue="fuji-apple" name="apple">
                <div className="text-sm font-bold" id="best-apple">Best apple</div>
                {% for value, name in apples %}
                    <label key={{ value }} className={{ label }}><Radio value={{ value }}><RadioIndicator /></Radio>{{ name }}</label>
                {% endfor %}
            </RadioGroup>
        </Hero></DemoPage>
    );
}

#[Page('/components/toggle-group')]
function ToggleGroupPage(): Node
{
    return (
        <DemoPage slug="toggle-group"><Hero>
            <ToggleGroup aria-label="Text alignment" defaultValue={{ ['left'] }}>
                <Toggle aria-label="Align left" value="left"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" className="block"><path stroke-linecap="square" stroke-linejoin="round" d="M2.5 4.5h11m-11 7h9M2.5 8h5" /></svg></Toggle>
                <Toggle aria-label="Align center" value="center"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" className="block"><path stroke-linecap="square" stroke-linejoin="round" d="M2.5 4.5h11m-10 7h9M5.5 8h5" /></svg></Toggle>
                <Toggle aria-label="Align right" value="right"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" className="block"><path stroke-linecap="square" stroke-linejoin="round" d="M2.5 4.5h11m-9 7h9M8.5 8h5" /></svg></Toggle>
            </ToggleGroup>
        </Hero></DemoPage>
    );
}

#[Page('/components/toolbar')]
function ToolbarPage(): Node
{
    return (
        <DemoPage slug="toolbar"><Hero>
            <Toolbar className="w-150">
                <ToggleGroup aria-label="Alignment">
                    <Toggle aria-label="Align left" value="align-left">Align Left</Toggle>
                    <Toggle aria-label="Align right" value="align-right">Align Right</Toggle>
                </ToggleGroup>
                <ToolbarSeparator />
                <ToolbarGroup aria-label="Numerical format">
                    <ToolbarButton aria-label="Format as currency" className="px-0">$</ToolbarButton>
                    <ToolbarButton aria-label="Format as percent" className="px-0">%</ToolbarButton>
                </ToolbarGroup>
                <ToolbarSeparator />
                <Select defaultValue="Helvetica" sideOffset={{ 4 }}>
                    <SelectTrigger><SelectValue /><SelectIcon /></SelectTrigger>
                    <SelectPopup>
                        <SelectList>
                            <SelectItem value="Helvetica"><SelectItemIndicator /><SelectItemText>Helvetica</SelectItemText></SelectItem>
                            <SelectItem value="Arial"><SelectItemIndicator /><SelectItemText>Arial</SelectItemText></SelectItem>
                        </SelectList>
                    </SelectPopup>
                </Select>
                <ToolbarSeparator />
                <ToolbarLink href="#">Edited 51m ago</ToolbarLink>
            </Toolbar>
        </Hero></DemoPage>
    );
}

#[Page('/components/avatar')]
function AvatarPage(): Node
{
    return (
        <DemoPage slug="avatar"><Hero>
            <div className="flex gap-4">
                <Avatar delay={{ 600 }}>
                    <AvatarImage src="https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80" width="48" height="48" />
                    <AvatarFallback>LT</AvatarFallback>
                </Avatar>
                <Avatar>LT</Avatar>
            </div>
        </Hero></DemoPage>
    );
}
