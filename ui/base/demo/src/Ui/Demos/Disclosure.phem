<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\{AccordionHeader, AccordionPanel, AccordionTrigger, CollapsiblePanel, CollapsibleTrigger, TabsIndicator, TabsList, TabsPanel, TabsTab};
use Phem\Ui\Base\{Accordion, AccordionItem, Collapsible, Tabs};

#[Page('/components/accordion')]
function AccordionPage(): Node
{
    return (
        <DemoPage slug="accordion"><Hero>
            <Accordion>
                <AccordionItem value="what">
                    <AccordionHeader><AccordionTrigger>What is Base UI?</AccordionTrigger></AccordionHeader>
                    <AccordionPanel>Base UI is a library of high-quality unstyled React components for design systems and web apps.</AccordionPanel>
                </AccordionItem>
                <AccordionItem value="start">
                    <AccordionHeader><AccordionTrigger>How do I get started?</AccordionTrigger></AccordionHeader>
                    <AccordionPanel>Head to the “Quick start” guide in the docs. If you’ve used unstyled libraries before, you’ll feel at home.</AccordionPanel>
                </AccordionItem>
                <AccordionItem value="use">
                    <AccordionHeader><AccordionTrigger>Can I use it for my project?</AccordionTrigger></AccordionHeader>
                    <AccordionPanel>Of course! Base UI is free and open source.</AccordionPanel>
                </AccordionItem>
            </Accordion>
        </Hero></DemoPage>
    );
}

#[Page('/components/collapsible')]
function CollapsiblePage(): Node
{
    return (
        <DemoPage slug="collapsible"><Hero>
            <Collapsible>
                <CollapsibleTrigger>Recovery keys</CollapsibleTrigger>
                <CollapsiblePanel>
                    <div className="flex flex-col gap-2 px-3.5 py-2">
                        <div>alien-bean-pasta</div>
                        <div>wild-irish-burrito</div>
                        <div>horse-battery-staple</div>
                    </div>
                </CollapsiblePanel>
            </Collapsible>
        </Hero></DemoPage>
    );
}

#[Page('/components/tabs')]
function TabsPage(): Node
{
    return (
        <DemoPage slug="tabs"><Hero>
            <Tabs defaultValue="overview">
                <TabsList>
                    <TabsTab value="overview">Overview</TabsTab>
                    <TabsTab value="projects">Projects</TabsTab>
                    <TabsTab value="account">Account</TabsTab>
                    <TabsIndicator />
                </TabsList>
                <div className="grid w-full min-h-32 grid-cols-1 border border-neutral-950 dark:border-white">
                    <TabsPanel value="overview"><p>Workspace stats and activity.</p></TabsPanel>
                    <TabsPanel value="projects"><p>Milestones and deadlines.</p></TabsPanel>
                    <TabsPanel value="account"><p>Profile and preferences.</p></TabsPanel>
                </div>
            </Tabs>
        </Hero></DemoPage>
    );
}
