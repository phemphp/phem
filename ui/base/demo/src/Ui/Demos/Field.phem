use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\Examples\FieldHeroDemo;

#[Page('/components/field')]
function FieldPage(): Node
{
    return (
        <DemoPage slug="field">
            <Hero source="FieldHeroDemo">
                <FieldHeroDemo />
            </Hero>
        </DemoPage>
    );
}
