<?phem

namespace App\Ui\Demos;

use Phem\Attribute\{Page, State};
use Phem\{Event, Node};

use function App\Ui\DemoPage;
use function Phem\Ui\Base\{FieldControl, FieldDescription, FieldError, FieldLabel, Form, NumberField, NumberFieldDecrement, NumberFieldGroup, NumberFieldIncrement, NumberFieldInput, NumberFieldScrubArea, NumberFieldScrubAreaCursor, OTPField, OTPFieldInput, SliderControl, SliderIndicator, SliderThumb, SliderTrack};
use Phem\Ui\Base\{Button, Field, Slider};

#[Page('/components/field')]
function FieldPage(): Node
{
    return (
        <DemoPage title="Field">
            <Field id="name">
                <FieldLabel>Name</FieldLabel>
                <FieldControl required placeholder="Required" />
                <FieldError match="valueMissing">Please enter your name</FieldError>
                <FieldDescription>Visible on your profile</FieldDescription>
            </Field>
        </DemoPage>
    );
}

// The submit of the Base UI demo: the server answers after 1 second, and refuses the example
// domain. The error of the server shows in the Field.Error of the field. While the request runs,
// phem locks the button with `aria-disabled="true"`, and the button has the disabled look.
#[Page('/components/form')]
final class FormPage
{
    #[State] public string $url = 'https://example.com';
    #[State] public ?string $error = null;

    public function submit(Event $e): void
    {
        $this->url = (string) ($e->form['url'] ?? '');
        sleep(1);

        $host = parse_url($this->url, \PHP_URL_HOST);
        $this->error = match (true) {
            !\is_string($host) || '' === $host => 'This is not a valid URL',
            str_ends_with($host, 'example.com') => 'The example domain is not allowed',
            default => null,
        };
    }

    public function render(): Node
    {
        return (
            <DemoPage title="Form">
                <Form onSubmit={{ submit }} className="[&_button[aria-disabled=true]]:pointer-events-none [&_button[aria-disabled=true]]:border-neutral-500 [&_button[aria-disabled=true]]:text-neutral-500 dark:[&_button[aria-disabled=true]]:border-neutral-400 dark:[&_button[aria-disabled=true]]:text-neutral-400">
                    <Field id="url">
                        <FieldLabel>Homepage</FieldLabel>
                        <FieldControl
                            type="url"
                            name="url"
                            required
                            defaultValue={{ url }}
                            placeholder="https://example.com"
                            pattern="https?://.*"
                            aria-invalid={{ error ? 'true' : null }}
                            aria-describedby={{ error ? 'url-error' : null }}
                        />
                        <FieldError>{{ error }}</FieldError>
                    </Field>
                    <Button type="submit">Submit</Button>
                </Form>
            </DemoPage>
        );
    }
}

#[Page('/components/number-field')]
function NumberFieldPage(): Node
{
    return (
        <DemoPage title="Number Field">
            <NumberField defaultValue={{ 100 }}>
                <NumberFieldScrubArea>
                    <label htmlFor="amount" className="cursor-ew-resize text-sm font-bold text-neutral-950 dark:text-white">Amount</label>
                    <NumberFieldScrubAreaCursor />
                </NumberFieldScrubArea>
                <NumberFieldGroup>
                    <NumberFieldDecrement />
                    <NumberFieldInput id="amount" />
                    <NumberFieldIncrement />
                </NumberFieldGroup>
            </NumberField>
        </DemoPage>
    );
}

#[Page('/components/otp-field')]
function OTPFieldPage(): Node
{
    $slots = range(1, 6);

    return (
        <DemoPage title="OTP Field">
            <div className="flex w-full max-w-80 flex-col items-start gap-1">
                <label htmlFor="otp-1" className="text-sm font-bold text-neutral-950 dark:text-white">Verification code</label>
                <OTPField name="code" aria-describedby="otp-description">
                    {% for i in slots %}<OTPFieldInput key={{ i }} id={{ i == 1 ? 'otp-1' : null }} />{% endfor %}
                </OTPField>
                <p id="otp-description" className="m-0 text-sm text-neutral-600 dark:text-neutral-400">Enter the 6-character code we sent to your device.</p>
            </div>
        </DemoPage>
    );
}

#[Page('/components/slider')]
function SliderPage(): Node
{
    return (
        <DemoPage title="Slider">
            <Slider defaultValue={{ 25 }}>
                <SliderControl>
                    <SliderTrack>
                        <SliderIndicator />
                        <SliderThumb aria-label="Volume" />
                    </SliderTrack>
                </SliderControl>
            </Slider>
        </DemoPage>
    );
}
