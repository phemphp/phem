<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\{MenuItem, MenuPopup, MenuSeparator, MenuSubmenuTrigger, MenuTrigger, NavigationMenuArrow, NavigationMenuContent, NavigationMenuIcon, NavigationMenuItem, NavigationMenuLink, NavigationMenuList, NavigationMenuPopup, NavigationMenuPositioner, NavigationMenuTrigger, NavigationMenuViewport, ScrollArea, ScrollAreaContent, ScrollAreaScrollbar, ScrollAreaThumb, ScrollAreaViewport, SelectIcon, SelectItem, SelectItemIndicator, SelectItemText, SelectLabel, SelectList, SelectPopup, SelectScrollDownArrow, SelectScrollUpArrow, SelectTrigger, SelectValue};
use Phem\Ui\Base\{Menu, Menubar, MenuSubmenu, NavigationMenu, Select};

#[Page('/components/scroll-area')]
function ScrollAreaPage(): Node
{
    return (
        <DemoPage slug="scroll-area"><Hero>
            <ScrollArea>
                <ScrollAreaViewport>
                    <ScrollAreaContent>
                        <p>Vernacular architecture is building done outside any academic tradition, and without professional guidance. It is not a particular architectural movement or style, but rather a broad category, encompassing a wide range and variety of building types, with differing methods of construction, from around the world, both historical and extant and classical and modern. Vernacular architecture constitutes 95% of the world's built environment, as estimated in 1995 by Amos Rapoport, as measured against the small percentage of new buildings every year designed by architects and built by engineers.</p>
                        <p>This type of architecture usually serves immediate, local needs, is constrained by the materials available in its particular region and reflects local traditions and cultural practices. The study of vernacular architecture does not examine formally schooled architects, but instead that of the design skills and tradition of local builders, who were rarely given any attribution for the work. More recently, vernacular architecture has been examined by designers and the building industry in an effort to be more energy conscious with contemporary design and construction—part of a broader interest in sustainable design.</p>
                    </ScrollAreaContent>
                </ScrollAreaViewport>
                <ScrollAreaScrollbar><ScrollAreaThumb /></ScrollAreaScrollbar>
            </ScrollArea>
        </Hero></DemoPage>
    );
}

#[Page('/components/select')]
function SelectPage(): Node
{
    $apples = ['gala' => 'Gala', 'fuji' => 'Fuji', 'honeycrisp' => 'Honeycrisp', 'granny-smith' => 'Granny Smith', 'pink-lady' => 'Pink Lady'];

    return (
        <DemoPage slug="select"><Hero>
            <Select id="apple" name="apple" sideOffset={{ 4 }}>
                <SelectLabel>Apple</SelectLabel>
                <SelectTrigger><SelectValue placeholder="Select apple" /><SelectIcon /></SelectTrigger>
                <SelectPopup>
                    <SelectScrollUpArrow />
                    <SelectList>
                        {% for value, name in apples %}
                            <SelectItem key={{ value }} value={{ value }}><SelectItemIndicator /><SelectItemText>{{ name }}</SelectItemText></SelectItem>
                        {% endfor %}
                    </SelectList>
                    <SelectScrollDownArrow />
                </SelectPopup>
            </Select>
        </Hero></DemoPage>
    );
}

#[Page('/components/menubar')]
function MenubarPage(): Node
{
    return (
        <DemoPage slug="menubar"><Hero>
            <Menubar>
                <Menu sideOffset={{ 4 }}>
                    <MenuTrigger>File</MenuTrigger>
                    <MenuPopup>
                        <MenuItem>New</MenuItem>
                        <MenuItem>Open</MenuItem>
                        <MenuItem>Save</MenuItem>
                        <MenuSubmenu sideOffset={{ -4 }} alignOffset={{ -4 }}>
                            <MenuSubmenuTrigger>Export</MenuSubmenuTrigger>
                            <MenuPopup><MenuItem>PDF</MenuItem><MenuItem>PNG</MenuItem><MenuItem>SVG</MenuItem></MenuPopup>
                        </MenuSubmenu>
                        <MenuSeparator />
                        <MenuItem>Print</MenuItem>
                    </MenuPopup>
                </Menu>
                <Menu sideOffset={{ 4 }}>
                    <MenuTrigger>Edit</MenuTrigger>
                    <MenuPopup><MenuItem>Cut</MenuItem><MenuItem>Copy</MenuItem><MenuItem>Paste</MenuItem></MenuPopup>
                </Menu>
                <Menu sideOffset={{ 4 }}>
                    <MenuTrigger>View</MenuTrigger>
                    <MenuPopup>
                        <MenuItem>Zoom In</MenuItem>
                        <MenuItem>Zoom Out</MenuItem>
                        <MenuSubmenu sideOffset={{ -4 }} alignOffset={{ -4 }}>
                            <MenuSubmenuTrigger>Layout</MenuSubmenuTrigger>
                            <MenuPopup><MenuItem>Single Page</MenuItem><MenuItem>Two Pages</MenuItem><MenuItem>Continuous</MenuItem></MenuPopup>
                        </MenuSubmenu>
                        <MenuSeparator />
                        <MenuItem>Full Screen</MenuItem>
                    </MenuPopup>
                </Menu>
                <Menu disabled><MenuTrigger>Help</MenuTrigger></Menu>
            </Menubar>
        </Hero></DemoPage>
    );
}

#[Page('/components/navigation-menu')]
function NavigationMenuPage(): Node
{
    $overview = [
        ['/quick-start', 'Quick Start', 'Install and assemble your first component.'],
        ['/accessibility', 'Accessibility', 'Learn how we build accessible components.'],
        ['/releases', 'Releases', 'See what’s new in the latest Base UI versions.'],
        ['/about', 'About', 'Learn more about Base UI and our mission.'],
    ];
    $handbook = [
        ['/styling', 'Styling', 'Base UI components can be styled with plain CSS, Tailwind CSS, CSS-in-JS, or CSS Modules.'],
        ['/animation', 'Animation', 'Base UI components can be animated with CSS transitions, CSS animations, or JavaScript libraries.'],
        ['/composition', 'Composition', 'Base UI components can be replaced and composed with your own existing components.'],
    ];

    return (
        <DemoPage slug="navigation-menu"><Hero>
            <NavigationMenu collisionPaddingInline={{ 20 }} flip={{ false }}>
                <NavigationMenuList>
                    <NavigationMenuItem value="overview">
                        <NavigationMenuTrigger>Overview <NavigationMenuIcon /></NavigationMenuTrigger>
                        <NavigationMenuContent>
                            <ul className="m-0 grid list-none grid-cols-2 p-0 max-[500px]:grid-cols-1">
                                {% for link in overview %}
                                    <li key={{ link[0] }}><NavigationMenuLink href={{ link[0] }} card><h3 className="m-0 mb-1 text-sm leading-4 font-normal">{{ link[1] }}</h3><p className="m-0 text-sm text-neutral-500 dark:text-neutral-400">{{ link[2] }}</p></NavigationMenuLink></li>
                                {% endfor %}
                            </ul>
                        </NavigationMenuContent>
                    </NavigationMenuItem>
                    <NavigationMenuItem value="handbook">
                        <NavigationMenuTrigger>Handbook <NavigationMenuIcon /></NavigationMenuTrigger>
                        <NavigationMenuContent>
                            <ul className="m-0 flex max-w-[400px] list-none flex-col justify-center p-0">
                                {% for link in handbook %}
                                    <li key={{ link[0] }}><NavigationMenuLink href={{ link[0] }} card><h3 className="m-0 mb-1 text-sm leading-4 font-normal">{{ link[1] }}</h3><p className="m-0 text-sm text-neutral-500 dark:text-neutral-400">{{ link[2] }}</p></NavigationMenuLink></li>
                                {% endfor %}
                            </ul>
                        </NavigationMenuContent>
                    </NavigationMenuItem>
                    <NavigationMenuItem><NavigationMenuLink href="https://github.com/mui/base-ui">GitHub</NavigationMenuLink></NavigationMenuItem>
                </NavigationMenuList>
                <NavigationMenuPositioner>
                    <NavigationMenuPopup>
                        <NavigationMenuArrow />
                        <NavigationMenuViewport />
                    </NavigationMenuPopup>
                </NavigationMenuPositioner>
            </NavigationMenu>
        </Hero></DemoPage>
    );
}
