/** Multiple triggers: two detached triggers, and a content for each payload. */
#[Component]
function MenuMultipleDemo(): Node
{
    return (
        <div className="flex gap-2">
            <MenuTrigger handle="multiple-menu" payload="file">File</MenuTrigger>
            <MenuTrigger handle="multiple-menu" payload="edit">Edit</MenuTrigger>
            <Menu handle="multiple-menu" sideOffset={{ 8 }}>
                <MenuPopup>
                    <MenuViewport>
                        <MenuPayload name="file">
                            <MenuItem>New</MenuItem>
                            <MenuItem>Open</MenuItem>
                            <MenuItem>Save</MenuItem>
                        </MenuPayload>
                        <MenuPayload name="edit">
                            <MenuItem>Undo</MenuItem>
                            <MenuItem>Redo</MenuItem>
                            <MenuItem>Cut</MenuItem>
                            <MenuItem>Copy</MenuItem>
                            <MenuItem>Paste</MenuItem>
                        </MenuPayload>
                    </MenuViewport>
                </MenuPopup>
            </Menu>
        </div>
    );
}

/**
 * Controlled mode: three triggers in the root, and a button that opens the menu for
 * the second one.
 */
#[Component]
function MenuControlledDemo(): Node
{
    $menus = MENU_CONTROLLED;

    return (
        <Menu sideOffset={{ 8 }}>
            <div className="flex flex-wrap justify-center gap-2">
                <MenuTrigger id="menu-trigger-1" payload="library" caret={{ false }} className="px-3">Library</MenuTrigger>
                <MenuTrigger id="menu-trigger-2" payload="playback" caret={{ false }} className="px-3">Playback</MenuTrigger>
                <MenuTrigger id="menu-trigger-3" payload="share" caret={{ false }} className="px-3">Share</MenuTrigger>
                <button type="button" data-action="phem-menu#open" data-phem-menu-trigger-id-param="menu-trigger-2" className="flex h-8 items-center justify-center border border-neutral-950 dark:border-white bg-white dark:bg-neutral-950 px-3 text-sm text-neutral-950 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:outline-2 focus-visible:-outline-offset-1 focus-visible:outline-neutral-950 dark:focus-visible:outline-white">Open playback (controlled)</button>
            </div>
            <MenuPopup>
                <MenuViewport>
                    {% for name, items in menus %}
                        <MenuPayload key={{ name }} name={{ name }}>
                            {% for item in items %}
                                <MenuItem key={{ item }}>{{ item }}</MenuItem>
                            {% endfor %}
                        </MenuPayload>
                    {% endfor %}
                </MenuViewport>
            </MenuPopup>
        </Menu>
    );
}

