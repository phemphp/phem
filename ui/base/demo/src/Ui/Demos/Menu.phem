/** Open a dialog: the item is a detached trigger of the dialog. */
#[Component]
function MenuDialogDemo(): Node
{
    return (
        <div>
            <Menu sideOffset={{ 8 }}>
                <MenuTrigger>Open menu</MenuTrigger>
                <MenuPopup>
                    <MenuItem data-phem-dialog-for="menu-dialog">Open dialog</MenuItem>
                </MenuPopup>
            </Menu>
            <Dialog handle="menu-dialog">
                <DialogPopup>
                    <div className="flex flex-col gap-1">
                        <DialogTitle>Dialog from a menu</DialogTitle>
                        <DialogDescription>The menu item opened this dialog.</DialogDescription>
                    </div>
                    <div className="flex justify-end gap-3">
                        <DialogClose>Close</DialogClose>
                    </div>
                </DialogPopup>
            </Dialog>
        </div>
    );
}

