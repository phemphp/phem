<?phem

namespace App\Ui\Demos;

use Phem\Attribute\{Component, Page};
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\{MeterIndicator, MeterLabel, MeterTrack, MeterValue};
use Phem\Ui\Base\Meter;

#[Page('/components/meter')]
function MeterPage(): Node
{
    return (
        <DemoPage slug="meter">
            <Hero source="MeterHeroDemo">
                <MeterHeroDemo />
            </Hero>
        </DemoPage>
    );
}

#[Component]
function MeterHeroDemo(): Node
{
    return (
        <Meter id="storage" value={{ 24 }}>
            <MeterLabel>Storage Used</MeterLabel>
            <MeterValue />
            <MeterTrack><MeterIndicator /></MeterTrack>
        </Meter>
    );
}
