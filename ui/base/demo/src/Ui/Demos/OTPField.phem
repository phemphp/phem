<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\Examples\{OTPFieldAlphanumericDemo, OTPFieldFormDemo, OTPFieldGroupedDemo, OTPFieldHeroDemo, OTPFieldLabelingDemo, OTPFieldMaskDemo, OTPFieldNormalizeDemo, OTPFieldPlaceholderDemo};

#[Page('/components/otp-field')]
function OTPFieldPage(): Node
{
    return (
        <DemoPage slug="otp-field">
            <Hero source="OTPFieldHeroDemo">
                <OTPFieldHeroDemo />
            </Hero>
            <Examples>
                <Example title="Labeling an OTP field" source="OTPFieldLabelingDemo">
                    <Example.description>
                        <p>Give an <code>id</code> to the first <code>OTPFieldInput</code> and use a native <code>&lt;label&gt;</code> with a matching <code>for</code>. Let the first input use the field label: the other inputs get <code>aria-label="Character 2 of 6"</code> and so on, so assistive technology can announce which slot is focused.</p>
                        <p>Optionally, add <code>aria-describedby</code> when supporting text should be announced with the field.</p>
                    </Example.description>
                    <OTPFieldLabelingDemo />
                </Example>
                <Example title="Form integration" source="OTPFieldFormDemo">
                    <Example.description>
                        <p>Use <a href="/components/field" className="underline">Field</a> to handle label associations and form integration.</p>
                        <p>Pass <code>autoSubmit</code> to submit the owning form automatically when all slots are filled, or listen to <code>phem-otp-field:complete</code> to react to completion without submitting.</p>
                    </Example.description>
                    <OTPFieldFormDemo />
                </Example>
                <Example title="Alphanumeric verification codes" source="OTPFieldAlphanumericDemo">
                    <Example.description>
                        <p>Use <code>validationType="alphanumeric"</code> for recovery, backup, or invite codes that mix letters and numbers.</p>
                    </Example.description>
                    <OTPFieldAlphanumericDemo />
                </Example>
                <Example title="Grouped layouts" source="OTPFieldGroupedDemo">
                    <Example.description>
                        <p>Wrap subsets of inputs in your own layout elements and use <code>OTPFieldSeparator</code> when you want the code presented in smaller visual chunks such as <code>123-456</code>.</p>
                    </Example.description>
                    <OTPFieldGroupedDemo />
                </Example>
                <Example title="Placeholder hints" source="OTPFieldPlaceholderDemo">
                    <Example.description>
                        <p><code>OTPFieldInput</code> is a real input, so native <code>placeholder</code> props and CSS work as usual. This example keeps placeholder hints visible until the active slot receives focus.</p>
                    </Example.description>
                    <OTPFieldPlaceholderDemo />
                </Example>
                <Example title="Custom normalization" source="OTPFieldNormalizeDemo">
                    <Example.description>
                        <p>Use <code>normalize</code> (<code>uppercase</code> or <code>lowercase</code>) to normalize accepted values before state updates, such as converting alphanumeric codes to uppercase. It runs after <code>validationType</code> filtering, and the result is filtered against <code>validationType</code> again.</p>
                        <p>A refused character sends <code>phem-otp-field:invalid</code>.</p>
                    </Example.description>
                    <OTPFieldNormalizeDemo />
                </Example>
                <Example title="Masked entry" source="OTPFieldMaskDemo">
                    <Example.description>
                        <p>Use <code>mask</code> when the code should be obscured while it is being typed.</p>
                    </Example.description>
                    <OTPFieldMaskDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}
