#[Page('/components/combobox')]
function ComboboxPage(): Node
{
    $fruits = FRUITS;

    return (
        <DemoPage slug="combobox"><Hero>
            <Combobox id="fruit" filter="contains">
                <ComboboxLabel>Choose a fruit</ComboboxLabel>
                <ComboboxInputGroup>
                    <ComboboxInput placeholder="e.g. Apple" />
                    <ComboboxActions>
                        <ComboboxClear aria-label="Clear selection" />
                        <ComboboxTrigger aria-label="Open popup" />
                    </ComboboxActions>
                </ComboboxInputGroup>
                <ComboboxPopup>
                    <ComboboxEmpty>No fruits found.</ComboboxEmpty>
                    <ComboboxList>
                        {% for value, label in fruits %}
                            <ComboboxItem key={{ value }} value={{ value }}>
                                <ComboboxItemIndicator />
                                <ComboboxItemLabel>{{ label }}</ComboboxItemLabel>
                            </ComboboxItem>
                        {% endfor %}
                    </ComboboxList>
                </ComboboxPopup>
            </Combobox>
        </Hero></DemoPage>
    );
}

// The browser filters the tags, as the Base UI demo does. The popup has no animation.
#[Page('/components/autocomplete')]
function AutocompletePage(): Node
{
    $tags = TAGS;

    return (
        <DemoPage slug="autocomplete"><Hero>
            <Autocomplete id="tags" filter="contains">
                <ComboboxLabel>Search tags</ComboboxLabel>
                <ComboboxInput placeholder="e.g. feature" className="h-8 w-[16rem] border border-neutral-950 px-2 placeholder:opacity-100 placeholder:[-webkit-text-fill-color:var(--color-neutral-500)] dark:placeholder:[-webkit-text-fill-color:var(--color-neutral-400)] focus:outline-solid focus:outline-2 focus:-outline-offset-1 focus:outline-neutral-950 dark:border-white dark:focus:outline-white" />
                <ComboboxPopup>
                    <ComboboxEmpty>No tags found.</ComboboxEmpty>
                    <ComboboxList className="scroll-py-[0.25rem]">
                        {% for id, tag in tags %}
                            <ComboboxItem key={{ id }} value={{ id }} className="flex">{{ tag }}</ComboboxItem>
                        {% endfor %}
                    </ComboboxList>
                </ComboboxPopup>
            </Autocomplete>
        </Hero></DemoPage>
    );
}

#[Page('/components/toast')]
final class ToastPage
{
    #[State] public int $count = 0;

    public function create(Event $e): void
    {
        ++$this->count;
        $e->toast('This is a toast notification.', title: 'Toast '.$this->count.' created');
    }

    public function render(): Node
    {
        return (
            <DemoPage slug="toast"><Hero>
                <Button onClick={{ create }}>Create toast</Button>
                <ToastViewport />
            </Hero></DemoPage>
        );
    }
}
