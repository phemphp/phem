<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\Examples\{RadioGroupFormDemo, RadioGroupHeroDemo, RadioGroupLabelingDemo, RadioGroupNativeButtonDemo};

#[Page('/components/radio-group')]
function RadioGroupPage(): Node
{
    return (
        <DemoPage slug="radio-group">
            <Hero source="RadioGroupHeroDemo">
                <RadioGroupHeroDemo />
            </Hero>
            <Examples>
                <Example title="Labeling a radio group" source="RadioGroupLabelingDemo">
                    <Example.description>
                        <p>Label the group with <code>aria-labelledby</code> and a sibling label element. An enclosing <code>&lt;label&gt;</code> is the simplest labeling pattern for each radio.</p>
                    </Example.description>
                    <RadioGroupLabelingDemo />
                </Example>
                <Example title="Rendering as a native button" source="RadioGroupNativeButtonDemo">
                    <Example.description>
                        <p>By default, <code>Radio</code> renders a <code>&lt;span&gt;</code> element to support enclosing labels. Prefer rendering each radio as a native button with <code>nativeButton</code> when using sibling labels (<code>for</code>/<code>id</code>).</p>
                    </Example.description>
                    <RadioGroupNativeButtonDemo />
                </Example>
                <Example title="Form integration" source="RadioGroupFormDemo">
                    <Example.description>
                        <p>Use <a href="/components/field" className="underline">Field</a> and <a href="/components/fieldset" className="underline">Fieldset</a> for group labeling and form integration.</p>
                    </Example.description>
                    <RadioGroupFormDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}
