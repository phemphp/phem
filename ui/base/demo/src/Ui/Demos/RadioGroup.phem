<?phem

namespace App\Ui\Demos;

use Phem\Attribute\{Component, Page};
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\{FieldItem, FieldLabel, FieldsetLegend, Form, RadioIndicator};
use Phem\Ui\Base\{Field, Fieldset, Radio, RadioGroup};

const STORAGE_TYPES = ['ssd' => 'SSD', 'hdd' => 'HDD'];

#[Page('/components/radio-group')]
function RadioGroupPage(): Node
{
    $apples = ['fuji-apple' => 'Fuji', 'gala-apple' => 'Gala', 'granny-smith-apple' => 'Granny Smith'];
    $label = 'flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white';

    return (
        <DemoPage slug="radio-group">
            <Hero>
                <RadioGroup aria-labelledby="best-apple" defaultValue="fuji-apple" name="apple">
                    <div className="text-sm font-bold" id="best-apple">Best apple</div>
                    {% for value, name in apples %}
                        <label key={{ value }} className={{ label }}><Radio value={{ value }}><RadioIndicator /></Radio>{{ name }}</label>
                    {% endfor %}
                </RadioGroup>
            </Hero>
            <Examples>
                <Example title="Labeling a radio group">
                    <Example.description>
                        <p>Label the group with <code>aria-labelledby</code> and a sibling label element. An enclosing <code>&lt;label&gt;</code> is the simplest labeling pattern for each radio.</p>
                    </Example.description>
                    <RadioGroupLabelingDemo />
                </Example>
                <Example title="Rendering as a native button">
                    <Example.description>
                        <p>By default, <code>Radio</code> renders a <code>&lt;span&gt;</code> element to support enclosing labels. Prefer rendering each radio as a native button with <code>nativeButton</code> when using sibling labels (<code>for</code>/<code>id</code>).</p>
                    </Example.description>
                    <RadioGroupNativeButtonDemo />
                </Example>
                <Example title="Form integration">
                    <Example.description>
                        <p>Use <a href="/components/field" className="underline">Field</a> and <a href="/components/fieldset" className="underline">Fieldset</a> for group labeling and form integration.</p>
                    </Example.description>
                    <RadioGroupFormDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}

#[Component]
function RadioGroupLabelingDemo(): Node
{
    $types = STORAGE_TYPES;

    return (
        <RadioGroup aria-labelledby="storage-type-label" defaultValue="ssd">
            <div id="storage-type-label" className="text-sm font-bold">Storage type</div>
            {% for value, name in types %}
                <label key={{ value }} className="flex items-center gap-2 text-sm"><Radio value={{ value }}><RadioIndicator /></Radio>{{ name }}</label>
            {% endfor %}
        </RadioGroup>
    );
}

#[Component]
function RadioGroupNativeButtonDemo(): Node
{
    $types = STORAGE_TYPES;

    return (
        <RadioGroup aria-labelledby="storage-type" defaultValue="ssd">
            <div id="storage-type" className="text-sm font-bold">Storage type</div>
            {% for value, name in types %}
                <div key={{ value }} className="flex items-center gap-2 text-sm">
                    <Radio id="storage-type-{{ value }}" value={{ value }} nativeButton><RadioIndicator /></Radio>
                    <label htmlFor="storage-type-{{ value }}">{{ name }}</label>
                </div>
            {% endfor %}
        </RadioGroup>
    );
}

#[Component]
function RadioGroupFormDemo(): Node
{
    $types = STORAGE_TYPES;

    return (
        <Form>
            <Field>
                <Fieldset>
                    <FieldsetLegend className="text-sm">Storage type</FieldsetLegend>
                    <RadioGroup aria-label="Storage type" name="storageType" defaultValue="ssd">
                        {% for value, name in types %}
                            <FieldItem key={{ value }}>
                                <FieldLabel className="flex items-center gap-2 font-normal">
                                    <Radio value={{ value }}><RadioIndicator /></Radio>
                                    {{ name }}
                                </FieldLabel>
                            </FieldItem>
                        {% endfor %}
                    </RadioGroup>
                </Fieldset>
            </Field>
        </Form>
    );
}
