function SelectPlaceholderDemo(): Node
{
    $themes = ['system' => 'System default', 'light' => 'Light', 'dark' => 'Dark'];

    return (
        <Select id="placeholder" sideOffset={{ 4 }}>
            <SelectLabel>Theme</SelectLabel>
            <SelectTrigger>
                <SelectValue placeholder="Select theme" />
