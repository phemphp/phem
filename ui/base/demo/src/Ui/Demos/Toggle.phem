<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Hero};
use function Phem\Ui\Base\Examples\ToggleHeroDemo;

#[Page('/components/toggle')]
function TogglePage(): Node
{
    return (
        <DemoPage slug="toggle">
            <Hero source="ToggleHeroDemo">
                <ToggleHeroDemo />
            </Hero>
        </DemoPage>
    );
}
