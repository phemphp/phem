<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\Examples\{ToggleGroupHeroDemo, ToggleGroupMultipleDemo};

#[Page('/components/toggle-group')]
function ToggleGroupPage(): Node
{
    return (
        <DemoPage slug="toggle-group">
            <Hero source="ToggleGroupHeroDemo">
                <ToggleGroupHeroDemo />
            </Hero>
            <Examples>
                <Example title="Multiple" source="ToggleGroupMultipleDemo">
                    <Example.description>
                        <p>Add the <code>multiple</code> prop to allow pressing more than one toggle at a time.</p>
                    </Example.description>
                    <ToggleGroupMultipleDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}
