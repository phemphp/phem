<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\Examples\{ToolbarHeroDemo, ToolbarMenuDemo, ToolbarNumberFieldDemo, ToolbarToggleTooltipDemo, ToolbarTooltipDemo};

#[Page('/components/toolbar')]
function ToolbarPage(): Node
{
    return (
        <DemoPage slug="toolbar">
            <Hero source="ToolbarHeroDemo">
                <ToolbarHeroDemo />
            </Hero>
            <Examples>
                <Example title="Using with Menu" source="ToolbarMenuDemo">
                    <Example.description>
                        <p>All popup components that provide a <code>Trigger</code> component can be integrated with a toolbar: in a <code>Toolbar</code>, the trigger is an item of the toolbar, with the look of a <code>ToolbarButton</code>.</p>
                        <p>This applies to <code>AlertDialog</code>, <code>Dialog</code>, <code>Menu</code>, <code>Popover</code>, and <code>Select</code>.</p>
                    </Example.description>
                    <ToolbarMenuDemo />
                </Example>
                <Example title="Using with Tooltip" source="ToolbarTooltipDemo">
                    <Example.description>
                        <p>A <code>TooltipTrigger</code> in a <code>Toolbar</code> is an item of the toolbar.</p>
                    </Example.description>
                    <ToolbarTooltipDemo />
                </Example>
                <Example title="Using toggles with Tooltip" source="ToolbarToggleTooltipDemo">
                    <Example.description>
                        <p>A <code>Toggle</code> or a <code>ToolbarButton</code> in a <code>Tooltip</code> is a trigger of the tooltip. A toggle of a <code>ToggleGroup</code> keeps its group.</p>
                    </Example.description>
                    <ToolbarToggleTooltipDemo />
                </Example>
                <Example title="Using with NumberField" source="ToolbarNumberFieldDemo">
                    <Example.description>
                        <p>A <code>NumberFieldInput</code> in a <code>Toolbar</code> is an item of the toolbar, as a <code>ToolbarInput</code>.</p>
                    </Example.description>
                    <ToolbarNumberFieldDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}
