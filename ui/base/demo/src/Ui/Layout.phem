<?phem

namespace App\Ui;

use Phem\Attribute\Component;
use Phem\{Html, Node, Root};

#[Component]
function Document(string $title, Html $children): Node
{
    return (
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title>{{ title }} · phem/ui-base</title>
                <link rel="icon" href="data:," />
                {{ theme_script() }}
                {{ importmap('app') }}
            </head>
            <body className="min-h-dvh bg-white text-neutral-950 antialiased dark:bg-neutral-950 dark:text-white">
                <Root>{{ children }}</Root>
            </body>
        </html>
    );
}

/**
 * The left navigation of base-ui.com: a "Components" section with a link for each component, in
 * the same order and with the same labels. On a narrow screen, it goes above the content.
 */
#[Component]
function Sidebar(?string $current = null): Node
{
    $components = Gallery::components();

    return (
        <nav aria-label="Components" className="border-b border-neutral-200 px-4 py-6 md:sticky md:top-0 md:h-dvh md:w-56 md:shrink-0 md:overflow-y-auto md:border-b-0 md:px-0 md:py-10 dark:border-neutral-800">
            <div className="mb-6 flex items-center justify-between gap-2 px-2">
                <a href="/" className="text-sm font-bold">phem/ui-base</a>
                <ThemeSwitch />
            </div>
            <h2 className="px-2 py-[3px] text-sm leading-[22px] font-normal text-[#767676] dark:text-[#b3b3b3]">Components</h2>
            <ul className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-1">
                {% for slug, item in components %}
                    <li key={{ slug }}>
                        <a
                            href="/components/{{ slug }}"
                            aria-current={{ slug == current ? 'page' : null }}
                            className="block rounded-md px-2 py-0.5 text-sm leading-[22px] text-[#2e2e2e] hover:bg-[#f9f9f9] aria-[current=page]:bg-[#f9f9f9] dark:text-[#e6e6e6] dark:hover:bg-[#1a1a1a] dark:aria-[current=page]:bg-[#1a1a1a]"
                        >{{ item.name }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    );
}

/**
 * The theme switch of the sidebar, on the `phem-theme` controller: one button that toggles the
 * light and the dark theme. It shows a sun in the light theme and a moon in the dark theme.
 */
#[Component]
function ThemeSwitch(): Node
{
    return (
        <button
            type="button"
            title="Toggle the theme"
            aria-label="Toggle the theme"
            data-controller="phem-theme"
            data-action="phem-theme#toggle"
            className="flex size-7 items-center justify-center rounded-md text-[#767676] hover:bg-neutral-100 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-blue-800 dark:text-[#b3b3b3] dark:hover:bg-neutral-800 dark:hover:text-white"
        >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" className="dark:hidden">
                <circle cx="8" cy="8" r="3" />
                <path d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9" />
            </svg>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" className="hidden dark:block">
                <path d="M13.5 9.5A5.75 5.75 0 0 1 6.5 2.5a5.75 5.75 0 1 0 7 7Z" />
            </svg>
        </button>
    );
}

/**
 * The index of the page on the right ("On this page"): a link to each section. `phem-scrollspy`
 * marks the link of the section in view. On a narrow screen, it is hidden. It keeps its width with no headings, so the content stays in the center.
 */
#[Component]
function OnThisPage(array $headings = []): Node
{
    return (
        <aside className="hidden w-56 shrink-0 py-10 xl:sticky xl:top-0 xl:block xl:h-dvh xl:overflow-y-auto">
            {% if headings is not empty %}
                <nav aria-label="On this page" data-controller="phem-scrollspy">
                    <h2 className="px-2 py-[3px] text-sm leading-[22px] font-normal text-[#767676] dark:text-[#b3b3b3]">On this page</h2>
                    <ul>
                        {% for heading in headings %}
                            <li key={{ heading.id }}>
                                <a
                                    href="#{{ heading.id }}"
                                    data-phem-scrollspy-target="link"
                                    className={{ 'block rounded-md py-0.5 pr-2 text-sm leading-[22px] text-[#767676] hover:bg-[#f9f9f9] hover:text-neutral-950 data-active:bg-[#f9f9f9] data-active:font-medium data-active:text-neutral-950 dark:text-[#b3b3b3] dark:hover:bg-[#1a1a1a] dark:hover:text-white dark:data-active:bg-[#1a1a1a] dark:data-active:text-white ' ~ (heading.level == 2 ? 'pl-2' : 'pl-5') }}
                                >{{ heading.title }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </aside>
    );
}

/**
 * The frame of each page: the sidebar, the content and the index of the page. The three columns
 * stay together in the center of the screen.
 */
#[Component]
function Shell(string $title, Html $children, ?string $current = null, array $headings = []): Node
{
    return (
        <Document title={{ title }}>
            <div className="mx-auto max-w-7xl md:flex md:justify-center md:gap-10 md:px-6">
                <Sidebar current={{ current }} />
                <main className="flex w-full max-w-3xl min-w-0 flex-col gap-6 px-4 py-10 md:px-0">
                    {{ children }}
                </main>
                <OnThisPage headings={{ headings }} />
            </div>
        </Document>
    );
}

/** The page of one component: its title and its description from base-ui.com, then the demos. */
#[Component]
function DemoPage(string $slug, Html $children): Node
{
    $component = Gallery::components()[$slug];
    $headings = Contents::headings((string) $children);

    return (
        <Shell title={{ component.name }} current={{ slug }} headings={{ headings }}>
            <header className="flex flex-col gap-2">
                <h1 className="text-[34px] leading-[1.27] font-bold">{{ component.name }}</h1>
                <p className="text-lg leading-7 text-[#767676] dark:text-[#b3b3b3]">{{ component.description }}</p>
            </header>
            {{ children }}
        </Shell>
    );
}

/**
 * The box of a demo, with the demo in the middle. With a `source` (the name of the demo
 * component), the source of the demo goes below it, as on ui.shadcn.com: the colored code, with
 * a copy button in its top right corner. A long code shows its first lines, and "Show code"
 * shows all of it.
 */
#[Component]
function DemoBox(Html $children, ?string $source = null): Node
{
    $code = null === $source ? null : Gallery::source($source);
    $html = null === $code ? null : Highlighter::phem($code);
    $long = null !== $code && substr_count($code, "\n") > 8;
    $id = null === $source ? null : Gallery::anchor($source).'-code';

    return (
        <div className="flex flex-col">
            <div data-demo="preview" className={{ 'flex min-h-80 items-center justify-center border border-neutral-200 p-10 dark:border-neutral-800 ' ~ (code is null ? 'rounded-lg' : 'rounded-t-lg') }}>
                {{ children }}
            </div>
            {% if code is not null %}
                <div data-demo="source" data-controller="phem-clipboard" className="relative flex flex-col overflow-hidden rounded-b-lg border border-t-0 border-neutral-200 bg-[#fcfcfc] dark:border-neutral-800 dark:bg-[#0d0d0d]">
                    <div className="absolute top-2 right-2 z-10 flex items-center gap-2">
                        <span data-phem-clipboard-target="feedback" className="text-xs text-[#767676] dark:text-[#b3b3b3]"></span>
                        <button type="button" data-action="phem-clipboard#copy" aria-label="Copy code" className="flex size-7 items-center justify-center rounded-md bg-[#fcfcfc] text-[#767676] hover:bg-neutral-100 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-blue-800 dark:bg-[#0d0d0d] dark:text-[#b3b3b3] dark:hover:bg-neutral-800 dark:hover:text-white">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.5" />
                                <path d="M10.75 5.25V3.75a1.5 1.5 0 0 0-1.5-1.5h-5a1.5 1.5 0 0 0-1.5 1.5v5a1.5 1.5 0 0 0 1.5 1.5h1.5" />
                            </svg>
                        </button>
                    </div>
                    {% if long %}
                        <input type="checkbox" id={{ id }} aria-label="Show code" className="peer sr-only" />
                    {% endif %}
                    <div data-phem-clipboard-target="source" data-short={{ long ? null : '' }} className="max-h-48 overflow-hidden peer-checked:max-h-none data-short:max-h-none [&_pre]:overflow-x-auto [&_pre]:p-4 [&_pre]:font-mono [&_pre]:text-[13px] [&_pre]:leading-5">{{ html }}</div>
                    {% if long %}
                        <div className="pointer-events-none absolute inset-x-0 bottom-0 flex h-28 items-end justify-center bg-linear-to-t from-[#fcfcfc] from-30% to-transparent pb-4 peer-checked:static peer-checked:h-auto peer-checked:bg-none peer-checked:pt-1 peer-focus-visible:[&_label]:outline-2 peer-focus-visible:[&_label]:outline-offset-2 peer-focus-visible:[&_label]:outline-blue-800 dark:from-[#0d0d0d] peer-checked:[&_[data-show]]:hidden [&_[data-hide]]:hidden peer-checked:[&_[data-hide]]:inline">
                            <label htmlFor={{ id }} aria-hidden="true" className="pointer-events-auto cursor-pointer rounded-full border border-neutral-200 bg-white px-3.5 py-1 text-sm font-medium text-neutral-950 shadow-xs select-none hover:bg-neutral-50 active:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:hover:bg-neutral-800 dark:active:bg-neutral-700">
                                <span data-show>Show code</span>
                                <span data-hide>Hide code</span>
                            </label>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    );
}

/**
 * The demo at the top of the page, with its source when `source` is set. Its description, when
 * it has one, goes below the demo.
 */
#[Component]
function Hero(Html $children, ?Html $description = null, ?string $source = null): Node
{
    return (
        <section aria-label="Demo" className="flex flex-col gap-6">
            <DemoBox source={{ source }}>{{ children }}</DemoBox>
            {% if description is not empty %}
                <Description>{{ description }}</Description>
            {% endif %}
        </section>
    );
}

/** The text of a demo or an example: paragraphs, with `<code>` and `<kbd>`. */
#[Component]
function Description(Html $children): Node
{
    return (
        <div className="flex flex-col gap-3 text-[#767676] dark:text-[#b3b3b3] [&_code]:rounded-sm [&_code]:bg-neutral-100 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.875em] [&_code]:text-neutral-950 dark:[&_code]:bg-neutral-800 dark:[&_code]:text-white [&_kbd]:rounded-sm [&_kbd]:border [&_kbd]:border-neutral-300 [&_kbd]:px-1 [&_kbd]:font-mono [&_kbd]:text-[0.875em] dark:[&_kbd]:border-neutral-700">
            {{ children }}
        </div>
    );
}

/** The "Examples" section of a page: a heading, then its Example blocks. */
#[Component]
function Examples(Html $children): Node
{
    return (
        <section aria-labelledby="examples" className="flex flex-col gap-10 pt-4">
            <h2 id="examples" data-contents className="scroll-mt-6 text-xl font-bold"><a href="#examples" className="underline-offset-4 hover:underline focus-visible:underline">Examples</a></h2>
            {{ children }}
        </section>
    );
}

/**
 * One example of base-ui.com: its heading, its description (paragraphs, with `<code>` and `<kbd>`),
 * and its demo, with its source when `source` is set. An example with no demo (a section of
 * base-ui.com with code only) shows only its heading and its description.
 */
#[Component]
function Example(string $title, Html $description, ?Html $children = null, ?string $source = null): Node
{
    $id = Gallery::anchor($title);

    return (
        <section aria-labelledby={{ id }} className="flex flex-col gap-3">
            <h3 id={{ id }} data-contents className="scroll-mt-6 text-lg font-bold"><a href="#{{ id }}" className="underline-offset-4 hover:underline focus-visible:underline">{{ title }}</a></h3>
            <Description>{{ description }}</Description>
            {% if children is not empty %}
                <DemoBox source={{ source }}>{{ children }}</DemoBox>
            {% endif %}
        </section>
    );
}
