<?phem

namespace Phem\Ui\Base\Examples;

use Phem\Attribute\Component;
use Phem\Node;

use function Phem\Ui\Base\{Avatar, AvatarFallback, AvatarImage};

/**
 * An easily stylable avatar component.
 */
#[Component]
function AvatarHeroDemo(): Node
{
    return (
        <div className="flex gap-4">
            <Avatar>
                <AvatarImage src="https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=128&h=128&dpr=2&q=80" width="48" height="48" />
                <AvatarFallback delay={{ 600 }}>LT</AvatarFallback>
            </Avatar>
            <Avatar>LT</Avatar>
        </div>
    );
}
