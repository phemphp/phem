<?phem

namespace Phem\Ui\Base\Examples;

use Phem\Attribute\Component;
use Phem\Node;
use Phem\Ui\Base\Input;

/**
 * A native input element that automatically works with Field.
 */
#[Component]
function InputHeroDemo(): Node
{
    return (
        <label className="flex flex-col items-start gap-1 text-sm font-bold text-neutral-950 dark:text-white">
            Name
            <Input placeholder="e.g. Colm Tuite" />
        </label>
    );
}
