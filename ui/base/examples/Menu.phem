<?phem

namespace Phem\Ui\Base\Examples;

use Phem\Attribute\{Component, State};
use Phem\Node;
use Phem\Ui\Base\{Align, Dialog, Menu, MenuRadioGroup, MenuSubmenu};

use function Phem\Ui\Base\{DialogClose, DialogDescription, DialogPopup, DialogTitle, MenuArrow, MenuCheckboxItem, MenuClear, MenuEmpty, MenuGroup, MenuGroupLabel, MenuInput, MenuItem, MenuItemIndicator, MenuItemLabel, MenuLinkItem, MenuList, MenuPayload, MenuPopup, MenuRadioItem, MenuSeparator, MenuSubmenuTrigger, MenuTrigger, MenuViewport};

const MENU_ANIMATED = [
    'library' => ['Library', [
        ['Add to library', 'Add to favorites'],
        ['Create playlist', 'Create station'],
    ]],
    'playback' => ['Playback', [
        ['Play now', 'Add to queue'],
        ['Play next', 'Play last', 'Sleep timer'],
    ]],
    'share' => ['Share', [
        ['Copy link', 'Copy embed code'],
        ['Share to contacts', 'Share to social'],
    ]],
];

const MENU_CONTROLLED = [
    'library' => ['Add to library', 'Add to favorites'],
    'playback' => ['Play', 'Add to queue'],
    'share' => ['Share', 'Copy link'],
];

// The items of the filter example.
const MENU_FILTER_SHARE = [
    'Email',
    'Messages',
    'AirDrop',
    'Copy link',
    'Invite collaborators',
    'Publish to web',
    'Send a copy',
];
const MENU_FILTER_FOLDERS = [
    'Desktop',
    'Documents',
    'Downloads',
    'Projects',
    'Archive',
    'Shared',
    'Trash',
];
const MENU_FILTER_EXPORTS = [
    'PDF document',
    'Word document',
    'Plain text',
    'Rich text',
    'Markdown',
    'HTML page',
    'Image',
];


/**
 * A list of actions in a dropdown, enhanced with keyboard navigation.
 */
#[Component]
function MenuHeroDemo(): Node
{
    return (
        <Menu sideOffset={{ 8 }}>
            <MenuTrigger>Song</MenuTrigger>
            <MenuPopup>
                <MenuItem>Add to Library</MenuItem>
                <MenuItem>Add to Playlist</MenuItem>
                <MenuSeparator />
                <MenuItem>Play Next</MenuItem>
                <MenuItem>Play Last</MenuItem>
                <MenuSeparator />
                <MenuItem>Favorite</MenuItem>
                <MenuItem>Share</MenuItem>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Open on hover: the pointer on the trigger opens the menu.
 *
 * To create a menu that opens on hover, add the `openOnHover` prop to `Menu`. You can additionally
 * configure how quickly the menu opens on hover using the `delay` prop.
 */
#[Component]
function MenuHoverDemo(): Node
{
    return (
        <Menu openOnHover sideOffset={{ 8 }}>
            <MenuTrigger>Add to playlist</MenuTrigger>
            <MenuPopup>
                <MenuItem>Get Up!</MenuItem>
                <MenuItem>Inside Out</MenuItem>
                <MenuItem>Night Beats</MenuItem>
                <MenuItem>New playlist…</MenuItem>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Checkbox items: the server keeps the state of each item, and the menu stays open.
 *
 * Use the `MenuCheckboxItem` part to create a menu item that can toggle a setting on or off. Here,
 * the server keeps the state: each item has `checked` and an `onClick` handler. With
 * `defaultChecked` and no handler, the browser keeps it.
 */
#[Component]
final class MenuCheckboxDemo
{
    #[State] public bool $showMinimap = true;
    #[State] public bool $showSearch = true;
    #[State] public bool $showSidebar = false;

    public function toggle(string $setting): void
    {
        match ($setting) {
            'minimap' => $this->showMinimap = !$this->showMinimap,
            'search' => $this->showSearch = !$this->showSearch,
            'sidebar' => $this->showSidebar = !$this->showSidebar,
        };
    }

    public function render(): Node
    {
        return (
            <Menu sideOffset={{ 8 }}>
                <MenuTrigger>Workspace</MenuTrigger>
                <MenuPopup>
                    <MenuCheckboxItem checked={{ showMinimap }} onClick={{ toggle('minimap') }}>
                        <MenuItemIndicator />
                        <MenuItemLabel>Minimap</MenuItemLabel>
                    </MenuCheckboxItem>
                    <MenuCheckboxItem checked={{ showSearch }} onClick={{ toggle('search') }}>
                        <MenuItemIndicator />
                        <MenuItemLabel>Search</MenuItemLabel>
                    </MenuCheckboxItem>
                    <MenuCheckboxItem checked={{ showSidebar }} onClick={{ toggle('sidebar') }}>
                        <MenuItemIndicator />
                        <MenuItemLabel>Sidebar</MenuItemLabel>
                    </MenuCheckboxItem>
                </MenuPopup>
            </Menu>
        );
    }
}

/**
 * Radio items: one value of the group is checked.
 *
 * Use the `MenuRadioGroup` and `MenuRadioItem` parts to create menu items that work like radio
 * buttons.
 */
#[Component]
function MenuRadioDemo(): Node
{
    return (
        <Menu sideOffset={{ 8 }}>
            <MenuTrigger>Sort</MenuTrigger>
            <MenuPopup>
                <MenuRadioGroup defaultValue="date">
                    <MenuRadioItem value="date">
                        <MenuItemIndicator />
                        <MenuItemLabel>Date</MenuItemLabel>
                    </MenuRadioItem>
                    <MenuRadioItem value="name">
                        <MenuItemIndicator />
                        <MenuItemLabel>Name</MenuItemLabel>
                    </MenuRadioItem>
                    <MenuRadioItem value="type">
                        <MenuItemIndicator />
                        <MenuItemLabel>Type</MenuItemLabel>
                    </MenuRadioItem>
                </MenuRadioGroup>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Close on click: a checkbox item that closes the menu, and an item that keeps it open.
 *
 * Use the `closeOnClick` prop to change whether the menu closes when an item is clicked. Here, the
 * checkbox item closes the menu, and the first item keeps it open.
 */
#[Component]
function MenuCloseOnClickDemo(): Node
{
    return (
        <Menu sideOffset={{ 8 }}>
            <MenuTrigger>Format</MenuTrigger>
            <MenuPopup>
                <MenuItem closeOnClick={{ false }}>Keep open</MenuItem>
                <MenuSeparator />
                <MenuCheckboxItem closeOnClick>
                    <MenuItemIndicator />
                    <MenuItemLabel>Bold</MenuItemLabel>
                </MenuCheckboxItem>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Group labels: a label for a radio group and for a group of checkbox items.
 *
 * Use the `MenuGroupLabel` part to add a label to a `MenuGroup` or `MenuRadioGroup`.
 */
#[Component]
function MenuGroupLabelsDemo(): Node
{
    return (
        <Menu sideOffset={{ 8 }}>
            <MenuTrigger>View</MenuTrigger>
            <MenuPopup>
                <MenuRadioGroup defaultValue="date">
                    <MenuGroupLabel className="pr-8 pl-[2.125rem]">Sort</MenuGroupLabel>
                    <MenuRadioItem value="date">
                        <MenuItemIndicator />
                        <MenuItemLabel>Date</MenuItemLabel>
                    </MenuRadioItem>
                    <MenuRadioItem value="name">
                        <MenuItemIndicator />
                        <MenuItemLabel>Name</MenuItemLabel>
                    </MenuRadioItem>
                    <MenuRadioItem value="type">
                        <MenuItemIndicator />
                        <MenuItemLabel>Type</MenuItemLabel>
                    </MenuRadioItem>
                </MenuRadioGroup>
                <MenuSeparator />
                <MenuGroup>
                    <MenuGroupLabel className="pr-8 pl-[2.125rem]">Workspace</MenuGroupLabel>
                    <MenuCheckboxItem defaultChecked>
                        <MenuItemIndicator />
                        <MenuItemLabel>Minimap</MenuItemLabel>
                    </MenuCheckboxItem>
                    <MenuCheckboxItem defaultChecked>
                        <MenuItemIndicator />
                        <MenuItemLabel>Search</MenuItemLabel>
                    </MenuCheckboxItem>
                    <MenuCheckboxItem>
                        <MenuItemIndicator />
                        <MenuItemLabel>Sidebar</MenuItemLabel>
                    </MenuCheckboxItem>
                </MenuGroup>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Nested menu: "Add to Playlist" opens a submenu.
 *
 * To create a submenu, nest a `MenuSubmenu` inside the popup of the parent menu. Use the
 * `MenuSubmenuTrigger` part for the menu item that opens the nested menu.
 */
#[Component]
function MenuSubmenuDemo(): Node
{
    return (
        <Menu sideOffset={{ 8 }}>
            <MenuTrigger>Song</MenuTrigger>
            <MenuPopup>
                <MenuItem>Add to Library</MenuItem>
                <MenuSubmenu sideOffset={{ -4 }} alignOffset={{ -4 }}>
                    <MenuSubmenuTrigger>Add to Playlist</MenuSubmenuTrigger>
                    <MenuPopup>
                        <MenuItem>Get Up!</MenuItem>
                        <MenuItem>Inside Out</MenuItem>
                        <MenuItem>Night Beats</MenuItem>
                        <MenuSeparator />
                        <MenuItem>New playlist…</MenuItem>
                    </MenuPopup>
                </MenuSubmenu>
                <MenuSeparator />
                <MenuItem>Play Next</MenuItem>
                <MenuItem>Play Last</MenuItem>
                <MenuSeparator />
                <MenuItem>Favorite</MenuItem>
                <MenuItem>Share</MenuItem>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Navigate to another page: the items are links.
 *
 * Use the `MenuLinkItem` part to create a link. Turbo follows it as a link of the page.
 */
#[Component]
function MenuLinksDemo(): Node
{
    return (
        <Menu sideOffset={{ 8 }}>
            <MenuTrigger>Components</MenuTrigger>
            <MenuPopup>
                <MenuLinkItem href="/components/dialog">Go to Dialog</MenuLinkItem>
                <MenuLinkItem href="/components/popover">Go to Popover</MenuLinkItem>
                <MenuLinkItem href="/components/tooltip">Go to Tooltip</MenuLinkItem>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Open a dialog: the item is a detached trigger of the dialog.
 *
 * In order to open a dialog using a menu, make the menu item a detached trigger of the dialog:
 * give it `data-phem-dialog-for` with the `handle` of the dialog. The click closes the menu and
 * opens the dialog.
 */
#[Component]
function MenuDialogDemo(): Node
{
    return (
        <div>
            <Menu sideOffset={{ 8 }}>
                <MenuTrigger>Open menu</MenuTrigger>
                <MenuPopup>
                    <MenuItem data-phem-dialog-for="menu-dialog">Open dialog</MenuItem>
                </MenuPopup>
            </Menu>
            <Dialog handle="menu-dialog">
                <DialogPopup>
                    <div className="flex flex-col gap-1">
                        <DialogTitle>Dialog from a menu</DialogTitle>
                        <DialogDescription>The menu item opened this dialog.</DialogDescription>
                    </div>
                    <div className="flex justify-end gap-3">
                        <DialogClose>Close</DialogClose>
                    </div>
                </DialogPopup>
            </Dialog>
        </div>
    );
}

#[Component]
function EllipsisIcon(): Node
{
    return (
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" className="block">
            <circle cx="3" cy="8" r="1" />
            <circle cx="8" cy="8" r="1" />
            <circle cx="13" cy="8" r="1" />
        </svg>
    );
}

/**
 * Detached triggers: the trigger is outside the root, with the same handle.
 *
 * A menu can be opened by a trigger that lives either inside or outside the `Menu`. Keep the
 * trigger inside `Menu` for simple, tightly coupled layouts like the hero demo at the top of this
 * page. When the trigger and menu content need to live in different parts of the tree, give the
 * same `handle` to the trigger and to the root. The root gets the handle as its `id`, and the
 * trigger gets `data-phem-menu-for`.
 *
 * Note that only top-level menus can have detached triggers. Submenus must have their triggers
 * defined within the `MenuSubmenu` part.
 */
#[Component]
function MenuDetachedDemo(): Node
{
    return (
        <div>
            <MenuTrigger handle="project-actions" caret={{ false }} aria-label="Project actions" className="px-2">
                <EllipsisIcon />
            </MenuTrigger>
            <Menu handle="project-actions" sideOffset={{ 8 }}>
                <MenuPopup>
                    <MenuItem>Rename</MenuItem>
                    <MenuItem>Duplicate</MenuItem>
                    <MenuItem>Move to folder</MenuItem>
                    <MenuItem>Archive</MenuItem>
                    <MenuItem className="text-red-600">Delete</MenuItem>
                </MenuPopup>
            </Menu>
        </div>
    );
}

/**
 * Multiple triggers: two detached triggers, and a content for each payload.
 *
 * One menu can be opened by several triggers. You can either render multiple `MenuTrigger`
 * components inside the same `Menu`, or attach several detached triggers to the same `handle`.
 *
 * Menus can render different content depending on which trigger opened them. Give each trigger a
 * `payload`, and put a `MenuPayload` with the same `name` in the `MenuViewport`: the server
 * renders each content in a `template`, and the viewport shows a copy of the content of the active
 * trigger.
 */
#[Component]
function MenuMultipleDemo(): Node
{
    return (
        <div className="flex gap-2">
            <MenuTrigger handle="multiple-menu" payload="file">File</MenuTrigger>
            <MenuTrigger handle="multiple-menu" payload="edit">Edit</MenuTrigger>
            <Menu handle="multiple-menu" sideOffset={{ 8 }}>
                <MenuPopup>
                    <MenuViewport>
                        <MenuPayload name="file">
                            <MenuItem>New</MenuItem>
                            <MenuItem>Open</MenuItem>
                            <MenuItem>Save</MenuItem>
                        </MenuPayload>
                        <MenuPayload name="edit">
                            <MenuItem>Undo</MenuItem>
                            <MenuItem>Redo</MenuItem>
                            <MenuItem>Cut</MenuItem>
                            <MenuItem>Copy</MenuItem>
                            <MenuItem>Paste</MenuItem>
                        </MenuPayload>
                    </MenuViewport>
                </MenuPopup>
            </Menu>
        </div>
    );
}

/**
 * Controlled mode: three triggers in the root, and a button that opens the menu for the second
 * one.
 *
 * You can control the menu's open state with the `defaultOpen` and `triggerId` props of `Menu`: a
 * render with new values opens the menu next to the trigger with that `id`. The controller keeps
 * the values of the browser in `data-phem-menu-open-value` and `data-phem-menu-trigger-id-value`.
 *
 * Here, the button is in the root, and opens the menu without a request with the `phem-menu#open`
 * action and a `triggerId` param.
 */
#[Component]
function MenuControlledDemo(): Node
{
    $menus = MENU_CONTROLLED;

    return (
        <Menu sideOffset={{ 8 }}>
            <div className="flex flex-wrap justify-center gap-2">
                <MenuTrigger id="menu-trigger-1" payload="library" caret={{ false }}>Library</MenuTrigger>
                <MenuTrigger id="menu-trigger-2" payload="playback" caret={{ false }}>Playback</MenuTrigger>
                <MenuTrigger id="menu-trigger-3" payload="share" caret={{ false }}>Share</MenuTrigger>
                <button type="button" data-action="phem-menu#open" data-phem-menu-trigger-id-param="menu-trigger-2" className="flex h-8 items-center justify-center border border-neutral-950 dark:border-white bg-white dark:bg-neutral-950 px-3 text-sm text-neutral-950 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:outline-2 focus-visible:-outline-offset-1 focus-visible:outline-neutral-950 dark:focus-visible:outline-white">Open playback (controlled)</button>
            </div>
            <MenuPopup>
                <MenuViewport>
                    {% for name, items in menus %}
                        <MenuPayload key={{ name }} name={{ name }}>
                            {% for item in items %}
                                <MenuItem key={{ item }}>{{ item }}</MenuItem>
                            {% endfor %}
                        </MenuPayload>
                    {% endfor %}
                </MenuViewport>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Arrow: the popup points to its trigger.
 *
 * Use the `MenuArrow` part inside the popup to visually connect the menu to its trigger.
 */
#[Component]
function MenuArrowDemo(): Node
{
    return (
        <Menu sideOffset={{ 8 }} align={{ Align.Center }}>
            <MenuTrigger>Song</MenuTrigger>
            <MenuPopup>
                <MenuArrow />
                <MenuItem>Add to Library</MenuItem>
                <MenuItem>Add to Playlist</MenuItem>
                <MenuSeparator />
                <MenuItem>Play Next</MenuItem>
                <MenuItem>Play Last</MenuItem>
                <MenuSeparator />
                <MenuItem>Favorite</MenuItem>
                <MenuItem>Share</MenuItem>
            </MenuPopup>
        </Menu>
    );
}

/**
 * Animating the Menu: the popup moves, changes its size and slides its content between triggers.
 *
 * When one menu is opened by multiple detached triggers, you can animate the menu as it moves
 * between triggers. This includes animating position, size, and content.
 *
 * To animate the menu's position, apply CSS transitions to the `top` and `left` properties of the
 * `MenuPopup`. To animate its size, transition its `width` and `height` to `var(--popup-width)`
 * and `var(--popup-height)`.
 *
 * To enable content animations, wrap the menu content in the `MenuViewport` part. It gets a
 * `data-activation-direction` attribute with up to two space-separated tokens: a horizontal
 * (`left` or `right`) and a vertical (`up` or `down`) value. Inside the viewport, content is
 * wrapped in `div`s with `data-current` (the currently visible or the incoming content) and
 * `data-previous` (the outgoing content).
 */
#[Component]
function MenuAnimatedDemo(): Node
{
    $menus = MENU_ANIMATED;

    return (
        <div className="flex flex-wrap items-center gap-2">
            <MenuTrigger handle="animated-menu" payload="library" caret={{ false }}>Library</MenuTrigger>
            <MenuTrigger handle="animated-menu" payload="playback" caret={{ false }}>Playback</MenuTrigger>
            <MenuTrigger handle="animated-menu" payload="share" caret={{ false }}>Share</MenuTrigger>
            <Menu handle="animated-menu" modal={{ false }} sideOffset={{ 8 }}>
                <MenuPopup className="h-[var(--popup-height,auto)] w-[var(--popup-width,auto)] max-w-[var(--available-width)] transition-[top,left,width,height,opacity,scale] duration-[0.35s] ease-[cubic-bezier(0.22,1,0.36,1)] data-starting-style:scale-90 data-ending-style:scale-90 data-instant:transition-none">
                    <MenuViewport className="relative h-full w-full overflow-clip p-0 [&_[data-current]]:w-[var(--popup-width)] [&_[data-current]]:translate-x-0 [&_[data-current]]:opacity-100 [&_[data-current]]:transition-[translate,opacity] [&_[data-current]]:duration-[350ms,175ms] [&_[data-current]]:ease-[cubic-bezier(0.22,1,0.36,1)] data-[activation-direction~='left']:[&_[data-current][data-starting-style]]:-translate-x-1/2 data-[activation-direction~='left']:[&_[data-current][data-starting-style]]:opacity-0 data-[activation-direction~='right']:[&_[data-current][data-starting-style]]:translate-x-1/2 data-[activation-direction~='right']:[&_[data-current][data-starting-style]]:opacity-0 [&_[data-previous]]:w-[var(--popup-width)] [&_[data-previous]]:translate-x-0 [&_[data-previous]]:opacity-100 [&_[data-previous]]:transition-[translate,opacity] [&_[data-previous]]:duration-[350ms,175ms] [&_[data-previous]]:ease-[cubic-bezier(0.22,1,0.36,1)] data-[activation-direction~='left']:[&_[data-previous][data-ending-style]]:translate-x-1/2 data-[activation-direction~='left']:[&_[data-previous][data-ending-style]]:opacity-0 data-[activation-direction~='right']:[&_[data-previous][data-ending-style]]:-translate-x-1/2 data-[activation-direction~='right']:[&_[data-previous][data-ending-style]]:opacity-0">
                        {% for name, menu in menus %}
                            <MenuPayload key={{ name }} name={{ name }}>
                                {% for group in menu[1] %}
                                    <MenuGroup key={{ loop.index }}>
                                        {% if loop.first %}
                                            <MenuGroupLabel>{{ menu[0] }}</MenuGroupLabel>
                                        {% endif %}
                                        {% for item in group %}
                                            <MenuItem key={{ item }}>{{ item }}</MenuItem>
                                        {% endfor %}
                                    </MenuGroup>
                                    {% if not loop.last %}
                                        <MenuSeparator />
                                    {% endif %}
                                {% endfor %}
                            </MenuPayload>
                        {% endfor %}
                    </MenuViewport>
                </MenuPopup>
            </Menu>
        </div>
    );
}

#[Component]
function MenuClearIcon(): Node
{
    return (
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" className="block">
            <path d="m3.5 3.5 9 9m0-9-9 9" />
        </svg>
    );
}

/** A submenu with its own filter. */
#[Component]
function MenuFilterSubmenu(
    string $label,
    string $inputLabel,
    string $placeholder,
    string $emptyText,
    array $options,
): Node {
    return (
        <MenuSubmenu sideOffset={{ -4 }} alignOffset={{ -4 }}>
            <MenuSubmenuTrigger>{{ label }}</MenuSubmenuTrigger>
            <MenuPopup className="min-w-[max(14rem,var(--anchor-width))] overflow-hidden py-0">
                <div className="flex items-center border-b border-neutral-300 has-data-highlighted:border-neutral-950 has-data-highlighted:ring-1 has-data-highlighted:ring-neutral-950 has-data-highlighted:ring-inset dark:border-neutral-700 dark:has-data-highlighted:border-white dark:has-data-highlighted:ring-white">
                    <MenuInput aria-label={{ inputLabel }} placeholder={{ placeholder }} />
                    <MenuClear>
                        <MenuClearIcon />
                    </MenuClear>
                </div>
                <MenuEmpty>{{ emptyText }}</MenuEmpty>
                <MenuList className="max-h-[min(28rem,var(--available-height))] not-has-[>:not([hidden])]:py-0">
                    {% for option in options %}
                        <MenuItem key={{ option }}>{{ option }}</MenuItem>
                    {% endfor %}
                </MenuList>
            </MenuPopup>
        </MenuSubmenu>
    );
}

/**
 * Filtering: the input narrows the actions, with filterable submenus.
 *
 * Add `MenuInput` to the popup, and put the items inside `MenuList`. Label the input with
 * `aria-label`, `aria-labelledby`, or a visible `<label>`. Type to narrow the actions, then use
 * the arrow keys to move through matching items.
 *
 * Items match their text by default, ignoring case, accents, and punctuation. Use `label` to
 * override it. Groups with no matching items get the `hidden` attribute and stay in the page, and
 * `MenuEmpty` appears when no items match. `MenuClear` empties the query, and the query resets
 * when the menu closes.
 *
 * Use `autoHighlight` to highlight the first match while filtering, or `autoHighlight="always"` to
 * highlight it even when the query is empty. For server filtering, pass `filter={{ false }}` and
 * render the results of an `onInput` handler on the input.
 *
 * Opening the menu with a click or the keyboard focuses the input. Opening it on hover or with a
 * touch does not, so the on-screen keyboard stays hidden. The arrow keys move the highlight while
 * the input keeps focus. Tab closes the menu, and Shift+Tab returns focus to the trigger. The
 * popup is a `dialog` that holds the `searchbox` input and the `menu` list. Give each submenu its
 * own `MenuInput`: submenus without one remain unfiltered.
 */
#[Component]
function MenuFilterDemo(): Node
{
    $share = MENU_FILTER_SHARE;
    $folders = MENU_FILTER_FOLDERS;
    $exports = MENU_FILTER_EXPORTS;

    return (
        <Menu sideOffset={{ 8 }}>
            <MenuTrigger>Actions</MenuTrigger>
            <MenuPopup className="min-w-[max(14rem,var(--anchor-width))] overflow-hidden py-0">
                <div className="flex items-center border-b border-neutral-300 has-data-highlighted:border-neutral-950 has-data-highlighted:ring-1 has-data-highlighted:ring-neutral-950 has-data-highlighted:ring-inset dark:border-neutral-700 dark:has-data-highlighted:border-white dark:has-data-highlighted:ring-white">
                    <MenuInput aria-label="Filter actions" placeholder="e.g. Save" />
                    <MenuClear>
                        <MenuClearIcon />
                    </MenuClear>
                </div>
                <MenuEmpty>No actions found.</MenuEmpty>
                <MenuList className="max-h-[min(22rem,var(--available-height))] not-has-[>:not([hidden])]:py-0 [&>[data-filter-section]:not([hidden])~[data-filter-section]:not([hidden])>[data-filter-separator]]:block">
                    <MenuGroup data-filter-section>
                        <MenuGroupLabel className="pt-1.5 pr-8 pb-1 pl-4 text-xs font-medium">File</MenuGroupLabel>
                        <MenuItem>New file</MenuItem>
                        <MenuItem>Open file</MenuItem>
                        <MenuItem>Save</MenuItem>
                        <MenuItem>Save as</MenuItem>
                        <MenuItem>Duplicate</MenuItem>
                        <MenuItem>Rename</MenuItem>
                    </MenuGroup>
                    <MenuGroup data-filter-section>
                        <MenuGroupLabel className="pt-1.5 pr-8 pb-1 pl-4 text-xs font-medium">Organize</MenuGroupLabel>
                        <MenuFilterSubmenu label="Move to folder" inputLabel="Filter folders" placeholder="e.g. Projects" emptyText="No folders found." options={{ folders }} />
                        <MenuSubmenu sideOffset={{ -4 }} alignOffset={{ -4 }}>
                            <MenuSubmenuTrigger>Share</MenuSubmenuTrigger>
                            <MenuPopup className="min-w-[max(14rem,var(--anchor-width))] overflow-hidden py-0">
                                <MenuList className="max-h-[min(28rem,var(--available-height))] not-has-[>:not([hidden])]:py-0">
                                    {% for option in share %}
                                        <MenuItem key={{ option }}>{{ option }}</MenuItem>
                                    {% endfor %}
                                </MenuList>
                            </MenuPopup>
                        </MenuSubmenu>
                        <MenuFilterSubmenu label="Export" inputLabel="Filter export formats" placeholder="e.g. PDF" emptyText="No export formats found." options={{ exports }} />
                        <MenuItem>Download a copy</MenuItem>
                        <MenuItem>Delete</MenuItem>
                    </MenuGroup>
                    <MenuRadioGroup data-filter-section defaultValue="date">
                        <MenuSeparator data-filter-separator className="hidden bg-neutral-300 dark:bg-neutral-700" />
                        <MenuGroupLabel className="pt-1.5 pr-8 pb-1 pl-4 text-xs font-medium">Sort by</MenuGroupLabel>
                        <MenuRadioItem value="date">
                            <MenuItemIndicator />
                            <MenuItemLabel>Date modified</MenuItemLabel>
                        </MenuRadioItem>
                        <MenuRadioItem value="name">
                            <MenuItemIndicator />
                            <MenuItemLabel>Name</MenuItemLabel>
                        </MenuRadioItem>
                        <MenuRadioItem value="size">
                            <MenuItemIndicator />
                            <MenuItemLabel>Size</MenuItemLabel>
                        </MenuRadioItem>
                    </MenuRadioGroup>
                    <MenuGroup data-filter-section>
                        <MenuSeparator data-filter-separator className="hidden bg-neutral-300 dark:bg-neutral-700" />
                        <MenuGroupLabel className="pt-1.5 pr-8 pb-1 pl-4 text-xs font-medium">View</MenuGroupLabel>
                        <MenuCheckboxItem defaultChecked>
                            <MenuItemIndicator />
                            <MenuItemLabel>Show details</MenuItemLabel>
                        </MenuCheckboxItem>
                        <MenuCheckboxItem>
                            <MenuItemIndicator />
                            <MenuItemLabel>Show sidebar</MenuItemLabel>
                        </MenuCheckboxItem>
                        <MenuCheckboxItem>
                            <MenuItemIndicator />
                            <MenuItemLabel>Keep available offline</MenuItemLabel>
                        </MenuCheckboxItem>
                    </MenuGroup>
                </MenuList>
            </MenuPopup>
        </Menu>
    );
}
