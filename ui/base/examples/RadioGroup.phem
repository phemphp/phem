<?phem

namespace Phem\Ui\Base\Examples;

use Phem\Attribute\Component;
use Phem\Node;
use Phem\Ui\Base\{Field, Fieldset, Radio, RadioGroup};

use function Phem\Ui\Base\{FieldItem, FieldLabel, FieldsetLegend, Form, RadioIndicator};

/**
 * Provides shared state to a series of radio buttons.
 */
#[Component]
function RadioGroupHeroDemo(): Node
{
    $apples = [
        'fuji-apple' => 'Fuji',
        'gala-apple' => 'Gala',
        'granny-smith-apple' => 'Granny Smith',
    ];

    return (
        <RadioGroup aria-labelledby="best-apple" defaultValue="fuji-apple" name="apple">
            <div className="text-sm font-bold" id="best-apple">Best apple</div>
            {% for value, name in apples %}
                <label key={{ value }} className="flex items-center gap-2 text-sm font-normal text-neutral-950 dark:text-white">
                    <Radio value={{ value }}>
                        <RadioIndicator />
                    </Radio>
                    {{ name }}
                </label>
            {% endfor %}
        </RadioGroup>
    );
}

/**
 * Labeling a radio group.
 *
 * Label the group with `aria-labelledby` and a sibling label element. An enclosing `<label>` is
 * the simplest labeling pattern for each radio.
 */
#[Component]
function RadioGroupLabelingDemo(): Node
{
    $types = ['ssd' => 'SSD', 'hdd' => 'HDD'];

    return (
        <RadioGroup aria-labelledby="storage-type-label" defaultValue="ssd">
            <div id="storage-type-label" className="text-sm font-bold">Storage type</div>
            {% for value, name in types %}
                <label key={{ value }} className="flex items-center gap-2 text-sm">
                    <Radio value={{ value }}>
                        <RadioIndicator />
                    </Radio>
                    {{ name }}
                </label>
            {% endfor %}
        </RadioGroup>
    );
}

/**
 * Rendering as a native button.
 *
 * By default, `Radio` renders a `<span>` element to support enclosing labels. Prefer rendering
 * each radio as a native button with `nativeButton` when using sibling labels (`for`/`id`).
 */
#[Component]
function RadioGroupNativeButtonDemo(): Node
{
    $types = ['ssd' => 'SSD', 'hdd' => 'HDD'];

    return (
        <RadioGroup aria-labelledby="storage-type" defaultValue="ssd">
            <div id="storage-type" className="text-sm font-bold">Storage type</div>
            {% for value, name in types %}
                <div key={{ value }} className="flex items-center gap-2 text-sm">
                    <Radio id="storage-type-{{ value }}" value={{ value }} nativeButton>
                        <RadioIndicator />
                    </Radio>
                    <label htmlFor="storage-type-{{ value }}">{{ name }}</label>
                </div>
            {% endfor %}
        </RadioGroup>
    );
}

/**
 * Form integration.
 *
 * Use Field and Fieldset for group labeling and form integration.
 */
#[Component]
function RadioGroupFormDemo(): Node
{
    $types = ['ssd' => 'SSD', 'hdd' => 'HDD'];

    return (
        <Form>
            <Field>
                <Fieldset>
                    <FieldsetLegend className="text-sm">Storage type</FieldsetLegend>
                    <RadioGroup aria-label="Storage type" name="storageType" defaultValue="ssd">
                        {% for value, name in types %}
                            <FieldItem key={{ value }}>
                                <FieldLabel className="flex items-center gap-2 font-normal">
                                    <Radio value={{ value }}>
                                        <RadioIndicator />
                                    </Radio>
                                    {{ name }}
                                </FieldLabel>
                            </FieldItem>
                        {% endfor %}
                    </RadioGroup>
                </Fieldset>
            </Field>
        </Form>
    );
}
