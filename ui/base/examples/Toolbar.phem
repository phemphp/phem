<?phem

namespace Phem\Ui\Base\Examples;

use Phem\Attribute\Component;
use Phem\Node;
use Phem\Ui\Base\{Menu, NumberField, Select, ToggleGroup, Toolbar, Tooltip};

use function Phem\Ui\Base\{MenuItem, MenuPopup, MenuTrigger, NumberFieldDecrement, NumberFieldGroup, NumberFieldIncrement, NumberFieldInput, SelectIcon, SelectItem, SelectItemIndicator, SelectItemText, SelectList, SelectPopup, SelectTrigger, SelectValue, Toggle, ToolbarButton, ToolbarGroup, ToolbarLink, ToolbarSeparator, TooltipPopup, TooltipTrigger};

/**
 * A container for grouping a set of buttons and controls.
 */
#[Component]
function ToolbarHeroDemo(): Node
{
    return (
        <Toolbar className="w-150">
            <ToggleGroup aria-label="Alignment">
                <Toggle aria-label="Align left" value="align-left">Align Left</Toggle>
                <Toggle aria-label="Align right" value="align-right">Align Right</Toggle>
            </ToggleGroup>
            <ToolbarSeparator />
            <ToolbarGroup aria-label="Numerical format">
                <ToolbarButton aria-label="Format as currency" className="px-0">$</ToolbarButton>
                <ToolbarButton aria-label="Format as percent" className="px-0">%</ToolbarButton>
            </ToolbarGroup>
            <ToolbarSeparator />
            <Select defaultValue="Helvetica" sideOffset={{ 4 }}>
                <SelectTrigger>
                    <SelectValue />
                    <SelectIcon />
                </SelectTrigger>
                <SelectPopup>
                    <SelectList>
                        <SelectItem value="Helvetica">
                            <SelectItemIndicator />
                            <SelectItemText>Helvetica</SelectItemText>
                        </SelectItem>
                        <SelectItem value="Arial">
                            <SelectItemIndicator />
                            <SelectItemText>Arial</SelectItemText>
                        </SelectItem>
                    </SelectList>
                </SelectPopup>
            </Select>
            <ToolbarSeparator />
            <ToolbarLink href="#">Edited 51m ago</ToolbarLink>
        </Toolbar>
    );
}

/**
 * Using with Menu.
 *
 * All popup components that provide a `Trigger` component can be integrated with a toolbar: in a
 * `Toolbar`, the trigger is an item of the toolbar, with the look of a `ToolbarButton`.
 *
 * This applies to `AlertDialog`, `Dialog`, `Menu`, `Popover`, and `Select`.
 */
#[Component]
function ToolbarMenuDemo(): Node
{
    return (
        <Toolbar aria-label="Document">
            <ToolbarButton>Save</ToolbarButton>
            <Menu sideOffset={{ 4 }}>
                <MenuTrigger>Export</MenuTrigger>
                <MenuPopup>
                    <MenuItem>PDF</MenuItem>
                    <MenuItem>PNG</MenuItem>
                    <MenuItem>SVG</MenuItem>
                </MenuPopup>
            </Menu>
        </Toolbar>
    );
}

/**
 * Using with Tooltip.
 *
 * A `TooltipTrigger` in a `Toolbar` is an item of the toolbar.
 */
#[Component]
function ToolbarTooltipDemo(): Node
{
    return (
        <Toolbar aria-label="Text formatting">
            <Tooltip sideOffset={{ 10 }}>
                <TooltipTrigger aria-label="Bold">
                    <BoldIcon />
                </TooltipTrigger>
                <TooltipPopup>Bold</TooltipPopup>
            </Tooltip>
            <Tooltip sideOffset={{ 10 }}>
                <TooltipTrigger aria-label="Italic">
                    <ItalicIcon />
                </TooltipTrigger>
                <TooltipPopup>Italic</TooltipPopup>
            </Tooltip>
        </Toolbar>
    );
}

/**
 * Using with NumberField.
 *
 * A `NumberFieldInput` in a `Toolbar` is an item of the toolbar, as a `ToolbarInput`.
 */
#[Component]
function ToolbarNumberFieldDemo(): Node
{
    return (
        <Toolbar aria-label="Zoom">
            <ToolbarButton>Fit</ToolbarButton>
            <NumberField id="zoom" defaultValue={{ 100 }} min={{ 10 }} max={{ 400 }} step={{ 10 }}>
                <NumberFieldGroup>
                    <NumberFieldDecrement />
                    <NumberFieldInput aria-label="Zoom" />
                    <NumberFieldIncrement />
                </NumberFieldGroup>
            </NumberField>
        </Toolbar>
    );
}
