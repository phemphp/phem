<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context, Prop, Provide};
use Phem\{Bound, Html, Node};

/**
 * A text field with a list of suggestions: Base UI Combobox.Root, on the `phem-combobox` controller.
 *
 * The browser filters a list that the server renders one time, as in Base UI: set `filter` to
 * `contains` or `starts-with`. A choice writes the label of the item in the input. With `multiple`,
 * the browser also keeps the chosen items: render a ComboboxChip with a `value` for each item, and
 * the chips of the chosen items show. For a long list,
 * the server filters: bind the input to a state (`phem:bind`), filter the items in the render, and
 * choose an item in the handler of its `onClick`. The server marks the chosen items with
 * `selected`. For the Async search of Base UI, search in the `onChange` handler of the input, and
 * bind the root to a state with `phem:bind`: the browser selects one item (`selectionMode` is
 * `single`), and keeps the selected item in the list. With `multiple`, the browser keeps the items
 * of the chips (a ComboboxChip with a `value`). A ComboboxStatus shows the state of the search.
 * An item with an `onClick` handler shows its choice before the server answers: with `multiple`,
 * a ComboboxChipTemplate gives the chip. While the handler runs, the ComboboxChipRemove of the
 * chip (or the ComboboxClear) shows a spinner. When the handler fails, it shows a warning, and
 * after one second the choice goes. In a form that sends the choice on submit, give the root a
 * `name` and a `selectionMode` (`single`, or `multiple` with `multiple`), and the items no
 * handler: the browser keeps the selection, also with a list of the server. With `multiple`, a
 * ComboboxChipTemplate gives the chips of the choices.
 * Give an `id`: the ids of the input and the items start with it, so the highlight stays on its
 * item through the morph.
 *
 * `mode` is the `aria-autocomplete` of the input (`list`, `both`, `inline`, `none`).
 *
 * `autoHighlight` gives the highlight to the first item when the user types; `'always'` gives an
 * open list a highlight at all times. `keepHighlight` keeps the highlight when the pointer leaves
 * the items, and `highlightItemOnHover: false` stops the highlight on hover. With no ComboboxPopup,
 * the ComboboxList is inline and always open (a command palette). `grid` makes the list a grid:
 * put the items in ComboboxRow parts.
 *
 * The props of the Base UI Positioner are props of the root. The popup goes in the top layer
 * (`popover="manual"`), so it needs no Portal.
 *
 * @aliases multiselect, searchable select, tags input, chips, picker
 */
#[Component, Provide]
class Combobox
{
    #[Prop] public string $id;
    #[Prop] public bool $multiple = false;
    #[Prop] public ?string $filter = null;
    #[Prop] public ?string $mode = null;
    #[Prop] public ?int $limit = null;
    #[Prop] public ?string $locale = null;
    #[Prop] public bool|string $autoHighlight = false;
    #[Prop] public bool $keepHighlight = false;
    #[Prop] public bool $highlightItemOnHover = true;
    #[Prop] public bool $grid = false;
    #[Prop] public bool $loopFocus = true;
    #[Prop] public Side $side = Side::Bottom;
    #[Prop] public Align $align = Align::Start;
    #[Prop] public int $sideOffset = 4;
    #[Prop] public int $alignOffset = 0;
    #[Prop] public int $collisionPadding = 5;
    /**
     * The name of the selected value in a form: a hidden input gets the `value` of the selected
     * item. With `multiple`, each ComboboxChip with a `value` (and the chip of a
     * ComboboxChipTemplate) has a hidden input with the value of its item.
     */
    #[Prop] public ?string $name = null;
    /**
     * The `value` of the selected item, bound to a state with `phem:bind`: the browser selects (the
     * `single` selection mode, with no `multiple`), and the state gets the value with the next event.
     */
    #[Prop] public ?Bound $value = null;
    /** The `value` of the item that is selected at first (a list with `multiple`): Base UI `defaultValue`. */
    #[Prop] public string|array|null $defaultValue = null;
    /** The text of the input at first, for example the label of `defaultValue`: Base UI `defaultInputValue`. */
    #[Prop] public ?string $defaultInputValue = null;
    /**
     * `single` (one selected item, no free text), `multiple` (the browser keeps the chosen items) or
     * `none` (the browser keeps no selection: the handlers of the server choose). Null gives the Base
     * UI default of the component.
     */
    #[Prop] public ?string $selectionMode = null;
    /** A click on the input opens the popup. Null gives the Base UI default of the component. */
    #[Prop] public ?bool $openOnInputClick = null;
    #[Prop] public ?Html $children = null;
    #[Prop(rest: true)] public array $attrs = [];

    public function partId(string $part): string
    {
        return $this->id.'-'.$part;
    }

    /** Whether the browser has all the items (`filter`), so it keeps the selection and can open with no text. */
    protected function hasClientList(): bool
    {
        return null !== $this->filter && '' !== $this->filter;
    }

    /**
     * The selection of Base UI: a Combobox with a list of the browser has one selected item, and
     * its input has no free text, or with `multiple` the chosen items. A bound `value` with no
     * `multiple` is one selected item. An Autocomplete has no selection.
     */
    public function resolvedSelectionMode(): string
    {
        if (null !== $this->selectionMode) {
            return $this->selectionMode;
        }

        if ($this->hasClientList()) {
            return $this->multiple ? 'multiple' : 'single';
        }

        return null !== $this->value && !$this->multiple ? 'single' : 'none';
    }

    /** Whether the item with this `value` is selected: the bound value, or `defaultValue`. */
    public function isSelected(string $value): bool
    {
        $selected = null !== $this->value ? $this->value->value : $this->defaultValue;

        return \in_array($value, array_map(strval(...), (array) ($selected ?? [])), true);
    }

    /**
     * A click on the input opens the popup of a Combobox with a list of the browser, a `single`
     * selection or `multiple`. A list of the server with no selection has no item before the user
     * types, and an Autocomplete opens only on a key.
     */
    public function resolvedOpenOnInputClick(): bool
    {
        return $this->openOnInputClick ?? ($this->hasClientList() || $this->multiple || 'single' === $this->resolvedSelectionMode());
    }

    /** The popup opens and closes with an animation. The popup of an Autocomplete has none, as in Base UI. */
    public function animatesPopup(): bool
    {
        return true;
    }

    public function render(): Node
    {
        $selectionMode = $this->resolvedSelectionMode();
        $openOnInputClick = $this->resolvedOpenOnInputClick();
        $highlight = true === $this->autoHighlight ? 'true' : ($this->autoHighlight ?: null);

        return (
            <div
                data-controller="phem-combobox"
                data-phem-combobox-selection-mode-value={{ 'none' === selectionMode ? null : selectionMode }}
                data-phem-combobox-open-on-input-click-value={{ openOnInputClick ? 'true' : null }}
                data-phem-combobox-multiple-value={{ multiple ? 'true' : null }}
                data-phem-combobox-filter-value={{ filter }}
                data-phem-combobox-mode-value={{ mode }}
                data-phem-combobox-limit-value={{ limit }}
                data-phem-combobox-locale-value={{ locale }}
                data-phem-combobox-auto-highlight-value={{ highlight }}
                data-phem-combobox-keep-highlight-value={{ keepHighlight ? 'true' : null }}
                data-phem-combobox-highlight-item-on-hover-value={{ highlightItemOnHover ? null : 'false' }}
                data-phem-combobox-grid-value={{ grid ? 'true' : null }}
                data-phem-combobox-loop-focus-value={{ loopFocus ? null : 'false' }}
                data-phem-combobox-side-value={{ side.value }}
                data-phem-combobox-align-value={{ align.value }}
                data-phem-combobox-side-offset-value={{ sideOffset }}
                data-phem-combobox-align-offset-value={{ alignOffset }}
                data-phem-combobox-collision-padding-value={{ collisionPadding }}
                className={{ classes('relative flex flex-col gap-1 text-sm leading-5 font-bold text-foreground') }}
                {{ ...attrs }}
            >
                {{ children }}
                {% if (name or value) and 'single' === selectionMode %}<input type="hidden" name={{ name }} phem:bind={{ value }} value={{ defaultValue }} data-phem-combobox-target="value" />{% endif %}
            </div>
        );
    }
}

/** The label of the input. */
#[Component]
function ComboboxLabel(#[Context] Combobox $combobox, ?Html $children = null, mixed ...$rest): Node
{
    $for = $combobox->partId('input');

    return <label htmlFor={{ for }} className={{ classes('') }} {{ ...rest }}>{{ children }}</label>;
}

/**
 * The place of the input, the clear button and the trigger: the buttons go over the end of the
 * input. A press on the group out of the input and the buttons gives the focus to the input. The
 * input fills the group: give the group its width. With `multiple`, put the ComboboxChips in it:
 * the chips are the box.
 */
#[Component]
function ComboboxInputGroup(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-combobox-target="inputGroup"
            className={{ classes('relative w-56 [&>input]:w-full [&>input]:pr-[calc(0.5rem+2rem)] has-[.combobox-clear:not([hidden])]:[&>input]:pr-[calc(0.5rem+2rem*2)] has-[>.combobox-chips]:w-fit') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/**
 * The text field. Search in its `onChange` handler: the event gives the text of the user in
 * `value` (no text while the input shows the label of the selection). Or bind it to a state of the
 * app with `phem:bind`.
 *
 * The input has its own border, also in a ComboboxInputGroup. In the ComboboxChips, the chips are
 * the box: put the input directly in the ComboboxChips, and it has no border.
 *
 * With `multiple` and a list of the browser, the `placeholder` shows only when no item is chosen,
 * and `selectedDescription` is the `aria-description` while an item is chosen: `{count}` is the
 * number of the chosen items.
 */
#[Component]
function ComboboxInput(#[Context] Combobox $combobox, ?Bound $value = null, ?string $selectedDescription = null, mixed ...$rest): Node
{
    $id = $combobox->partId('input');
    $text = $combobox->defaultInputValue;

    return (
        <input
            id={{ id }}
            phem:bind={{ value }}
            value={{ text }}
            data-phem-combobox-description={{ selectedDescription }}
            phem:live
            data-phem-combobox-target="input"
            className={{ classes('h-8 w-64 border border-input rounded-control bg-background px-2 text-sm any-pointer-coarse:text-base font-normal text-foreground placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-1 focus:outline-ring') }}
            {{ ...rest }}
        />
    );
}

/** The buttons at the end of the input group: put a ComboboxClear and a ComboboxTrigger in it. */
#[Component]
function ComboboxActions(?Html $children = null, mixed ...$rest): Node
{
    return <div className={{ classes('absolute right-0 bottom-0 flex h-full items-center justify-center text-muted-foreground') }} {{ ...rest }}>{{ children }}</div>;
}

/** The button that opens and closes the popup. Give it an `aria-label`. */
#[Component]
function ComboboxTrigger(?Html $children = null, mixed ...$rest): Node
{
    return (
        <button
            type="button"
            tabindex="-1"
            data-phem-combobox-target="trigger"
            className={{ classes('flex h-full w-6 items-center justify-center border-0 bg-transparent p-0 text-foreground') }}
            {{ ...rest }}
        >
            {{ children ? children : <CaretDownIcon /> }}
        </button>
    );
}

/**
 * The label of the selected item, or the `placeholder`, in a trigger: for a combobox with its
 * input in the popup.
 */
#[Component]
function ComboboxValue(?string $placeholder = null, mixed ...$rest): Node
{
    return <span data-phem-combobox-target="value" placeholder={{ placeholder }} data-placeholder={{ placeholder ? '' : null }} className={{ classes('data-placeholder:text-muted-foreground') }} {{ ...rest }}>{{ placeholder }}</span>;
}

/** The icon of a trigger that shows the value. */
#[Component]
function ComboboxIcon(?Html $children = null, mixed ...$rest): Node
{
    return <span aria-hidden="true" className={{ classes('flex text-foreground') }} {{ ...rest }}>{{ children ? children : <CaretUpDownIcon /> }}</span>;
}

/**
 * The button that clears the input. Give it an `aria-label`. While the handler of the selected
 * item runs, it shows a spinner (`data-pending`), and a warning when the handler fails
 * (`data-failed`).
 */
#[Component]
function ComboboxClear(?Html $children = null, mixed ...$rest): Node
{
    return (
        <button
            type="button"
            tabindex="-1"
            data-phem-combobox-target="clear"
            className={{ classes('combobox-clear group/clear flex h-full w-6 items-center justify-center border-0 bg-transparent [&[hidden]]:hidden p-0 text-foreground') }}
            {{ ...rest }}
        >
            <span className="contents group-data-pending/clear:hidden group-data-failed/clear:hidden">{{ children ? children : <XIcon /> }}</span>
            <ComboboxSpinner className="group-data-pending/clear:inline-block" />
            <WarningIcon className="hidden text-destructive group-data-failed/clear:block" />
        </button>
    );
}

/**
 * The spinner of a choice that waits for the server. It is hidden: a variant of its button shows
 * it.
 */
#[Component]
function ComboboxSpinner(mixed ...$rest): Node
{
    return <span aria-hidden="true" className={{ classes('hidden size-3 animate-spin rounded-full border border-current border-r-transparent') }} {{ ...rest }}></span>;
}

/** The popup of the list. In an Autocomplete it has no animation, as in Base UI. */
#[Component]
function ComboboxPopup(#[Context] Combobox $combobox, ?Html $children = null, mixed ...$rest): Node
{
    $animation = !$combobox->animatesPopup() ? '' : 'transition-[scale,opacity] duration-100 data-starting-style:scale-95 data-starting-style:opacity-0 data-ending-style:scale-95 data-ending-style:opacity-0';

    return (
        <div
            data-phem-combobox-target="popup"
            popover="manual"
            hidden
            className={{ classes('m-0 inset-auto overflow-visible w-[var(--anchor-width)] max-w-[var(--available-width)] origin-[var(--transform-origin)] border border-border bg-popover text-popover-foreground rounded-popup shadow-popup [&[hidden]]:hidden', animation) }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/**
 * The list of the items in the popup (`listbox`). The browser filters its ComboboxItem parts while
 * the user types.
 */
#[Component]
function ComboboxList(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-combobox-target="list"
            tabindex="-1"
            className={{ classes('max-h-[min(22.5rem,var(--available-height))] overflow-y-auto overscroll-contain py-1 scroll-py-1 outline-0 data-empty:p-0') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/** A row of items in a list with `grid`. */
#[Component]
function ComboboxRow(?Html $children = null, mixed ...$rest): Node
{
    return <div role="row" data-phem-combobox-target="row" {{ ...rest }}>{{ children }}</div>;
}

/**
 * A suggestion. `value` gives its id, and the value of the selection.
 *
 * With a list of the browser (`filter` on the root), a click selects the item in the browser (with
 * `multiple`, it adds or removes the item): it needs no handler, and the items with the
 * `defaultValue` of the root are selected at first. With a
 * list of the server, a click runs its `onClick` handler, which chooses it, and the server gives
 * `selected` to the chosen items. With a list of the server and the `single` selection mode, a
 * click selects the item in the browser, and the item with the bound `value` of the root is
 * selected. `label` is the text of the item for the input and the filter, when it is not the text
 * of the item.
 */
#[Component]
function ComboboxItem(#[Context] Combobox $combobox, string $value, ?string $label = null, bool $selected = false, bool $disabled = false, ?Html $children = null, mixed ...$rest): Node
{
    $id = $combobox->partId('item-'.$value);
    $selected = $selected || $combobox->isSelected($value);

    return (
        <div
            id={{ id }}
            data-value={{ value }}
            data-label={{ label }}
            aria-selected={{ combobox.multiple ? (selected ? 'true' : 'false') : null }}
            aria-disabled={{ disabled ? 'true' : null }}
            data-selected={{ selected ? '' : null }}
            data-disabled={{ disabled ? '' : null }}
            data-phem-combobox-target="item"
            className={{ classes('group grid cursor-default grid-cols-[1rem_1fr] items-center gap-2 p-2 text-sm leading-4 font-normal outline-none select-none data-highlighted:relative data-highlighted:z-0 data-highlighted:text-highlight-foreground data-highlighted:before:absolute data-highlighted:before:inset-0 data-highlighted:before:z-[-1] data-highlighted:before:bg-highlight data-disabled:text-muted-foreground') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/** The check of a chosen item. */
#[Component]
function ComboboxItemIndicator(?Html $children = null, mixed ...$rest): Node
{
    return <span aria-hidden="true" className={{ classes('col-start-1 hidden group-data-selected:block') }} {{ ...rest }}>{{ children ? children : <CheckIcon /> }}</span>;
}

/** The label of an item, in the column after the indicator. */
#[Component]
function ComboboxItemLabel(?Html $children = null, mixed ...$rest): Node
{
    return <span className={{ classes('col-start-2') }} {{ ...rest }}>{{ children }}</span>;
}

/** The text that shows when the list has no item. */
#[Component]
function ComboboxEmpty(?Html $children = null, mixed ...$rest): Node
{
    return <div data-phem-combobox-target="empty" className={{ classes('py-4 pr-4 pl-2 text-sm leading-4 font-normal text-muted-foreground empty:m-0 empty:p-0') }} {{ ...rest }}>{{ children }}</div>;
}

/**
 * A text for screen readers, such as the number of results (`role="status"`).
 *
 * For a search of the server, give the texts of its states: `pending` shows with a spinner while
 * the search runs, `error` when the search fails (the handler of the input throws), `idle` when the
 * input has no text and the list has no item, and `empty` when no item matches the text. The
 * browser shows one of them, and the content always shows. With no text to show, the status hides.
 */
#[Component]
function ComboboxStatus(?string $idle = null, ?string $pending = null, ?string $empty = null, ?string $error = null, ?Html $children = null, mixed ...$rest): Node
{
    if (null === $idle && null === $pending && null === $empty && null === $error) {
        return <div data-phem-combobox-target="status" className={{ classes('px-2 py-1 text-sm font-normal text-muted-foreground') }} {{ ...rest }}>{{ children }}</div>;
    }

    $part = 'flex items-center gap-2 [&[hidden]]:hidden';

    return (
        <div data-phem-combobox-target="status" className={{ classes('py-1 pr-5 pl-2 text-sm leading-5 font-normal text-muted-foreground [&:not(:has(>:not([hidden]):not(:empty)))]:hidden') }} {{ ...rest }}>
            {% if pending is not null %}
                <span data-phem-combobox-status="pending" hidden className={{ part }}>
                    <span aria-hidden="true" className="inline-block size-3 animate-spin rounded-full border border-current border-r-transparent"></span>
                    {{ pending }}
                </span>
            {% endif %}
            {% if error is not null %}<span data-phem-combobox-status="error" hidden className={{ part }}>{{ error }}</span>{% endif %}
            {% if idle is not null %}<span data-phem-combobox-status="idle" hidden className={{ part }}>{{ idle }}</span>{% endif %}
            {% if empty is not null %}<span data-phem-combobox-status="empty" hidden className={{ part }}>{{ empty }}</span>{% endif %}
            {% if children %}<span className="empty:hidden">{{ children }}</span>{% endif %}
        </div>
    );
}

/** A group of items in the list, with a ComboboxGroupLabel. */
#[Component]
function ComboboxGroup(?Html $children = null, mixed ...$rest): Node
{
    return <div role="group" data-phem-combobox-target="group" {{ ...rest }}>{{ children }}</div>;
}

/** The label of a ComboboxGroup. */
#[Component]
function ComboboxGroupLabel(?Html $children = null, mixed ...$rest): Node
{
    return <div data-phem-combobox-target="groupLabel" className={{ classes('px-2 py-2 text-sm leading-4 font-normal text-muted-foreground select-none') }} {{ ...rest }}>{{ children }}</div>;
}

/** A line between two items or two groups of the list. */
#[Component]
function ComboboxSeparator(mixed ...$rest): Node
{
    return <div role="separator" aria-orientation="horizontal" data-orientation="horizontal" className={{ classes('mx-1 my-1 h-px bg-border') }} {{ ...rest }} />;
}

/**
 * The box of the chips and the input, for a combobox with `multiple`: it grows with the rows of
 * the chips. Put it in a ComboboxInputGroup, and put the ComboboxInput directly in it. It gets
 * `role="toolbar"` while a chip shows. With a list of the browser, its `aria-label` shows only
 * when an item is chosen.
 */
#[Component]
function ComboboxChips(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-combobox-target="chips"
            className={{ classes('combobox-chips flex min-h-8 w-64 min-[32rem]:w-[22rem] cursor-text flex-wrap items-center gap-1 border border-input rounded-control bg-background px-2 py-1 has-[button]:px-1 focus-within:outline-2 focus-within:-outline-offset-1 focus-within:outline-ring [&>input]:h-[calc(1.5rem-2px)] [&>input]:w-auto [&>input]:min-w-12 [&>input]:flex-1 [&>input]:border-0 [&>input]:p-0 [&>input]:focus:outline-none') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/**
 * A chosen value, for a combobox with `multiple`. Give it an `aria-label`.
 *
 * With a list of the browser, render a chip for each item, with the `value` of its item: the
 * browser shows the chips of the chosen items, in the order of the choices. With a `name` on the
 * root, the chip has a hidden input with its `value`, so a form sends the chosen values. The chip
 * of a ComboboxChipTemplate also has it: its input gets the value of the item. A chip with no
 * `value` out of a template has no input.
 */
#[Component]
function ComboboxChip(#[Context] Combobox $combobox, #[Context] ?ComboboxChipTemplate $template = null, ?string $value = null, ?Html $children = null, mixed ...$rest): Node
{
    $hidden = null !== $value && 'multiple' === $combobox->resolvedSelectionMode() && !$combobox->isSelected($value);
    // The chip of a template gets the value of the item in the browser.
    $field = null !== $template ? '{value}' : $value;
    $name = $combobox->multiple && null !== $field ? $combobox->name : null;

    return (
        <div
            data-phem-combobox-target="chip"
            data-value={{ value }}
            hidden={{ hidden }}
            aria-description="Press Backspace or Delete to remove"
            className={{ classes('group flex min-h-[calc(1.5rem-2px)] cursor-default items-center gap-1 overflow-hidden bg-accent py-0 pr-[0.2rem] pl-[0.4rem] text-sm leading-none font-normal text-foreground outline-none focus-within:bg-highlight focus-within:text-highlight-foreground [@media(hover:hover)]:data-highlighted:bg-highlight [@media(hover:hover)]:data-highlighted:text-highlight-foreground [&[hidden]]:hidden') }}
            {{ ...rest }}
        >
            {{ children }}
            {% if name is not null %}<input type="hidden" name={{ name }} value={{ field }} disabled={{ hidden }} />{% endif %}
        </div>
    );
}

/**
 * The chip that the browser shows at once for a choice of the server, before the handler of the
 * item answers, or for a choice that the browser keeps (the `multiple` selection mode with a list
 * of the server): put a ComboboxChip with no `value` in it. `{label}` in its text and its
 * attributes is the label of the item, and `{value}` in its attributes the value of the item. Put
 * it after the chips of the server, in the ComboboxChips.
 */
#[Component, Provide]
class ComboboxChipTemplate
{
    #[Prop] public ?Html $children = null;

    public function render(): Node
    {
        return <template data-phem-combobox-target="chipTemplate">{{ children }}</template>;
    }
}

/**
 * The button that removes a chip. Give it an `aria-label`. With a list of the browser, a click
 * removes the chosen item. Else give it an `onClick` handler. On the chip of a ComboboxChipTemplate,
 * it shows a spinner while the handler of the item runs, and a warning when the handler fails.
 */
#[Component]
function ComboboxChipRemove(?Html $children = null, mixed ...$rest): Node
{
    return (
        <button
            type="button"
            data-phem-combobox-target="chipRemove"
            className={{ classes('flex size-4 items-center justify-center border-0 bg-transparent p-0 text-inherit hover:bg-accent-active group-focus-within:hover:bg-highlight-foreground/20 group-data-pending:pointer-events-none group-data-failed:pointer-events-none') }}
            {{ ...rest }}
        >
            <span className="contents group-data-pending:hidden group-data-failed:hidden">{{ children ? children : <XIcon /> }}</span>
            <ComboboxSpinner className="group-data-pending:inline-block" />
            <WarningIcon className="hidden text-destructive group-data-failed:block" />
        </button>
    );
}
