<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context, Prop, Provide};
use Phem\{Bound, Html, Node};

/**
 * A text field with a list of suggestions: Base UI Combobox.Root, on the `phem-combobox` controller.
 *
 * The browser filters a list that the server renders one time, as in Base UI: set `filter` to
 * `contains` or `starts-with`. A choice writes the label of the item in the input. For a long list,
 * the server filters: bind the input to a state (`phem:bind`), filter the items in the render, and
 * choose an item in the handler of its `onClick`. The server marks the chosen items with
 * `selected`. Give an `id`: the ids of the input and the items start with it, so the highlight stays
 * on its item through the morph.
 *
 * `mode` is the `aria-autocomplete` of the input (`list`, `both`, `inline`, `none`).
 *
 * The props of the Base UI Positioner are props of the root. The popup goes in the top layer
 * (`popover="manual"`), so it needs no Portal.
 */
#[Component, Provide]
class Combobox
{
    #[Prop] public string $id;
    #[Prop] public bool $multiple = false;
    #[Prop] public ?string $filter = null;
    #[Prop] public ?string $mode = null;
    #[Prop] public ?int $limit = null;
    #[Prop] public ?string $locale = null;
    #[Prop] public bool $autoHighlight = false;
    #[Prop] public bool $loopFocus = true;
    #[Prop] public Side $side = Side::Bottom;
    #[Prop] public Align $align = Align::Start;
    #[Prop] public int $sideOffset = 4;
    #[Prop] public int $alignOffset = 0;
    #[Prop] public int $collisionPadding = 5;
    /** The name of the selected value in a form: a hidden input gets the `value` of the selected item. */
    #[Prop] public ?string $name = null;
    /** The `value` of the item that is selected at first: Base UI `defaultValue`. */
    #[Prop] public ?string $defaultValue = null;
    /** The text of the input at first, for example the label of `defaultValue`: Base UI `defaultInputValue`. */
    #[Prop] public ?string $defaultInputValue = null;
    /** `single` (one selected item, no free text) or `none`. Null gives the Base UI default of the component. */
    #[Prop] public ?string $selectionMode = null;
    /** A click on the input opens the popup. Null gives the Base UI default of the component. */
    #[Prop] public ?bool $openOnInputClick = null;
    #[Prop] public ?Html $children = null;
    #[Prop(rest: true)] public array $attrs = [];

    public function partId(string $part): string
    {
        return $this->id.'-'.$part;
    }

    /** Whether the browser has all the items (`filter`), so it keeps the selection and can open with no text. */
    protected function hasClientList(): bool
    {
        return null !== $this->filter && '' !== $this->filter;
    }

    /**
     * The selection of Base UI: a Combobox with a list of the browser has one selected item, and
     * its input has no free text. An Autocomplete has no selection.
     */
    public function resolvedSelectionMode(): string
    {
        return $this->selectionMode ?? ($this->hasClientList() && !$this->multiple ? 'single' : 'none');
    }

    /**
     * A click on the input opens the popup of a Combobox with a list of the browser. A list of the
     * server has no item before the user types, and an Autocomplete opens only on a key.
     */
    public function resolvedOpenOnInputClick(): bool
    {
        return $this->openOnInputClick ?? $this->hasClientList();
    }

    /** The popup opens and closes with an animation. The popup of an Autocomplete has none, as in Base UI. */
    public function animatesPopup(): bool
    {
        return true;
    }

    public function render(): Node
    {
        $selectionMode = $this->resolvedSelectionMode();
        $openOnInputClick = $this->resolvedOpenOnInputClick();

        return (
            <div
                data-controller="phem-combobox"
                data-phem-combobox-selection-mode-value={{ 'single' === selectionMode ? 'single' : null }}
                data-phem-combobox-open-on-input-click-value={{ openOnInputClick ? 'true' : null }}
                data-phem-combobox-multiple-value={{ multiple ? 'true' : null }}
                data-phem-combobox-filter-value={{ filter }}
                data-phem-combobox-mode-value={{ mode }}
                data-phem-combobox-limit-value={{ limit }}
                data-phem-combobox-locale-value={{ locale }}
                data-phem-combobox-auto-highlight-value={{ autoHighlight ? 'true' : null }}
                data-phem-combobox-loop-focus-value={{ loopFocus ? null : 'false' }}
                data-phem-combobox-side-value={{ side.value }}
                data-phem-combobox-align-value={{ align.value }}
                data-phem-combobox-side-offset-value={{ sideOffset }}
                data-phem-combobox-align-offset-value={{ alignOffset }}
                data-phem-combobox-collision-padding-value={{ collisionPadding }}
                className={{ classes('relative flex flex-col gap-1 text-sm leading-5 font-bold text-neutral-950 dark:text-white') }}
                {{ ...attrs }}
            >
                {{ children }}
                {% if name and 'single' === selectionMode %}<input type="hidden" name={{ name }} value={{ defaultValue }} data-phem-combobox-target="value" />{% endif %}
            </div>
        );
    }
}

/** The label of the input. */
#[Component]
function ComboboxLabel(#[Context] Combobox $combobox, ?Html $children = null, mixed ...$rest): Node
{
    $for = $combobox->partId('input');

    return <label htmlFor={{ for }} className={{ classes('') }} {{ ...rest }}>{{ children }}</label>;
}

/** The box around the input, the clear button and the trigger. */
#[Component]
function ComboboxInputGroup(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-combobox-target="inputGroup"
            className={{ classes('relative h-8 w-56 border border-neutral-950 bg-white dark:bg-neutral-950 focus-within:outline-2 focus-within:-outline-offset-1 focus-within:outline-neutral-950 dark:focus-within:outline-white dark:border-white [&>input]:pr-[calc(0.5rem+2rem)] has-[.combobox-clear:not([hidden])]:[&>input]:pr-[calc(0.5rem+2rem*2)]') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/** The text field. Bind it to a state of the app with `phem:bind` and `phem:live`. */
#[Component]
function ComboboxInput(#[Context] Combobox $combobox, ?Bound $value = null, mixed ...$rest): Node
{
    $id = $combobox->partId('input');
    $text = $combobox->defaultInputValue;

    return (
        <input
            id={{ id }}
            phem:bind={{ value }}
            value={{ text }}
            phem:live
            data-phem-combobox-target="input"
            className={{ classes('h-full w-full border-0 bg-white pl-2 dark:bg-neutral-950 text-sm any-pointer-coarse:text-base font-normal text-neutral-950 outline-none placeholder:text-neutral-500 dark:placeholder:text-neutral-400 dark:text-white') }}
            {{ ...rest }}
        />
    );
}

/** The buttons at the end of the input group: put a ComboboxClear and a ComboboxTrigger in it. */
#[Component]
function ComboboxActions(?Html $children = null, mixed ...$rest): Node
{
    return <div className={{ classes('absolute right-0 bottom-0 flex h-full items-center justify-center text-neutral-500 dark:text-neutral-400') }} {{ ...rest }}>{{ children }}</div>;
}

/** The button that opens and closes the popup. Give it an `aria-label`. */
#[Component]
function ComboboxTrigger(?Html $children = null, mixed ...$rest): Node
{
    return (
        <button
            type="button"
            tabindex="-1"
            data-phem-combobox-target="trigger"
            className={{ classes('flex h-full w-6 items-center justify-center border-0 bg-transparent p-0 text-neutral-950 dark:text-white') }}
            {{ ...rest }}
        >
            {{ children ? children : <CaretDownIcon /> }}
        </button>
    );
}

/** The label of the selected item, or the `placeholder`, in a trigger: for a combobox with its input in the popup. */
#[Component]
function ComboboxValue(?string $placeholder = null, mixed ...$rest): Node
{
    return <span data-phem-combobox-target="value" placeholder={{ placeholder }} data-placeholder={{ placeholder ? '' : null }} className={{ classes('data-placeholder:text-neutral-500 dark:data-placeholder:text-neutral-400') }} {{ ...rest }}>{{ placeholder }}</span>;
}

/** The icon of a trigger that shows the value. */
#[Component]
function ComboboxIcon(?Html $children = null, mixed ...$rest): Node
{
    return <span aria-hidden="true" className={{ classes('flex') }} {{ ...rest }}>{{ children ? children : <CaretUpDownIcon /> }}</span>;
}

/** The button that clears the input. Give it an `aria-label`. */
#[Component]
function ComboboxClear(?Html $children = null, mixed ...$rest): Node
{
    return (
        <button
            type="button"
            tabindex="-1"
            data-phem-combobox-target="clear"
            className={{ classes('combobox-clear flex h-full w-6 items-center justify-center border-0 bg-transparent [&[hidden]]:hidden p-0 text-neutral-950 dark:text-white') }}
            {{ ...rest }}
        >
            {{ children ? children : <XIcon /> }}
        </button>
    );
}

/** The popup of the list. In an Autocomplete it has no animation, as in Base UI. */
#[Component]
function ComboboxPopup(#[Context] Combobox $combobox, ?Html $children = null, mixed ...$rest): Node
{
    $animation = !$combobox->animatesPopup() ? '' : 'transition-[scale,opacity] duration-100 data-starting-style:scale-95 data-starting-style:opacity-0 data-ending-style:scale-95 data-ending-style:opacity-0';

    return (
        <div
            data-phem-combobox-target="popup"
            popover="manual"
            hidden
            className={{ classes('m-0 inset-auto overflow-visible w-[var(--anchor-width)] max-w-[var(--available-width)] origin-[var(--transform-origin)] border border-neutral-950 bg-white text-neutral-950 shadow-[0.25rem_0.25rem_0_rgb(0_0_0_/_12%)] dark:border-white dark:bg-neutral-950 dark:text-white dark:shadow-none [&[hidden]]:hidden', animation) }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

#[Component]
function ComboboxList(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-combobox-target="list"
            tabindex="-1"
            className={{ classes('max-h-[min(22.5rem,var(--available-height))] overflow-y-auto overscroll-contain py-1 scroll-py-1 outline-0 data-empty:p-0') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/**
 * A suggestion. `value` gives its id, and the value of the selection.
 *
 * With a list of the browser (`filter` on the root), a click selects the item in the browser: it
 * needs no handler, and the item with the `defaultValue` of the root is selected at first. With a
 * list of the server, a click runs its `onClick` handler, which chooses it, and the server gives
 * `selected` to the chosen items.
 */
#[Component]
function ComboboxItem(#[Context] Combobox $combobox, string $value, bool $selected = false, bool $disabled = false, ?Html $children = null, mixed ...$rest): Node
{
    $id = $combobox->partId('item-'.$value);
    $selected = $selected || (null !== $combobox->defaultValue && $value === $combobox->defaultValue);

    return (
        <div
            id={{ id }}
            data-value={{ value }}
            aria-selected={{ combobox.multiple ? (selected ? 'true' : 'false') : null }}
            aria-disabled={{ disabled ? 'true' : null }}
            data-selected={{ selected ? '' : null }}
            data-disabled={{ disabled ? '' : null }}
            data-phem-combobox-target="item"
            className={{ classes('group grid cursor-default grid-cols-[1rem_1fr] items-center gap-2 p-2 text-sm leading-4 font-normal outline-none select-none data-highlighted:relative data-highlighted:z-0 data-highlighted:text-white data-highlighted:before:absolute data-highlighted:before:inset-0 data-highlighted:before:z-[-1] data-highlighted:before:bg-neutral-950 dark:data-highlighted:text-neutral-950 dark:data-highlighted:before:bg-white data-disabled:text-neutral-500') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/** The check of a chosen item. */
#[Component]
function ComboboxItemIndicator(?Html $children = null, mixed ...$rest): Node
{
    return <span aria-hidden="true" className={{ classes('col-start-1 hidden group-data-selected:block') }} {{ ...rest }}>{{ children ? children : <CheckIcon /> }}</span>;
}

/** The label of an item, in the column after the indicator. */
#[Component]
function ComboboxItemLabel(?Html $children = null, mixed ...$rest): Node
{
    return <span className={{ classes('col-start-2') }} {{ ...rest }}>{{ children }}</span>;
}

/** The text that shows when the list has no item. */
#[Component]
function ComboboxEmpty(?Html $children = null, mixed ...$rest): Node
{
    return <div data-phem-combobox-target="empty" className={{ classes('py-4 pr-4 pl-2 text-sm leading-4 font-normal text-neutral-500 dark:text-neutral-400 empty:m-0 empty:p-0') }} {{ ...rest }}>{{ children }}</div>;
}

/** A text for screen readers, such as the number of results (`role="status"`). */
#[Component]
function ComboboxStatus(?Html $children = null, mixed ...$rest): Node
{
    return <div data-phem-combobox-target="status" className={{ classes('px-2 py-1 text-sm font-normal text-neutral-500 dark:text-neutral-400') }} {{ ...rest }}>{{ children }}</div>;
}

#[Component]
function ComboboxGroup(?Html $children = null, mixed ...$rest): Node
{
    return <div role="group" data-phem-combobox-target="group" {{ ...rest }}>{{ children }}</div>;
}

#[Component]
function ComboboxGroupLabel(?Html $children = null, mixed ...$rest): Node
{
    return <div data-phem-combobox-target="groupLabel" className={{ classes('px-2 py-2 text-sm leading-4 font-normal text-neutral-500 select-none dark:text-neutral-400') }} {{ ...rest }}>{{ children }}</div>;
}

#[Component]
function ComboboxSeparator(mixed ...$rest): Node
{
    return <div role="separator" aria-orientation="horizontal" data-orientation="horizontal" className={{ classes('mx-1 my-1 h-px bg-neutral-950 dark:bg-white') }} {{ ...rest }} />;
}

/** The box of the chips and the input, for a combobox with `multiple`. */
#[Component]
function ComboboxChips(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            className={{ classes('flex min-h-8 w-64 flex-wrap items-center gap-1 border border-neutral-950 bg-white px-1 py-1 dark:border-white dark:bg-neutral-950 focus-within:outline-2 focus-within:-outline-offset-1 focus-within:outline-neutral-950 dark:focus-within:outline-white [&>input]:h-6 [&>input]:min-w-12 [&>input]:flex-1 [&>input]:w-auto') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/** A chosen value, for a combobox with `multiple`. Give it an `aria-label`. */
#[Component]
function ComboboxChip(?Html $children = null, mixed ...$rest): Node
{
    return (
        <span
            data-phem-combobox-target="chip"
            aria-description="Press Backspace or Delete to remove"
            className={{ classes('flex h-6 items-center gap-1 border border-neutral-950 bg-white px-1.5 text-sm font-normal text-neutral-950 outline-none dark:border-white dark:bg-neutral-950 dark:text-white focus-visible:bg-neutral-950 focus-visible:text-white dark:focus-visible:bg-white dark:focus-visible:text-neutral-950') }}
            {{ ...rest }}
        >
            {{ children }}
        </span>
    );
}

/** The button that removes a chip. Give it an `aria-label` and an `onClick` handler. */
#[Component]
function ComboboxChipRemove(?Html $children = null, mixed ...$rest): Node
{
    return (
        <button
            type="button"
            data-phem-combobox-target="chipRemove"
            className={{ classes('flex size-4 items-center justify-center border-0 bg-transparent p-0 text-inherit') }}
            {{ ...rest }}
        >
            {{ children ? children : <XIcon width="12" height="12" /> }}
        </button>
    );
}
