<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context, Prop};
use Phem\{Html, Node};

/**
 * A menu that opens at the point of the pointer, on a right click or a long press: Base UI
 * ContextMenu.Root, on the `phem-context-menu` controller.
 *
 * Use the parts of Menu in it (MenuPopup, MenuItem, MenuSeparator…): they read the root, so they
 * get the targets of `phem-context-menu`.
 */
#[Component]
class ContextMenu extends Menu
{
    // The offsets of Base UI: the corner of the popup is under the pointer.
    #[Prop] public int $sideOffset = -5;
    #[Prop] public int $alignOffset = 2;

    public function controller(): string
    {
        return 'phem-context-menu';
    }
}

/** The area of the page that opens the menu on a right click. */
#[Component]
function ContextMenuTrigger(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('trigger');

    return (
        <div
            className={{ classes('flex aspect-5/3 w-full max-w-64 items-center justify-center rounded-control border border-input bg-background text-foreground select-none text-sm') }}
            {{ ...target }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}
