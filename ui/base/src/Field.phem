<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context, Prop, Provide};
use Phem\{Bound, Html, Node};

/**
 * A form control with a label, a description and errors: Base UI Field.Root, on the `phem-field`
 * controller. The browser validates the control (`required`, `type="email"`, `pattern`…) in the
 * `validationMode` (`onSubmit`, `onBlur`, `onChange`). An Input in a Field is its control.
 *
 * Give an `id` to link the parts with ids, as in Base UI: the control gets `<id>-control` (in
 * place of an `id` of the control), the label gets `for`, and the description and the errors get
 * `<id>-description` and `<id>-error` (`<id>-error-<match>` for an error with `match`). A field has
 * one control. Give two errors with the same `match` their own `id`. With no `id`, the controller
 * links the parts with element references, and the `for`, `aria-labelledby` and
 * `aria-describedby` attributes stay empty.
 *
 * @aliases form field, label, validation, error message
 */
#[Component, Provide]
class Field
{
    #[Prop] public ?string $validationMode = null;
    #[Prop] public int $validationDebounceTime = 0;
    #[Prop] public bool $disabled = false;
    #[Prop] public ?string $id = null;
    #[Prop] public ?Html $children = null;
    #[Prop(rest: true)] public array $attrs = [];

    public function partId(string $part): ?string
    {
        return null === $this->id ? null : $this->id.'-'.$part;
    }

    public function render(): Node
    {
        return (
            <div
                id={{ id }}
                data-controller="phem-field"
                data-phem-field-validation-mode-value={{ validationMode }}
                data-phem-field-validation-debounce-time-value={{ validationDebounceTime ?: null }}
                data-phem-field-disabled-value={{ disabled ? 'true' : null }}
                data-disabled={{ disabled ? '' : null }}
                className={{ classes('flex w-full max-w-64 flex-col items-start gap-1') }}
                {{ ...attrs }}
            >
                {{ children }}
            </div>
        );
    }
}

/** The label of the control of the Field. It points to the control (`for`). */
#[Component]
function FieldLabel(#[Context] ?Field $field = null, ?Html $children = null, mixed ...$rest): Node
{
    $for = $field?->partId('control');

    return <label htmlFor={{ for }} data-phem-field-target="label" className={{ classes('text-sm font-bold text-foreground data-disabled:text-muted-foreground') }} {{ ...rest }}>{{ children }}</label>;
}

/**
 * The control of the field: an Input with the width of the field. Bind it to a state of the app
 * with `phem:bind`, as an Input.
 */
#[Component]
function FieldControl(?Bound $value = null, mixed ...$rest): Node
{
    return <Input phem:bind={{ value }} className="w-auto self-stretch" {{ ...rest }} />;
}

/** The help text of the Field. The control gets it as its `aria-describedby`. */
#[Component]
function FieldDescription(#[Context] ?Field $field = null, ?Html $children = null, mixed ...$rest): Node
{
    $id = $field?->partId('description');

    return <p id={{ id }} data-phem-field-target="description" className={{ classes('m-0 text-sm text-muted-foreground') }} {{ ...rest }}>{{ children }}</p>;
}

/**
 * An error message. With `match` (a `ValidityState` key, such as `valueMissing`), it shows for this
 * error only. With no text, it shows the message of the browser.
 */
#[Component]
function FieldError(#[Context] ?Field $field = null, ?string $match = null, ?Html $children = null, mixed ...$rest): Node
{
    $id = $field?->partId(null === $match ? 'error' : 'error-'.$match);

    return (
        <div
            id={{ id }}
            data-phem-field-target="error"
            data-match={{ match }}
            hidden
            className={{ classes('text-sm text-destructive [&[hidden]]:hidden') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/**
 * A control of a group of choices in a field, such as a checkbox with its label: Base UI
 * Field.Item.
 */
#[Component]
function FieldItem(?Html $children = null, mixed ...$rest): Node
{
    return <div className={{ classes('flex items-center gap-2') }} {{ ...rest }}>{{ children }}</div>;
}

/**
 * A form that validates its fields before its submit: Base UI Form, on the `phem-form` controller.
 * An invalid form does not send its `onSubmit` event, and the first invalid control gets the focus.
 *
 * @aliases form validation, server errors, submit
 */
#[Component]
function Form(?string $validationMode = null, ?Html $children = null, mixed ...$rest): Node
{
    return (
        <form
            data-controller="phem-form"
            data-phem-form-validation-mode-value={{ validationMode }}
            className={{ classes('flex w-full max-w-64 flex-col gap-4') }}
            {{ ...rest }}
        >
            {{ children }}
        </form>
    );
}
