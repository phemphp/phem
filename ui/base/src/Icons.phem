<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\Component;
use Phem\Node;

// The icons of the Base UI demos (16 px). They are decorative: `aria-hidden`.

/** An icon: a plus. It inherits the color of the text (`currentColor`). */
#[Component]
function PlusIcon(mixed ...$rest): Node
{
    return <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" className={{ classes('block') }} {{ ...rest }}><path d="M1.5 8h13M8 14.5v-13" /></svg>;
}

/** An icon: a minus. It inherits the color of the text (`currentColor`). */
#[Component]
function MinusIcon(mixed ...$rest): Node
{
    return <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" className={{ classes('block') }} {{ ...rest }}><path d="M1.5 8h13" /></svg>;
}

