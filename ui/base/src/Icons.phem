    return <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" className={{ classes('block') }} {{ ...rest }}><path d="M11 10H5l3 3.5zm0-4H5l3-3.5z" /></svg>;
}

