    return <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" className={{ classes('block') }} {{ ...rest }}><path d="m4.5 4.5 7 7m-7 0 7-7" /></svg>;
