<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context};
use Phem\{Bound, Node};

/**
 * A native text input: Base UI Input. In a Field, it is the control of the field. Bind it to a state
 * of the app with `phem:bind`, or give its first value in `defaultValue`.
 */
#[Component]
function Input(#[Context] ?Field $field = null, ?Bound $value = null, ?string $defaultValue = null, bool $disabled = false, mixed ...$rest): Node
{
    $target = null !== $field ? 'control' : null;
    $id = $field?->partId('control');

    return (
        <input
            phem:bind={{ value }}
            value={{ defaultValue }}
            data-phem-field-target={{ target }}
            disabled={{ disabled }}
            data-disabled={{ disabled ? '' : null }}
            className={{ classes('h-8 w-40 border border-input rounded-control bg-background px-2 text-sm any-pointer-coarse:text-base font-normal text-foreground placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-1 focus:outline-ring data-disabled:border-muted-foreground data-disabled:text-muted-foreground') }}
            {{ ...rest }}
            id={{ id ?? rest['id'] ?? null }}
        />
    );
}
