<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context, Prop, Provide};
use Phem\{Html, Node};

/**
 * A list of actions in a popup: Base UI Menu.Root, on the `phem-menu` controller.
 *
 * The props of the Base UI Positioner are props of the root. The popup goes in the top layer
 * (`popover="manual"`), so it needs no Portal. The parts read the root, so the same parts work in
 * a ContextMenu and in a MenuSubmenu.
 *
 * As in Base UI, the menu is modal by default: the page does not scroll while it is open. A menu
 * with `openOnHover` and a menu in a Menubar are not modal. With `disabled`, the trigger does not
 * open it.
 *
 * A `handle` links the root to detached triggers: a MenuTrigger with the same `handle`, anywhere
 * in the page, opens this menu. The MenuViewport shows the MenuPayload of the `payload` of the
 * trigger that opened it, and `triggerId` is the `id` of this trigger.
 *
 * A MenuInput in the popup filters the items of the MenuList, as the FilterProvider of Base UI.
 * `autoHighlight` highlights the first match while the query is not empty (`'always'`: also when
 * it is empty). With `filter={{ false }}`, the browser hides no item: an `onInput` handler on the
 * MenuInput renders the items of the query.
 */
#[Component, Provide]
class Menu
{
    #[Prop] public ?string $handle = null;
    #[Prop] public bool $defaultOpen = false;
    #[Prop] public ?string $triggerId = null;
    #[Prop] public bool $disabled = false;
    #[Prop] public bool|string $autoHighlight = false;
    #[Prop] public bool $filter = true;
    #[Prop] public bool $modal = true;
    #[Prop] public bool $openOnHover = false;
    #[Prop] public int $delay = 100;
    #[Prop] public bool $loopFocus = true;
    #[Prop] public bool $highlightItemOnHover = true;
    #[Prop] public Orientation $orientation = Orientation::Vertical;
    #[Prop] public Side $side = Side::Bottom;
    #[Prop] public Align $align = Align::Start;
    #[Prop] public int $sideOffset = 0;
    #[Prop] public int $alignOffset = 0;
    #[Prop] public int $collisionPadding = 5;
    #[Prop] public ?Html $children = null;
    #[Prop(rest: true)] public array $attrs = [];
    #[Context] public ?Menubar $menubar = null;

    /** The Stimulus identifier of the controller of the parts. */
    public function controller(): string
    {
        return 'phem-menu';
    }

    /** The `data-<controller>-target` attribute of a part. */
    public function target(string $name): array
    {
        return ['data-'.$this->controller().'-target' => $name];
    }

    /**
     * The attributes of a checkbox item or a radio item: its role, its state and its target.
     *
     * @return array<string, string|null>
     */
    public function checkItem(string $role, bool $checked, bool $disabled, bool $closeOnClick, ?string $value = null): array
    {
        return [
            'role' => $role,
            'data-value' => $value,
            'aria-checked' => $checked ? 'true' : 'false',
            'data-checked' => $checked ? '' : null,
            'data-unchecked' => $checked ? null : '',
            'aria-disabled' => $disabled ? 'true' : null,
            'data-disabled' => $disabled ? '' : null,
            'data-'.$this->controller().'-close-on-click' => $closeOnClick ? null : 'false',
            ...$this->target('item'),
        ];
    }

    /** @return array<string, string|null> the values of the controller */
    public function values(): array
    {
        $prefix = 'data-'.$this->controller().'-';

        return [
            'id' => $this->handle,
            'data-controller' => $this->controller(),
            $prefix.'open-value' => $this->defaultOpen ? 'true' : null,
            $prefix.'trigger-id-value' => $this->triggerId,
            $prefix.'auto-highlight-value' => true === $this->autoHighlight ? 'input' : (false === $this->autoHighlight ? null : $this->autoHighlight),
            $prefix.'filter-value' => $this->filter ? null : 'false',
            // A Menubar locks the page for its menus.
            // No lock for a menu that the pointer opens: the lock takes the pointer from its trigger.
            $prefix.'modal-value' => $this->modal && !$this->openOnHover && null === $this->menubar ? 'true' : null,
            $prefix.'open-on-hover-value' => $this->openOnHover ? 'true' : null,
            $prefix.'delay-value' => 100 === $this->delay ? null : (string) $this->delay,
            $prefix.'loop-focus-value' => $this->loopFocus ? null : 'false',
            $prefix.'highlight-item-on-hover-value' => $this->highlightItemOnHover ? null : 'false',
            $prefix.'orientation-value' => $this->orientation->value,
            $prefix.'side-value' => $this->side->value,
            $prefix.'align-value' => $this->align->value,
            $prefix.'side-offset-value' => (string) $this->sideOffset,
            $prefix.'align-offset-value' => (string) $this->alignOffset,
            $prefix.'collision-padding-value' => (string) $this->collisionPadding,
        ];
    }

    public function render(): Node
    {
        $values = $this->values();

        return <div className={{ classes('contents') }} {{ ...values }} {{ ...attrs }}>{{ children }}</div>;
    }
}

/**
 * A menu in the popup of another menu: Base UI Menu.SubmenuRoot. Its trigger is a
 * MenuSubmenuTrigger, an item of the menu around it. It opens on hover after `delay`.
 */
#[Component]
class MenuSubmenu extends Menu
{
    #[Prop] public bool $openOnHover = true;
    #[Prop] public Side $side = Side::InlineEnd;
}

/**
 * The button that opens the menu. It has a caret, unless `caret` is false. In a Menubar, it has the
 * look of the bar and no caret. In a Toolbar, it is an item of the toolbar, with the look of a
 * ToolbarButton.
 *
 * With a `handle`, it is a detached trigger of the Menu with the same `handle`: it can be anywhere
 * in the page. The `payload` selects the MenuPayload that the MenuViewport shows while this
 * trigger opened the menu.
 */
#[Component]
function MenuTrigger(
    #[Context] ?Menu $menu = null,
    #[Context] ?Menubar $menubar = null,
    #[Context] ?Toolbar $toolbar = null,
    ?string $handle = null,
    ?string $payload = null,
    bool $disabled = false,
    bool $caret = true,
    ?Html $children = null,
    mixed ...$rest,
): Node {
    $disabled = $disabled || true === $menu?->disabled;
    $caret = $caret && null === $menubar;
    $controller = $menu?->controller() ?? 'phem-menu';
    $target = null === $handle ? ['data-'.$controller.'-target' => 'trigger'] : ['data-'.$controller.'-for' => $handle];
    $target['data-'.$controller.'-payload'] = $payload;
    $item = null !== $toolbar && null === $menubar ? 'item' : null;

    // A trigger with a caret has less space on the side of the caret.
    $padding = $caret ? 'pl-3 pr-2' : 'px-3';
    $base = null !== $item ? Style::TOOLBAR_BUTTON : (null !== $menubar
        ? 'h-8 border-0 bg-transparent px-3 font-[inherit] text-sm font-normal text-foreground select-none hover:not-data-disabled:bg-accent active:not-data-disabled:bg-accent-active data-pressed:bg-accent data-disabled:text-muted-foreground focus-visible:bg-accent focus-visible:outline-2 focus-visible:-outline-offset-1 focus-visible:outline-ring focus-visible:relative'
        : 'flex h-8 items-center justify-center gap-1.5 select-none data-pressed:bg-accent '.$padding.' '.Style::BUTTON_LOOK);

    return (
        <button
            type="button"
            disabled={{ disabled }}
            data-disabled={{ disabled ? '' : null }}
            data-phem-toolbar-target={{ item }}
            className={{ classes(base) }}
            {{ ...target }}
            {{ ...rest }}
        >
            {{ children }}
            {{ caret ? <CaretDownIcon /> : '' }}
        </button>
    );
}

/** The item of a menu that opens a MenuSubmenu. It has a caret on the side of the submenu. */
#[Component]
function MenuSubmenuTrigger(#[Context] Menu $menu, bool $disabled = false, ?Html $children = null, mixed ...$rest): Node
{
    $disabled = $disabled || $menu->disabled;
    $target = $menu->target('trigger');
    $base = Style::MENU_SUBMENU_TRIGGER;

    return (
        <button
            type="button"
            aria-disabled={{ disabled ? 'true' : null }}
            data-disabled={{ disabled ? '' : null }}
            className={{ classes(base) }}
            {{ ...target }}
            {{ ...rest }}
        >
            {{ children }}
            <CaretRightIcon />
        </button>
    );
}

#[Component]
function MenuPopup(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('popup');
    $base = null !== $menu->menubar ? Style::MENUBAR_POPUP : Style::MENU_POPUP;

    return <div popover="manual" hidden className={{ classes(base) }} {{ ...target }} {{ ...rest }}>{{ children }}</div>;
}

#[Component]
function MenuArrow(#[Context] Menu $menu, mixed ...$rest): Node
{
    $target = $menu->target('arrow');
    $base = Style::ARROW;

    return <div aria-hidden="true" className={{ classes(base) }} {{ ...target }} {{ ...rest }} />;
}

/**
 * An action of the menu. A click runs its handler (`onClick`) and closes the menu. With
 * `closeOnClick={{ false }}`, the menu stays open. The `label` replaces the text of the item for
 * the filter of a MenuInput.
 */
#[Component]
function MenuItem(#[Context] Menu $menu, #[Context] ?Menubar $menubar = null, bool $disabled = false, bool $closeOnClick = true, ?string $label = null, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('item');
    $close = $closeOnClick ? null : 'false';
    $closeAttr = 'data-'.$menu->controller().'-close-on-click';
    $base = null !== $menubar ? Style::MENUBAR_ITEM : Style::MENU_ITEM;

    return (
        <button
            type="button"
            aria-disabled={{ disabled ? 'true' : null }}
            data-disabled={{ disabled ? '' : null }}
            data-label={{ label }}
            className={{ classes(base) }}
            {{ ...target }}
            {{ ...{(closeAttr): close} }}
            {{ ...rest }}
        >
            {{ children }}
        </button>
    );
}

/** A link of the menu: Base UI Menu.LinkItem. */
#[Component]
function MenuLinkItem(#[Context] Menu $menu, string $href, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('item');
    $base = null !== $menu->menubar ? Style::MENUBAR_ITEM : Style::MENU_ITEM;

    return <a href={{ href }} className={{ classes(base) }} {{ ...target }} {{ ...rest }}>{{ children }}</a>;
}

#[Component]
function MenuSeparator(#[Context] Menu $menu, mixed ...$rest): Node
{
    $target = $menu->target('separator');

    return <div role="separator" aria-orientation="horizontal" data-orientation="horizontal" className={{ classes('mx-1 my-1 h-px bg-border') }} {{ ...target }} {{ ...rest }} />;
}

#[Component]
function MenuGroup(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('group');

    return <div {{ ...target }} {{ ...rest }}>{{ children }}</div>;
}

#[Component]
function MenuGroupLabel(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('groupLabel');

    return <div className={{ classes('px-4 py-2 text-sm leading-4 text-muted-foreground select-none') }} {{ ...target }} {{ ...rest }}>{{ children }}</div>;
}

/**
 * An item that the user checks and unchecks: Base UI Menu.CheckboxItem. The menu stays open.
 *
 * With `defaultChecked`, the browser keeps the state: the item needs no handler. The item sends
 * the `phem-menu:change` browser event after a change, with `checked` in its detail. With
 * `checked` and an `onClick` handler, the server keeps the state: the handler changes it. A
 * `checked` prop wins over `defaultChecked`.
 */
#[Component]
function MenuCheckboxItem(#[Context] Menu $menu, ?bool $checked = null, bool $defaultChecked = false, bool $disabled = false, bool $closeOnClick = false, ?Html $children = null, mixed ...$rest): Node
{
    $item = $menu->checkItem('menuitemcheckbox', $checked ?? $defaultChecked, $disabled, $closeOnClick);
    $base = null !== $menu->menubar ? Style::MENUBAR_CHECK_ITEM : Style::MENU_CHECK_ITEM;

    return <button type="button" className={{ classes('group', base) }} {{ ...item }} {{ ...rest }}>{{ children }}</button>;
}

/** The check of a checkbox item or a radio item. It shows only when the item is checked. */
#[Component]
function MenuItemIndicator(?Html $children = null, mixed ...$rest): Node
{
    return <span aria-hidden="true" className={{ classes('col-start-1 hidden group-data-checked:block') }} {{ ...rest }}>{{ children ? children : <CheckIcon /> }}</span>;
}

/** The label of a checkbox item or a radio item, in the column after the indicator. */
#[Component]
function MenuItemLabel(?Html $children = null, mixed ...$rest): Node
{
    return <span className={{ classes('col-start-2') }} {{ ...rest }}>{{ children }}</span>;
}

/**
 * A group of radio items: Base UI Menu.RadioGroup. The item with the value of the group is checked.
 *
 * With `defaultValue`, the browser keeps the state: the items need no handler. An item sends the
 * `phem-menu:change` browser event after a change, with its `value` in the detail. With `value`
 * and an `onClick` handler on each item, the server keeps the state. A `value` prop wins over
 * `defaultValue`.
 */
#[Component, Provide]
class MenuRadioGroup
{
    #[Prop] public ?string $value = null;
    #[Prop] public ?string $defaultValue = null;
    #[Prop] public ?Html $children = null;
    #[Prop(rest: true)] public array $attrs = [];
    #[Context] public Menu $menu;

    /** The value of the checked item, or null. */
    public function current(): ?string
    {
        return $this->value ?? $this->defaultValue;
    }

    public function render(): Node
    {
        $target = $this->menu->target('group');

        return <div {{ ...target }} {{ ...attrs }}>{{ children }}</div>;
    }
}

/**
 * An item of a radio group: Base UI Menu.RadioItem. The menu stays open.
 *
 * In a MenuRadioGroup with a value, the item is checked when its `value` is the value of the
 * group. With no group, or in a group with no value, the `checked` prop gives the state. A group
 * of a menu around a submenu is not the group of an item of the submenu.
 */
#[Component]
function MenuRadioItem(#[Context] Menu $menu, #[Context] ?MenuRadioGroup $group = null, ?string $value = null, bool $checked = false, bool $disabled = false, bool $closeOnClick = false, ?Html $children = null, mixed ...$rest): Node
{
    $current = $group?->menu === $menu ? $group->current() : null;
    $item = $menu->checkItem('menuitemradio', null === $current ? $checked : $value === $current, $disabled, $closeOnClick, $value);
    $base = null !== $menu->menubar ? Style::MENUBAR_CHECK_ITEM : Style::MENU_CHECK_ITEM;

    return <button type="button" className={{ classes('group', base) }} {{ ...item }} {{ ...rest }}>{{ children }}</button>;
}

/**
 * The content of the popup that changes with the trigger, as the Viewport of Base UI. It shows the
 * MenuPayload of the `payload` of the active trigger, and animates the change: the content is in
 * a `div` with `data-current`, the old content in a `div` with `data-previous`, and the viewport
 * gets `data-activation-direction`.
 */
#[Component]
function MenuViewport(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('viewport');

    return <div {{ ...target }} {{ ...rest }}>{{ children }}</div>;
}

/** The content that the MenuViewport shows for the triggers with this `payload`. */
#[Component]
function MenuPayload(string $name, ?Html $children = null): Node
{
    return <template data-payload={{ name }}>{{ children }}</template>;
}

/** The input of the filter: its text hides the items of the MenuList that do not match it. */
#[Component]
function MenuInput(#[Context] Menu $menu, mixed ...$rest): Node
{
    $target = $menu->target('input');

    return (
        <input
            type="text"
            role="searchbox"
            autocomplete="off"
            spellcheck="false"
            className={{ classes('min-h-8 w-0 flex-1 bg-transparent px-2.5 text-sm any-pointer-coarse:text-base leading-none outline-hidden placeholder:text-muted-foreground') }}
            {{ ...target }}
            {{ ...rest }}
        />
    );
}

/** A button that empties the MenuInput. */
#[Component]
function MenuClear(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('clear');

    return (
        <button
            type="button"
            aria-label="Clear"
            className={{ classes('flex size-8 items-center justify-center bg-transparent text-foreground outline-hidden focus-visible:-outline-offset-2 focus-visible:outline-2 focus-visible:outline-ring') }}
            {{ ...target }}
            {{ ...rest }}
        >
            {{ children }}
        </button>
    );
}

/** The text that shows when no item matches the query of the MenuInput. */
#[Component]
function MenuEmpty(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('empty');

    return <div hidden className={{ classes('p-3 text-sm text-muted-foreground') }} {{ ...target }} {{ ...rest }}>{{ children }}</div>;
}

/** The items that the MenuInput filters: the `menu` of a popup with a filter. */
#[Component]
function MenuList(#[Context] Menu $menu, ?Html $children = null, mixed ...$rest): Node
{
    $target = $menu->target('list');

    return <div className={{ classes('overflow-y-auto py-1 outline-hidden scroll-py-1') }} {{ ...target }} {{ ...rest }}>{{ children }}</div>;
}
