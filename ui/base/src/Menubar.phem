<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Prop, Provide};
use Phem\{Html, Node};

/**
 * A bar of menus, as the menu bar of an application: Base UI Menubar, on the `phem-menubar`
 * controller. Put a Menu for each menu in it: its MenuTrigger gets the look of the bar.
 *
 * @aliases menu bar, app menu, file menu
 */
#[Component, Provide]
class Menubar
{
    #[Prop] public Orientation $orientation = Orientation::Horizontal;
    #[Prop] public bool $loopFocus = true;
    #[Prop] public bool $modal = true;
    #[Prop] public bool $disabled = false;
    #[Prop] public ?Html $children = null;
    #[Prop(rest: true)] public array $attrs = [];

    public function render(): Node
    {
        return (
            <div
                role="menubar"
                aria-orientation={{ orientation.value }}
                data-orientation={{ orientation.value }}
                data-controller="phem-menubar"
                data-phem-menubar-orientation-value={{ orientation.value }}
                data-phem-menubar-loop-focus-value={{ loopFocus ? null : 'false' }}
                data-phem-menubar-modal-value={{ modal ? null : 'false' }}
                data-phem-menubar-disabled-value={{ disabled ? 'true' : null }}
                className={{ classes('flex items-center data-[orientation=vertical]:flex-col data-[orientation=vertical]:items-stretch') }}
                {{ ...attrs }}
            >
                {{ children }}
            </div>
        );
    }
}
