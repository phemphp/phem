<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context, Prop, Provide};
use Phem\{Html, Node};

/**
 * A graphical display of a value in a range: Base UI Meter.Root. Give an `id` to label it with its
 * MeterLabel.
 *
 * @aliases gauge, level, quota, usage bar
 */
#[Component, Provide]
class Meter
{
    #[Prop] public float $value = 0;
    #[Prop] public float $min = 0;
    #[Prop] public float $max = 100;
    #[Prop] public ?string $id = null;
    #[Prop] public ?Html $children = null;
    #[Prop(rest: true)] public array $attrs = [];

    public function percent(): float
    {
        if ($this->max <= $this->min) {
            return 0;
        }

        return max(0, min(100, ($this->value - $this->min) / ($this->max - $this->min) * 100));
    }

    public function text(): string
    {
        return round($this->percent()).'%';
    }

    public function render(): Node
    {
        $text = $this->text();

        return (
            <div
                id={{ id }}
                role="meter"
                aria-valuemin={{ min }}
                aria-valuemax={{ max }}
                aria-valuenow={{ value }}
                aria-valuetext={{ text }}
                aria-labelledby={{ id ? id ~ '-label' : null }}
                className={{ classes('grid max-w-full w-60 grid-cols-2 gap-y-2') }}
                {{ ...attrs }}
            >
                {{ children }}
            </div>
        );
    }
}

/** The label of the meter. It names the meter (`aria-labelledby`). */
#[Component]
function MeterLabel(#[Context] Meter $meter, ?Html $children = null, mixed ...$rest): Node
{
    $id = $meter->id ? $meter->id.'-label' : null;

    return <span id={{ id }} className={{ classes('text-sm font-normal text-foreground') }} {{ ...rest }}>{{ children }}</span>;
}

/** The value of the meter as a text, for example `24%`. Its children replace the text. */
#[Component]
function MeterValue(#[Context] Meter $meter, ?Html $children = null, mixed ...$rest): Node
{
    $text = $meter->text();

    return <span aria-hidden="true" className={{ classes('text-right text-sm text-foreground') }} {{ ...rest }}>{{ children ?? text }}</span>;
}

/** The bar of the meter: it holds the MeterIndicator. */
#[Component]
function MeterTrack(?Html $children = null, mixed ...$rest): Node
{
    return <div className={{ classes('col-span-2 h-3 overflow-hidden bg-muted') }} {{ ...rest }}>{{ children }}</div>;
}

/** The part of the track that shows the value: its width is the percentage of the value. */
#[Component]
function MeterIndicator(#[Context] Meter $meter, mixed ...$rest): Node
{
    $style = 'inset-inline-start: 0; height: inherit; width: '.$meter->percent().'%';

    return <div style={{ style }} className={{ classes('bg-primary transition-[width] duration-500') }} {{ ...rest }} />;
}
