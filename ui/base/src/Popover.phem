<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\{Component, Context};
use Phem\{Html, Node};

/**
 * A popup next to a button: Base UI Popover.Root, on the `phem-popover` controller.
 *
 * The props of the Base UI Positioner (`side`, `align`, `sideOffset`, `alignOffset`,
 * `collisionPadding`) are props of the root. The popup goes in the top layer
 * (`popover="manual"`), so it needs no Portal.
 *
 * A `handle` links the root to detached triggers: a PopoverTrigger with the same `handle`, anywhere
 * in the page, opens this popover. The root then gets the handle as its `id`. One popover can have
 * several triggers, and the PopoverViewport shows the `payload` of the trigger that opened it.
 * `defaultOpen` and `triggerId` are the state: a render with new values opens the popover next to
 * the trigger with that `id`.
 */
#[Component]
function Popover(
    ?string $handle = null,
    bool $defaultOpen = false,
    ?string $triggerId = null,
    bool $openOnHover = false,
    int $delay = 300,
    int $closeDelay = 0,
    Side $side = Side::Bottom,
    Align $align = Align::Center,
    int $sideOffset = 0,
    int $alignOffset = 0,
    int $collisionPadding = 5,
    ?Html $children = null,
    mixed ...$rest,
): Node {
    return (
        <div
            id={{ handle }}
            data-controller="phem-popover"
            data-phem-popover-open-value={{ defaultOpen ? 'true' : null }}
            data-phem-popover-trigger-id-value={{ triggerId }}
            data-phem-popover-open-on-hover-value={{ openOnHover ? 'true' : null }}
            data-phem-popover-delay-value={{ 300 == delay ? null : delay }}
            data-phem-popover-close-delay-value={{ 0 == closeDelay ? null : closeDelay }}
            data-phem-popover-side-value={{ side.value }}
            data-phem-popover-align-value={{ align.value }}
            data-phem-popover-side-offset-value={{ sideOffset }}
            data-phem-popover-align-offset-value={{ alignOffset }}
            data-phem-popover-collision-padding-value={{ collisionPadding }}
            className={{ classes('contents') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/**
 * The button that opens the popover. With a `handle`, it is a detached trigger of the Popover with
 * the same `handle`: it can be anywhere in the page. The `payload` is the name of a PopoverPayload
 * (or a text) that the PopoverViewport shows while this trigger is active.
 */
#[Component]
function PopoverTrigger(
    ?string $handle = null,
    ?string $payload = null,
    #[Context] ?Toolbar $toolbar = null,
    bool $disabled = false,
    ?Html $children = null,
    mixed ...$rest,
): Node {
    $item = null !== $toolbar ? 'item' : null;
    $target = null === $handle ? 'trigger' : null;
    $base = null !== $toolbar ? Style::TOOLBAR_BUTTON : Style::BUTTON;

    return (
        <button
            type="button"
            disabled={{ disabled }}
            data-disabled={{ disabled ? '' : null }}
            data-phem-popover-target={{ target }}
            data-phem-popover-for={{ handle }}
            data-phem-popover-payload={{ payload }}
            data-phem-toolbar-target={{ item }}
            className={{ classes(base, 'data-pressed:bg-accent') }}
            {{ ...rest }}
        >
            {{ children }}
        </button>
    );
}

#[Component]
function PopoverPopup(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-popover-target="popup"
            popover="manual"
            hidden
            className={{ classes('m-0 inset-auto overflow-visible relative flex h-[var(--popup-height,auto)] w-[var(--popup-width,auto)] max-w-[500px] flex-col gap-1 origin-[var(--transform-origin)] bg-popover p-3 text-popover-foreground outline-none border border-border rounded-popup shadow-popup transition-[scale,opacity] duration-100 ease-out data-ending-style:scale-[0.98] data-ending-style:opacity-0 data-starting-style:scale-[0.98] data-starting-style:opacity-0 [&[hidden]]:hidden') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

#[Component]
function PopoverArrow(mixed ...$rest): Node
{
    $base = Style::ARROW;

    return <div data-phem-popover-target="arrow" aria-hidden="true" className={{ classes(base) }} {{ ...rest }} />;
}

#[Component]
function PopoverTitle(?Html $children = null, mixed ...$rest): Node
{
    return <h2 data-phem-popover-target="title" className={{ classes('text-sm font-bold') }} {{ ...rest }}>{{ children }}</h2>;
}

#[Component]
function PopoverDescription(?Html $children = null, mixed ...$rest): Node
{
    $base = Style::DESCRIPTION;

    return <p data-phem-popover-target="description" className={{ classes(base) }} {{ ...rest }}>{{ children }}</p>;
}

#[Component]
function PopoverClose(?Html $children = null, mixed ...$rest): Node
{
    $base = Style::BUTTON;

    return <button type="button" data-phem-popover-target="close" className={{ classes(base) }} {{ ...rest }}>{{ children }}</button>;
}

/**
 * The content of a popover with several triggers: the PopoverPayload of the active trigger, or its
 * other children. When the active trigger changes, the old content gets `data-previous` and the
 * new content `data-current`, and the viewport gets `data-activation-direction`, for an animation.
 */
#[Component]
function PopoverViewport(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div data-phem-popover-target="viewport" {{ ...rest }}>
            {{ children }}
        </div>
    );
}

/** The content that the PopoverViewport shows for the triggers with this `payload`. */
#[Component]
function PopoverPayload(string $name, ?Html $children = null): Node
{
    return <template data-payload={{ name }}>{{ children }}</template>;
}
