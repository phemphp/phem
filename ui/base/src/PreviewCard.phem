<?phem

namespace Phem\Ui\Base;

use Phem\Attribute\Component;
use Phem\{Html, Node};

/**
 * A popup with a preview of the page of a link, on hover: Base UI PreviewCard.Root, on the
 * `phem-popover` controller with `openOnHover`. The link is the only accessible part: keep the
 * content of the popup a supplement.
 *
 * A `handle` links the root to detached links: a PreviewCardTrigger with the same `handle`,
 * anywhere in the page, shows this card. One card can have several links, and the
 * PreviewCardViewport shows the PreviewCardPayload of the link under the pointer or with the
 * focus. `triggerId` is the `id` of the link of the open card.
 *
 * @aliases hover card, link preview
 */
#[Component]
function PreviewCard(
    ?string $handle = null,
    bool $defaultOpen = false,
    ?string $triggerId = null,
    int $delay = 600,
    int $closeDelay = 300,
    Side $side = Side::Bottom,
    Align $align = Align::Center,
    int $sideOffset = 8,
    ?Html $children = null,
    mixed ...$rest,
): Node {
    return (
        <Popover handle={{ handle }} defaultOpen={{ defaultOpen }} triggerId={{ triggerId }} openOnHover delay={{ delay }} closeDelay={{ closeDelay }} side={{ side }} align={{ align }} sideOffset={{ sideOffset }} className="block" {{ ...rest }}>
            {{ children }}
        </Popover>
    );
}

/**
 * The link that shows the card. No whitespace goes around its text: the underline would include it.
 *
 * With a `handle`, it is a detached link of the PreviewCard with the same `handle`. The `payload`
 * is the name of the PreviewCardPayload that the card shows for this link.
 */
#[Component]
function PreviewCardTrigger(string $href, ?string $handle = null, ?string $payload = null, ?Html $children = null, mixed ...$rest): Node
{
    $target = null === $handle ? 'trigger' : null;

    return (
        <a
            href={{ href }}
            data-phem-popover-target={{ target }}
            data-phem-popover-for={{ handle }}
            data-phem-popover-payload={{ payload }}
            className={{ classes('text-foreground underline decoration-foreground/60 decoration-1 underline-offset-2 outline-0 hover:decoration-foreground data-popup-open:decoration-foreground focus-visible:no-underline focus-visible:outline-2 focus-visible:outline-ring') }}
            {{ ...rest }}
        >{{ children }}</a>
    );
}

/**
 * The box of the preview card, with the preview of the link. The controller places it next to
 * the link.
 */
#[Component]
function PreviewCardPopup(?Html $children = null, mixed ...$rest): Node
{
    return (
        <div
            data-phem-popover-target="popup"
            popover="manual"
            hidden
            className={{ classes('m-0 inset-auto overflow-visible relative h-[var(--popup-height,auto)] w-[var(--popup-width,auto)] origin-[var(--transform-origin)] border border-border bg-popover text-popover-foreground rounded-popup shadow-popup transition-[transform,opacity] duration-100 ease-out data-ending-style:[transform:scale(0.98)] data-ending-style:opacity-0 data-starting-style:[transform:scale(0.98)] data-starting-style:opacity-0 [&[hidden]]:hidden') }}
            {{ ...rest }}
        >
            {{ children }}
        </div>
    );
}

/** The arrow of the popup, at the side of the link. */
#[Component]
function PreviewCardArrow(mixed ...$rest): Node
{
    return <PopoverArrow {{ ...rest }} />;
}

/** The content of a card with several links: the PreviewCardPayload of the active link. */
#[Component]
function PreviewCardViewport(?Html $children = null, mixed ...$rest): Node
{
    return <PopoverViewport {{ ...rest }}>{{ children }}</PopoverViewport>;
}

/** The content that the card shows for the links with this `payload`. */
#[Component]
function PreviewCardPayload(string $name, ?Html $children = null): Node
{
    return <PopoverPayload name={{ name }}>{{ children }}</PopoverPayload>;
}
