<?phem

namespace Phem\Ui\Base\Tests\App;

use Phem\Attribute\{Component, State};
use Phem\Node;

use function Phem\Ui\Base\{Dialog, DialogPopup, DialogTrigger, MenuItem, MenuPopup, MenuTrigger, NumberField, NumberFieldInput, Popover, PopoverPopup, PopoverTrigger, Tooltip, TooltipPopup, TooltipTrigger, Avatar, AvatarFallback, AvatarImage, CheckboxIndicator, RadioIndicator, SwitchThumb, Toggle, ToolbarButton, ToolbarGroup, ToolbarSeparator};
use Phem\Ui\Base\{Checkbox, CheckboxGroup, Menu, Radio, RadioGroup, SwitchRoot, ToggleGroup, Toolbar};

#[Component]
function ToggleDemo(): Node
{
    return <Toggle aria-label="Favorite" defaultPressed>♥</Toggle>;
}

#[Component]
function SwitchDemo(): Node
{
    return <label><SwitchRoot defaultChecked name="alerts"><SwitchThumb /></SwitchRoot> Notifications</label>;
}

#[Component]
final class BoundSwitchDemo
{
    #[State] public bool $alerts = true;

    public function render(): Node
    {
        return <label><SwitchRoot phem:bind={{ alerts }}><SwitchThumb /></SwitchRoot> Notifications</label>;
    }
}

#[Component]
function CheckboxDemo(): Node
{
    return <label><Checkbox name="terms"><CheckboxIndicator /></Checkbox> Accept</label>;
}

#[Component]
function ToolbarTriggersDemo(): Node
{
    return (
        <Toolbar aria-label="Triggers">
            <Menu><MenuTrigger>Menu</MenuTrigger><MenuPopup><MenuItem>Item</MenuItem></MenuPopup></Menu>
            <Popover><PopoverTrigger>Popover</PopoverTrigger><PopoverPopup>Text</PopoverPopup></Popover>
            <Dialog><DialogTrigger>Dialog</DialogTrigger><DialogPopup>Text</DialogPopup></Dialog>
            <Tooltip><TooltipTrigger aria-label="Tip">T</TooltipTrigger><TooltipPopup>Tip</TooltipPopup></Tooltip>
            <NumberField defaultValue={{ 1 }}><NumberFieldInput aria-label="Count" /></NumberField>
        </Toolbar>
    );
}

#[Component]
function NativeButtonSwitchDemo(): Node
{
    return <SwitchRoot id="wifi" name="wifi" uncheckedValue="off" form="settings" nativeButton><SwitchThumb /></SwitchRoot>;
}

#[Component]
function NativeButtonRadioDemo(): Node
{
    return <RadioGroup name="disk" defaultValue="ssd" aria-label="Disk"><Radio id="disk-ssd" value="ssd" nativeButton><RadioIndicator /></Radio></RadioGroup>;
}

#[Component]
function NativeButtonCheckboxDemo(): Node
{
    return <Checkbox id="news" name="news" defaultChecked nativeButton><CheckboxIndicator /></Checkbox>;
}

#[Component]
function CheckboxGroupDemo(): Node
{
    return (
        <CheckboxGroup defaultValue={{ ['fuji'] }} allValues={{ ['fuji', 'gala'] }}>
            <label><Checkbox parent><CheckboxIndicator /></Checkbox> All</label>
            <label><Checkbox value="fuji"><CheckboxIndicator /></Checkbox> Fuji</label>
            <label><Checkbox value="gala"><CheckboxIndicator /></Checkbox> Gala</label>
        </CheckboxGroup>
    );
}

#[Component]
function ToggleGroupDemo(): Node
{
    return (
        <ToggleGroup defaultValue={{ ['left'] }} aria-label="Alignment">
            <Toggle value="left">L</Toggle>
            <Toggle value="right">R</Toggle>
        </ToggleGroup>
    );
}

#[Component]
function ToolbarDemo(): Node
{
    return (
        <Toolbar aria-label="Format">
            <ToggleGroup aria-label="Alignment"><Toggle value="left">Left</Toggle></ToggleGroup>
            <ToolbarSeparator />
            <ToolbarGroup aria-label="Numbers"><ToolbarButton disabled>$</ToolbarButton></ToolbarGroup>
        </Toolbar>
    );
}

#[Component]
function RadioGroupDemo(): Node
{
    return (
        <RadioGroup defaultValue="fuji" name="apple">
            <label><Radio value="fuji"><RadioIndicator /></Radio> Fuji</label>
            <label><Radio value="gala"><RadioIndicator /></Radio> Gala</label>
        </RadioGroup>
    );
}

#[Component]
function AvatarDemo(): Node
{
    return <Avatar><AvatarImage src="/a.png" alt="Ada" /><AvatarFallback delay={{ 600 }}>AL</AvatarFallback></Avatar>;
}
