<?phem

namespace Phem\Ui\Base\Tests\App;

use Phem\Attribute\Component;
use Phem\Node;

use function Phem\Ui\Base\{FieldsetLegend, MeterIndicator, MeterLabel, MeterTrack, MeterValue, ProgressIndicator, ProgressLabel, ProgressTrack, ProgressValue};
use Phem\Ui\Base\{Fieldset, Input, Meter, Progress, Separator};

#[Component]
function ProgressDemo(?float $value = 20): Node
{
    return (
        <Progress id="export" value={{ value }}>
            <ProgressLabel>Export data</ProgressLabel>
            <ProgressValue />
            <ProgressTrack><ProgressIndicator /></ProgressTrack>
        </Progress>
    );
}

#[Component]
function MeterDemo(): Node
{
    return (
        <Meter id="storage" value={{ 24 }}>
            <MeterLabel>Storage Used</MeterLabel>
            <MeterValue />
            <MeterTrack><MeterIndicator /></MeterTrack>
        </Meter>
    );
}

#[Component]
function FieldsetDemo(): Node
{
    return (
        <Fieldset>
            <FieldsetLegend>Billing details</FieldsetLegend>
            <Input name="company" placeholder="Enter company name" />
            <Separator orientation="vertical" />
        </Fieldset>
    );
}
