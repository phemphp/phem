<?phem

namespace Phem\Ui\Base\Tests\App;

use Phem\Attribute\{Component, State};
use Phem\Node;

use function Phem\Ui\Base\{ComboboxActions, ComboboxChip, ComboboxChipRemove, ComboboxChips, ComboboxClear, ComboboxEmpty, ComboboxInput, ComboboxInputGroup, ComboboxItem, ComboboxItemIndicator, ComboboxItemLabel, ComboboxLabel, ComboboxList, ComboboxPopup, ComboboxRow, ComboboxStatus, ComboboxTrigger, DrawerBackdrop, DrawerClose, DrawerContent, DrawerDescription, DrawerIndent, DrawerIndentBackground, DrawerPayload, DrawerPopup, DrawerProvider, DrawerSwipeArea, DrawerTitle, DrawerTrigger, PreviewCard, PreviewCardPopup, PreviewCardTrigger, ToastAction, ToastArrow, ToastContent, ToastData, ToastDescription, ToastRoot, ToastTitle};
use Phem\Ui\Base\{Autocomplete, Combobox, ComboboxChipTemplate, Drawer, DrawerViewport, ToastViewport};

// A Combobox with a list of the browser has one selected item, and an Autocomplete has none.
#[Component]
function ComboboxSelectionDemo(): Node
{
    return (
        <div>
            <Combobox id="pick" filter="contains" name="fruit" defaultValue="apple" defaultInputValue="Apple">
                <ComboboxInput />
                <ComboboxPopup><ComboboxList><ComboboxItem value="apple">Apple</ComboboxItem><ComboboxItem value="pear">Pear</ComboboxItem></ComboboxList></ComboboxPopup>
            </Combobox>
            <Combobox id="free" filter="contains" selectionMode="none" openOnInputClick={{ false }}>
                <ComboboxInput />
                <ComboboxPopup><ComboboxList><ComboboxItem value="a">A</ComboboxItem></ComboboxList></ComboboxPopup>
            </Combobox>
            <Autocomplete id="tags" filter="contains" name="tag">
                <ComboboxInput />
                <ComboboxPopup><ComboboxList><ComboboxItem value="fix">fix</ComboboxItem></ComboboxList></ComboboxPopup>
            </Autocomplete>
        </div>
    );
}

// A list of the server with the `single` selection mode: the root binds the selected value.
#[Component]
final class ComboboxServerSelectionDemo
{
    #[State] public string $query = 'Pear';
    #[State] public string $selected = 'pear';

    public function render(): Node
    {
        return (
            <Combobox id="server" phem:bind={{ selected }}>
                <ComboboxInput phem:bind={{ query }} />
                <ComboboxPopup>
                    <ComboboxStatus idle="Start typing." pending="Searching…" empty={{ 'No matches for "' ~ query ~ '".' }} error="Failed." />
                    <ComboboxList><ComboboxItem value="apple" label="Apple">Apple</ComboboxItem><ComboboxItem value="pear" label="Pear">Pear</ComboboxItem></ComboboxList>
                </ComboboxPopup>
            </Combobox>
        );
    }
}

// A list of the server with `multiple`: the handlers choose, and a click on the input opens the
// popup.
#[Component]
function ComboboxServerMultipleDemo(): Node
{
    return (
        <Combobox id="team" multiple>
            <ComboboxChips>
                <ComboboxChipTemplate>
                    <ComboboxChip aria-label="{label}">{label}<ComboboxChipRemove aria-label="Remove {label}" /></ComboboxChip>
                </ComboboxChipTemplate>
                <ComboboxInput />
            </ComboboxChips>
            <ComboboxPopup><ComboboxList><ComboboxItem value="a" selected>A</ComboboxItem></ComboboxList></ComboboxPopup>
        </Combobox>
    );
}

// With `multiple` and a list of the browser, the browser keeps the chosen items: the chips
// of the other items are hidden.
#[Component]
function ComboboxMultipleDemo(): Node
{
    return (
        <Combobox id="langs" multiple filter="contains" defaultValue={{ ['go', 'php'] }}>
            <ComboboxChips aria-label="Selected languages">
                <ComboboxChip value="go" aria-label="Go">Go<ComboboxChipRemove aria-label="Remove Go" /></ComboboxChip>
                <ComboboxChip value="js" aria-label="JavaScript">JavaScript<ComboboxChipRemove aria-label="Remove JavaScript" /></ComboboxChip>
                <ComboboxChip value="php" aria-label="PHP">PHP<ComboboxChipRemove aria-label="Remove PHP" /></ComboboxChip>
                <ComboboxInput placeholder="e.g. Go" selectedDescription="{count} selected" />
            </ComboboxChips>
            <ComboboxPopup>
                <ComboboxList>
                    <ComboboxItem value="go">Go</ComboboxItem>
                    <ComboboxItem value="js">JavaScript</ComboboxItem>
                    <ComboboxItem value="php">PHP</ComboboxItem>
                </ComboboxList>
            </ComboboxPopup>
        </Combobox>
    );
}

// A list of the server in a form: the `selectionMode` gives the selection to the browser, and the
// `name` the values to the form. The owner has one value, and each chip of a reviewer has a hidden
// input. A chip with no value out of the template has no input.
#[Component]
function ComboboxFormDemo(): Node
{
    return (
        <form>
            <Combobox id="tag" name="tag">
                <ComboboxInput />
                <ComboboxPopup><ComboboxList></ComboboxList></ComboboxPopup>
            </Combobox>
            <Combobox id="owner" name="owner" selectionMode="single">
                <ComboboxInput />
                <ComboboxPopup><ComboboxList><ComboboxItem value="ada" label="Ada">Ada</ComboboxItem></ComboboxList></ComboboxPopup>
            </Combobox>
            <Combobox id="reviewers" name="reviewers" multiple selectionMode="multiple" defaultValue={{ ['ada'] }}>
                <ComboboxChips>
                    <ComboboxChip value="ada" aria-label="Ada">Ada<ComboboxChipRemove aria-label="Remove Ada" /></ComboboxChip>
                    <ComboboxChip value="bob" aria-label="Bob">Bob<ComboboxChipRemove aria-label="Remove Bob" /></ComboboxChip>
                    <ComboboxChip aria-label="Cy">Cy</ComboboxChip>
                    <ComboboxChipTemplate>
                        <ComboboxChip aria-label="{label}">{label}<ComboboxChipRemove aria-label="Remove {label}" /></ComboboxChip>
                    </ComboboxChipTemplate>
                    <ComboboxInput />
                </ComboboxChips>
                <ComboboxPopup><ComboboxList></ComboboxList></ComboboxPopup>
            </Combobox>
        </form>
    );
}

// The highlight props, an inline list and a grid.
#[Component]
function ComboboxHighlightDemo(): Node
{
    return (
        <div>
            <Autocomplete id="palette" filter="contains" autoHighlight="always" keepHighlight highlightItemOnHover={{ false }}>
                <ComboboxInput />
                <ComboboxList><ComboboxItem value="linear">Linear</ComboboxItem></ComboboxList>
            </Autocomplete>
            <Autocomplete id="typed" autoHighlight grid>
                <ComboboxInput />
                <ComboboxPopup><ComboboxList><ComboboxRow><ComboboxItem value="a">a</ComboboxItem></ComboboxRow></ComboboxList></ComboboxPopup>
            </Autocomplete>
        </div>
    );
}

#[Component]
function ComboboxDemo(): Node
{
    return (
        <Combobox id="fruit">
            <ComboboxLabel>Choose a fruit</ComboboxLabel>
            <ComboboxInputGroup>
                <ComboboxInput placeholder="e.g. Apple" />
                <ComboboxActions>
                    <ComboboxClear aria-label="Clear selection" />
                    <ComboboxTrigger aria-label="Open popup" />
                </ComboboxActions>
            </ComboboxInputGroup>
            <ComboboxPopup>
                <ComboboxEmpty>No fruits found.</ComboboxEmpty>
                <ComboboxList>
                    <ComboboxItem value="apple" selected>
                        <ComboboxItemIndicator />
                        <ComboboxItemLabel>Apple</ComboboxItemLabel>
                    </ComboboxItem>
                    <ComboboxItem value="banana"><ComboboxItemIndicator /><ComboboxItemLabel>Banana</ComboboxItemLabel></ComboboxItem>
                </ComboboxList>
            </ComboboxPopup>
        </Combobox>
    );
}

#[Component]
function DrawerDemo(): Node
{
    return (
        <Drawer swipeDirection="right">
            <DrawerTrigger>Open drawer</DrawerTrigger>
            <DrawerPopup>
                <DrawerContent>
                    <DrawerTitle>Drawer</DrawerTitle>
                    <DrawerDescription>Swipe to dismiss it.</DrawerDescription>
                    <DrawerClose>Close</DrawerClose>
                </DrawerContent>
            </DrawerPopup>
        </Drawer>
    );
}

#[Component]
function DrawerPartsDemo(): Node
{
    return (
        <DrawerProvider>
            <DrawerIndentBackground />
            <DrawerIndent>
                <DrawerTrigger handle="settings-drawer" payload="Settings">Settings</DrawerTrigger>
                <Drawer handle="settings-drawer" swipeDirection="left" modal={{ false }} disablePointerDismissal virtualKeyboard confirmClose="discard" finalFocus="#done">
                    <DrawerSwipeArea />
                    <DrawerBackdrop />
                    <DrawerViewport>
                        <DrawerPopup>
                            <DrawerTitle><DrawerPayload /></DrawerTitle>
                        </DrawerPopup>
                    </DrawerViewport>
                </Drawer>
            </DrawerIndent>
        </DrawerProvider>
    );
}

#[Component]
function PreviewCardDemo(): Node
{
    return (
        <PreviewCard>
            <p>The principles of good <PreviewCardTrigger href="https://en.wikipedia.org/wiki/Typography">typography</PreviewCardTrigger>.</p>
            <PreviewCardPopup><p>Typography is an art.</p></PreviewCardPopup>
        </PreviewCard>
    );
}

#[Component]
function ToastDemo(): Node
{
    return <ToastViewport />;
}

#[Component]
function ToastOptionsDemo(): Node
{
    return (
        <div>
            <ToastViewport name="top" position="top-center" />
            <ToastViewport name="anchored" anchored sideOffset={{ 10 }} />
            <ToastViewport name="custom">
                <ToastRoot>
                    <ToastContent>
                        <ToastTitle />
                        <ToastDescription />
                        <ToastData name="userId" />
                    </ToastContent>
                </ToastRoot>
            </ToastViewport>
        </div>
    );
}
