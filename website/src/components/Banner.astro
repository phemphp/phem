---
// Design system: Banner, at the top of each page.
import { repository } from '../site';
import Icon from './Icon.astro';
---
<div class="ph-banner site-banner" role="note">
    <Icon name="exclamation-triangle" />
    <p class="site-banner__text">This documentation is under construction.<span class="site-banner__more"> Pages can be missing or change at any time.</span> <a href={repository}>Follow it on GitHub</a>.</p>
</div>
<script is:inline>
    // The sticky nav, the anchors and the stage of the home page are below the banner: keep
    // --banner-height equal to its height. The script is inline, so the height is correct before
    // the first paint and the page does not jump.
    {
        const banner = document.currentScript.previousElementSibling;
        const update = () => document.documentElement.style.setProperty('--banner-height', `${banner.offsetHeight}px`);
        update();

        new ResizeObserver(update).observe(banner);
    }
</script>
