---
// Design system: Footer.
import { navigation } from '../navigation';
import { repository } from '../site';
---
<footer class="ph-footer">
    <div class="ph-footer__inner">
        <div class="ph-footer__grid">
            <div>
                <p class="ph-footer__brand">Phem</p>
                <p class="ph-footer__about">UI server components for Symfony web apps. Logic and markup in one .phem file.</p>
            </div>
            {navigation.slice(0, 3).map((group) => (
                <div>
                    <p class="ph-footer__title">{group.title}</p>
                    <ul>{group.pages.map((page) => <li><a href={`/${page.slug}/`}>{page.label}</a></li>)}</ul>
                </div>
            ))}
        </div>
        <div class="ph-footer__bottom">
            <span><a href={repository}>GitHub</a> · <a href="/llms.txt">llms.txt</a></span>
        </div>
    </div>
</footer>
