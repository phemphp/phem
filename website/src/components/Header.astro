---
// Design system: Header, with the search trigger and the ThemeToggle.
import { repository, url } from '../site';
import Icon from './Icon.astro';

interface Props {
    current?: string;
}

const { current } = Astro.props;
const section = 'tutorial' === current ? 'tutorial' : current ? 'docs' : undefined;
---
<a class="lw-skip" href="#main">Skip to content</a>
<header class="lw-header">
    <div class="lw-header__inner">
        <button class="lw-icon-btn lw-header__menu" type="button" aria-label="Open navigation" data-lw-drawer-open="docs-drawer"><Icon name="bars-3" /></button>
        <a class="lw-header__brand" href={url('/')}>Phem</a>
        <nav class="lw-header__nav" aria-label="Main">
            <a class="lw-header__link" href={url('/what-is-phem/')} aria-current={'docs' === section ? 'page' : undefined}>Docs</a>
            <a class="lw-header__link" href={url('/tutorial/')} aria-current={'tutorial' === section ? 'page' : undefined}>Tutorial</a>
        </nav>
        <div class="lw-header__end">
            <button class="lw-search-trigger" type="button" data-lw-search-open>
                <Icon name="magnifying-glass" /><span class="lw-search-trigger__label">Search docs</span><span class="lw-search-trigger__keys"><kbd class="lw-kbd">⌘</kbd><kbd class="lw-kbd">K</kbd></span>
            </button>
            <div class="lw-theme" role="group" aria-label="Color theme">
                <button type="button" data-lw-theme="light" aria-pressed="false" aria-label="Light"><Icon name="sun" /></button>
                <button type="button" data-lw-theme="system" aria-pressed="true" aria-label="Match system"><Icon name="computer-desktop" /></button>
                <button type="button" data-lw-theme="dark" aria-pressed="false" aria-label="Dark"><Icon name="moon" /></button>
            </div>
            <a class="lw-header__link header-github" href={repository}>GitHub <Icon name="arrow-top-right-on-square" class="lw-icon" /></a>
        </div>
    </div>
</header>
