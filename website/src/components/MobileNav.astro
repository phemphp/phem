---
// Design system: MobileNav. The sidebar in a drawer below 768px.
import Icon from './Icon.astro';
import SidebarNav from './SidebarNav.astro';

interface Props {
    current?: string;
}
---
<dialog class="ph-drawer" id="docs-drawer" aria-label="Documentation navigation">
    <div class="ph-drawer__head">
        <span class="ph-header__brand">Phem</span>
        <button class="ph-icon-btn" type="button" data-ph-close aria-label="Close navigation"><Icon name="x-mark" /></button>
    </div>
    <SidebarNav current={Astro.props.current} />
</dialog>
