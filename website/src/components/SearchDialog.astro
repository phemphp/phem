---
// Design system: SearchDialog. The items come from search.json (all the pages and their h2 and
// h3 headings); bundle.js opens the dialog and filters the items as the user types.
import { svg } from '../icons';
import Icon from './Icon.astro';
---
<dialog class="ph-search" data-ph-search aria-label="Search documentation" data-index="/search.json" data-icon-page={svg('document-text')} data-icon-section={svg('hashtag')} data-icon-enter={svg('arrow-turn-down-left', 'ph-search__item-enter')}>
    <div class="ph-search__field">
        <Icon name="magnifying-glass" />
        <input class="ph-search__input" data-ph-search-input type="search" placeholder="Search docs" aria-label="Search docs" role="combobox" aria-expanded="true" aria-controls="search-results" autocomplete="off" />
        <kbd class="ph-kbd">Esc</kbd>
    </div>
    <div class="ph-search__results" id="search-results" role="listbox" aria-label="Results">
        <p class="ph-search__empty" data-ph-search-empty hidden>No results for “<span data-ph-search-query></span>”</p>
    </div>
    <div class="ph-search__foot">
        <span><kbd class="ph-kbd">↑</kbd><kbd class="ph-kbd">↓</kbd> to navigate</span>
        <span><kbd class="ph-kbd">↵</kbd> to open</span>
        <span><kbd class="ph-kbd">Esc</kbd> to close</span>
    </div>
</dialog>

<script>
    interface SearchItem {
        title: string;
        path: string;
        href: string;
    }

    interface SearchIndex {
        pages: SearchItem[];
        sections: SearchItem[];
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-ph-search]');

    function group(title: string, items: SearchItem[], icon: string, enter: string): HTMLElement {
        const element = document.createElement('div');
        const heading = document.createElement('p');

        element.className = 'ph-search__group';
        element.setAttribute('data-ph-search-group', '');
        element.setAttribute('role', 'group');
        heading.className = 'ph-search__group-title';
        heading.textContent = title;
        element.append(heading);

        for (const item of items) {
            const link = document.createElement('a');
            const text = document.createElement('span');
            const name = document.createElement('span');
            const path = document.createElement('span');

            link.className = 'ph-search__item';
            link.href = item.href;
            link.setAttribute('role', 'option');
            link.setAttribute('aria-selected', 'false');
            link.setAttribute('data-ph-search-item', item.path);
            text.className = 'ph-search__item-text';
            name.className = 'ph-search__item-title';
            name.textContent = item.title;
            path.className = 'ph-search__item-path';
            path.textContent = item.path;
            text.append(name, path);
            link.insertAdjacentHTML('afterbegin', icon);
            link.append(text);
            link.insertAdjacentHTML('beforeend', enter);
            element.append(link);
        }

        return element;
    }

    async function load(dialog: HTMLDialogElement): Promise<void> {
        const index: SearchIndex = await (await fetch(dialog.dataset.index!)).json();
        const results = dialog.querySelector('.ph-search__results')!;
        const enter = dialog.dataset.iconEnter!;

        results.prepend(
            group('Pages', index.pages, dialog.dataset.iconPage!, enter),
            group('Sections', index.sections, dialog.dataset.iconSection!, enter),
        );

        // Filter the new items with the text that the user typed while the index loaded.
        dialog.querySelector('[data-ph-search-input]')?.dispatchEvent(new Event('input', { bubbles: true }));
    }

    if (dialog) {
        load(dialog);
    }
</script>
