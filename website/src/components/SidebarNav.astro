---
// Design system: SidebarNav. The drawer (MobileNav) uses the same markup.
import { navigation } from '../navigation';

interface Props {
    current?: string;
}

const { current } = Astro.props;
---
<nav class="ph-nav" aria-label="Documentation">
    {navigation.map((group) => (
        <div class="ph-nav__group">
            <p class="ph-nav__title">{group.title}</p>
            {group.pages.map((page) => (
                <a class="ph-nav__link" href={`/${page.slug}/`} aria-current={page.slug === current ? 'page' : undefined}>{page.label}</a>
            ))}
        </div>
    ))}
</nav>
