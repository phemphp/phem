---
// The stage of the story: one canvas that CSS scales to the sticky stage. Its size, the place of
// each element (src/styles/home.css) and its lines (src/scripts/stage-layout.ts) come from the
// layout of the screen: 920 × 760 design units on a wide screen, 390 × 440 on a phone. The
// positions are design units, so the SVG lines and the HTML text align. Each element has a
// `data-s` name, and src/scripts/story.ts moves, draws and fades it scene by scene.
// A `data-outline` element gets its borders drawn as paths, so its lines draw in like the others.
// The stage repeats the static figures for the eyes only: it is hidden from screen readers and
// has no focusable element, but its text stays selectable. A `data-copy-of` element gets a copy of
// the code or the drawing of a figure when the stage starts (src/scripts/story.ts).
import { post } from '../../home/post';
import BrowserOutline from './BrowserOutline.astro';
import LikeOutline from './LikeOutline.astro';
---
<div class="stage" aria-hidden="true" data-stage>
    <div class="stage__tilt" data-stage-tilt>
        <div class="stage__canvas" data-stage-canvas>
            <svg class="stage__svg" fill="none">
                <!-- Scene 1: the dot that grows into the Like button of the page, and the connectors
                     of its source. story.ts measures them. -->
                <circle data-s="intro-dot" class="node-dot node-dot--ink" r="4" />
                <path data-s="note-page-ln" class="ln" />
                <path data-s="note-title-ln" class="ln" />
                <path data-s="note-content-ln" class="ln" />
                <path data-s="note-like-ln" class="ln" />
                <!-- Scene 2: the handler and onClick. Scene 3: the round trip. story.ts measures the code. -->
                <path data-s="bracket" class="ln ln--accent" />
                <path data-s="trip-out" class="ln ln--accent" />
                <path data-s="trip-back" class="ln ln--accent" />
                <!-- Scene 4: the boundaries to the composition. -->
                <path data-s="lead-document" class="ln" />
                <path data-s="lead-article" class="ln" />
                <path data-s="lead-like" class="ln" />
                <!-- Scene 5: the component to the framework. The layout draws these lines and the
                     lines of scenes 6 and 7. -->
                <path data-s="link-services" class="ln" />
                <path data-s="link-security" class="ln" />
                <path data-s="link-rate-limit" class="ln" />
                <circle data-s="dot-services" class="node-dot" r="4" />
                <circle data-s="dot-security" class="node-dot" r="4" />
                <circle data-s="dot-rate-limit" class="node-dot" r="4" />
                <!-- Scene 6: the click goes down to like() and the HTML comes back, then #[Broadcast]
                     goes up to Mercure and to the other devices. -->
                <path data-s="click-out" class="ln ln--accent" />
                <path data-s="click-back" class="ln ln--accent" />
                <path data-s="hub" class="ln ln--accent" />
                <path data-s="push-b" class="ln ln--accent" />
                <path data-s="push-c" class="ln ln--accent" />
                <circle data-s="mercure-dot" class="node-dot node-dot--accent" r="5" />
                <!-- Scene 7: the build. -->
                <path data-s="build-in" class="ln" />
                <path data-s="build-php" class="ln" />
                <path data-s="build-twig" class="ln" />
                <!-- Scene 8: the outline of the button of the story in the page that the elephant
                     holds. story.ts measures it. -->
                <path data-s="sketch-like" class="ln" />
                <!-- The dots that travel on the lines. -->
                <circle data-s="travel-1" class="travel" r="4" />
                <circle data-s="travel-2" class="travel" r="4" />
                <circle data-s="travel-3" class="travel" r="4" />
            </svg>

            <BrowserOutline data-s="page" data-outline class="stage__item browser--page" like={false} lines={4} />
            <span data-s="note-page" class="stage__item note">#[Page(<b>'/posts/{'{'}id:post{'}'}'</b>)]</span>
            <span data-s="note-title" class="stage__item note">#[<b>Prop</b>]</span>
            <span data-s="note-content" class="stage__item note">{'{{ '}<b>children</b>{' }}'}</span>
            <span data-s="note-like" class="stage__item note">#[<b>Component</b>]</span>
            <div data-s="code" data-outline data-copy-of="likeButton" class="stage__item stage__code"></div>
            <span data-s="event" class="stage__item tag tag--stack"><span>onClick</span><span>Event</span></span>
            <span data-s="html" class="stage__item tag">HTML</span>

            <div data-s="document" data-outline class="stage__item bound"><span class="bound__label">Document</span></div>
            <div data-s="article" data-outline class="stage__item article">
                <span class="bound__label">Article</span>
                <span class="article__title">{post.title}</span>
                <span class="article__line"></span>
                <span class="article__line"></span>
                <span class="article__line article__line--short"></span>
                <span class="article__line"></span>
                <span class="article__line article__line--short"></span>
            </div>
            <span data-s="like-label" class="stage__item bound-label">LikeButton</span>
            <div data-s="compose" data-outline data-copy-of="blogPost" class="stage__item stage__code"></div>

            <span data-s="label-services" class="stage__item node-label">Services</span>
            <span data-s="label-security" class="stage__item node-label">Security</span>
            <span data-s="label-rate-limit" class="stage__item node-label">Rate limits</span>
            <div data-s="excerpt-services" data-outline data-copy-of="services" class="stage__item stage__code"></div>
            <div data-s="excerpt-security" data-outline data-copy-of="security" class="stage__item stage__code"></div>
            <div data-s="excerpt-rate-limit" data-outline data-copy-of="rateLimit" class="stage__item stage__code"></div>

            <BrowserOutline data-s="browser-a" data-outline class="stage__item" like={false} />
            <BrowserOutline data-s="browser-b" data-outline class="stage__item" counts={[1, 2]} device="tablet" stacked open />
            <BrowserOutline data-s="browser-c" data-outline class="stage__item" counts={[1, 2]} device="phone" stacked />
            <span data-s="mercure" class="stage__item node-label is-end">Mercure</span>
            <span data-s="click-event" class="stage__item tag tag--stack"><span>onClick</span><span>Event</span></span>
            <span data-s="click-html" class="stage__item tag">HTML</span>
            <div data-s="broadcast" data-outline data-copy-of="broadcast" class="stage__item stage__code stage__code--small"></div>
            <dl data-s="legend" class="stage__item legend">
                <div><dt><span class="legend__dot legend__dot--shared"></span><code>$post-&gt;likes</code></dt><dd>Shared data: every viewer</dd></div>
                <div><dt><span class="legend__dot legend__dot--transaction"></span><code>#[Transactional]</code></dt><dd>Saved in one transaction: no save() call</dd></div>
            </dl>

            <span data-s="source" data-outline class="stage__item pill is-centered"><span class="node__dot"></span>LikeButton.phem</span>
            <span data-s="phemc" data-outline class="stage__item pill pill--strong is-centered">phemc</span>
            <span data-s="tag-php" class="stage__item tag is-end">PHP</span>
            <span data-s="tag-twig" class="stage__item tag">Twig</span>
            <div data-s="php" data-outline data-copy-of="compiledPhp" class="stage__item stage__code stage__code--small"></div>
            <div data-s="twig" data-outline data-copy-of="compiledTwig" class="stage__item stage__code stage__code--small"></div>

            <div data-s="sketch" class="stage__sketch" data-copy-of="sketch"></div>

            <LikeOutline data-s="btn" class="stage__btn" counts={[0, 1, 2]} stacked />

            <!-- The outlines of the elements above: story.ts draws them as paths (src/scripts/stroke.ts). -->
            <svg class="stage__svg" fill="none" data-stage-outlines></svg>
        </div>
    </div>
</div>
