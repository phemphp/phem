---
// The home page: the story of a Like button (src/components/home/), then the LinkCards (design
// system). Returning visitors skip the story with the links of its first scene.
import Icon from '../components/Icon.astro';
import Story from '../components/home/Story.astro';
import type { IconName } from '../icons';
import Base from '../layouts/Base.astro';

const cards: { href: string; icon: IconName; title: string; description: string }[] = [
    { href: '/introduction/', icon: 'cube', title: 'Understand Phem', description: 'The five ideas behind Phem, with one small example each.' },
    { href: '/tutorial/', icon: 'rocket-launch', title: 'Build a task list', description: 'Build a small app: a page, components, state, a form and a test.' },
    { href: '/syntax/', icon: 'squares-2x2', title: 'The .phem syntax', description: 'Markup, props, slots, lists, directives and attributes.' },
];
---
<Base title="Phem: UI server components for Symfony" description="Phem puts the logic and the markup of a component in one .phem file. The server renders it and runs its events.">
    <main id="main" class="home-main">
        <Story />
        <section class="home-section" aria-labelledby="start">
            <h2 class="home-section__title" id="start" tabindex="-1">Start here</h2>
            <div class="ph-cards">
                {cards.map((card) => (
                    <a class="ph-card" href={card.href}>
                        <span class="ph-card__icon"><Icon name={card.icon} /></span>
                        <span class="ph-card__title">{card.title}<Icon name="arrow-right" /></span>
                        <span class="ph-card__desc">{card.description}</span>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Base>
